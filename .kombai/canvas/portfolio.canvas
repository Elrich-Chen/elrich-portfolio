    "var_f7a47dca8b7c": {
      "type": "variant",
      "label": "Home - Artisan Craft",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Nunito:wght@300;400;600;700&display=swap');\n  @import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css');\n\n  :root {\n    --cream: #FFF7E7;\n    --off-white: #FBF1DA;\n    --espresso: #592720;\n    --cherry: #D21E4B;\n    --ink: #2E1A47;\n    --gold: #E5B85C;\n    --paper-texture: url('https://images.unsplash.com/photo-1604147706283-d7119b5b822c?auto=format&w=1440&q=80&fit=crop');\n  }\n\n  body {\n    background-color: var(--cream);\n    color: var(--ink);\n    font-family: 'Nunito', sans-serif;\n    overflow-x: clip;\n    margin: 0;\n  }\n\n  .font-serif { font-family: 'Cormorant Garamond', serif; }\n  .font-sans { font-family: 'Nunito', sans-serif; }\n\n  /* Background Paper Texture */\n  .paper-overlay {\n    position: fixed;\n    inset: 0;\n    background-image: var(--paper-texture);\n    background-size: cover;\n    opacity: 0.05;\n    pointer-events: none;\n    z-index: 100;\n    mix-blend-mode: multiply;\n  }\n\n  /* Fixed Left Tab */\n  .side-tab {\n    position: fixed;\n    left: 0;\n    top: 0;\n    height: 100vh;\n    width: 72px;\n    background-color: var(--espresso);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: space-between;\n    padding: 48px 0;\n    z-index: 50;\n    box-shadow: 4px 0 15px rgba(0,0,0,0.1);\n  }\n\n  .side-tab-text {\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n    text-transform: uppercase;\n    letter-spacing: 5px;\n    font-size: 10px;\n    font-weight: 700;\n    color: rgba(255, 247, 231, 0.3);\n    transition: color 220ms ease, opacity 220ms ease;\n    cursor: pointer;\n  }\n\n  .side-tab-text:hover {\n    color: var(--cream);\n    opacity: 1;\n  }\n\n  .side-tab-active {\n    color: var(--cream);\n    opacity: 1;\n    position: relative;\n  }\n\n  .side-tab-active::after {\n    content: '';\n    position: absolute;\n    bottom: -15px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 4px;\n    height: 4px;\n    background: var(--cherry);\n    border-radius: 50%;\n  }\n\n  /* Menu Card Styling */\n  .menu-card {\n    background-color: var(--off-white);\n    border: 1px solid var(--espresso);\n    position: relative;\n    box-shadow: 0 10px 40px rgba(89, 39, 32, 0.06);\n  }\n\n  .dotted-leader {\n    flex-grow: 1;\n    border-bottom: 1.5px dotted var(--espresso);\n    margin: 0 12px;\n    margin-bottom: 5px;\n    opacity: 0.15;\n  }\n\n  .menu-row:hover .dotted-leader {\n    opacity: 0.8;\n    border-color: var(--cherry);\n  }\n\n  /* Photo Badge Layout Tweak - Polaroid Style */\n  .photo-badge-wrapper {\n    position: absolute;\n    top: -65px;\n    left: 50%;\n    transform: translateX(-50%);\n    z-index: 20;\n  }\n\n  .photo-frame {\n    width: 120px;\n    height: 140px;\n    background-color: #fff;\n    border: 1px solid rgba(89, 39, 32, 0.1);\n    padding: 8px 8px 24px 8px;\n    position: relative;\n    transform: rotate(-4deg);\n    box-shadow: 0 8px 20px rgba(0,0,0,0.1);\n  }\n\n  .photo-frame img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    filter: sepia(30%) contrast(110%);\n  }\n\n  .photo-stamp {\n    position: absolute;\n    bottom: 5px;\n    left: 50%;\n    transform: translateX(-50%);\n    color: var(--espresso);\n    font-size: 8px;\n    font-weight: 700;\n    letter-spacing: 2px;\n    white-space: nowrap;\n    opacity: 0.5;\n  }\n\n  .wax-seal {\n    position: absolute;\n    top: -15px;\n    right: -15px;\n    width: 40px;\n    height: 40px;\n    background: var(--cherry);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: white;\n    font-family: serif;\n    font-size: 18px;\n    box-shadow: 2px 2px 5px rgba(0,0,0,0.2);\n    transform: rotate(15deg);\n    border: 2px solid rgba(0,0,0,0.1);\n  }\n\n  .menu-card:hover .photo-frame {\n    transform: rotate(0deg) scale(1.05);\n  }\n\n  /* Micro-interactions */\n  .btn-primary {\n    background-color: var(--espresso);\n    color: white;\n    font-family: 'Nunito', sans-serif;\n    font-weight: 600;\n    font-size: 15px;\n    padding: 12px 24px;\n    border-radius: 4px;\n    transition: all 150ms ease;\n  }\n\n  .btn-primary:hover {\n    background-color: var(--cherry);\n    transform: translateY(-1px);\n    box-shadow: 0 4px 12px rgba(210, 30, 75, 0.2);\n  }\n</style>\n\n<div class=\"paper-overlay\"></div>\n\n<!-- Sidebar Tab -->\n<aside class=\"side-tab\">\n  <div class=\"font-serif text-2xl font-bold text-[var(--cream)] opacity-90\">E.</div>\n  \n  <div class=\"flex flex-col items-center gap-12\">\n    <div class=\"side-tab-text side-tab-active\">Artisan Portfolio</div>\n    <div class=\"side-tab-text\">Chronicles</div>\n    <div class=\"side-tab-text\">Archive</div>\n  </div>\n\n  <div class=\"w-0.5 h-16 bg-[var(--cherry)]\"></div>\n</aside>\n\n<!-- Main Page Wrapper -->\n<main class=\"min-h-screen pl-16 flex items-center justify-center py-24 px-8 overflow-hidden\">\n  \n  <!-- Hero Ambient Element -->\n  <div id=\"ambient-bg\" class=\"fixed inset-0 pointer-events-none flex items-center justify-center z-0 overflow-hidden\">\n    <div class=\"text-[20vw] font-serif font-bold text-[var(--espresso)] opacity-[0.03] select-none tracking-tighter\">ELRICH</div>\n  </div>\n\n  <!-- Centered Menu Card -->\n  <div id=\"main-card\" class=\"menu-card w-full max-w-[760px] p-10 md:p-16 mt-20 opacity-100 z-10\">\n    \n    <!-- Photo Badge -->\n    <div class=\"photo-badge-wrapper\">\n      <div class=\"photo-frame\">\n        <img src=\"https://i.pravatar.cc/300?u=elrich\" alt=\"Elrich\" decoding=\"async\" loading=\"lazy\">\n        <div class=\"photo-stamp uppercase\">E. CHEN</div>\n        <div class=\"wax-seal\">E</div>\n      </div>\n    </div>\n\n    <!-- Header -->\n    <header class=\"text-center mb-16 pt-10\">\n      <div class=\"flex items-center justify-center gap-4 mb-5\">\n        <div class=\"h-[1px] w-6 bg-[var(--gold)]\"></div>\n        <span class=\"font-sans text-[12px] font-bold text-[var(--cherry)] tracking-[0.4em] uppercase\">Artisan & Coder</span>\n        <div class=\"h-[1px] w-6 bg-[var(--gold)]\"></div>\n      </div>\n      \n      <h1 class=\"font-serif text-[64px] font-bold text-[var(--ink)] leading-[1.0] -tracking-[2px] mb-4\">Elrich Chen</h1>\n      <p class=\"font-serif italic text-[22px] text-[var(--espresso)] opacity-80 max-w-md mx-auto\">“A digital craftsmans approach to modern software engineering.”</p>\n    </header>\n\n    <!-- Menu Items -->\n    <nav class=\"space-y-2\">\n      \n      <a href=\"#\" class=\"menu-row group flex items-end py-4 cursor-pointer\">\n        <span class=\"font-serif text-[22px] italic text-[var(--gold)] w-10 transition-colors duration-220 group-hover:text-[var(--cherry)]\">I.</span>\n        <div class=\"flex flex-col\">\n          <span class=\"font-serif text-[26px] font-semibold text-[var(--ink)] leading-none tracking-tight uppercase transition-colors duration-220 group-hover:text-[var(--cherry)]\">Selected Works</span>\n          <span class=\"font-sans text-[11px] font-bold text-[var(--espresso)]/40 uppercase tracking-[0.2em] mt-1\">Digital Portfolio</span>\n        </div>\n        <div class=\"dotted-leader\"></div>\n        <span class=\"font-serif text-[18px] text-[var(--espresso)] font-bold italic opacity-30 group-hover:opacity-100 transition-opacity\">Vol. 08</span>\n      </a>\n\n      <a href=\"#\" class=\"menu-row group flex items-end py-3 cursor-pointer\">\n        <span class=\"font-serif text-[24px] text-[var(--espresso)]/40 w-12 transition-colors duration-220 group-hover:text-[var(--cherry)]\">II.</span>\n        <div class=\"flex flex-col\">\n          <span class=\"font-serif text-[24px] font-semibold text-[var(--ink)] leading-none tracking-wide uppercase transition-colors duration-220 group-hover:text-[var(--cherry)]\">The Artisan's Journey</span>\n          <span class=\"font-sans text-[12px] font-bold text-[var(--espresso)]/50 uppercase tracking-[0.1em] mt-1\">Biography</span>\n        </div>\n        <div class=\"dotted-leader\"></div>\n        <span class=\"font-serif text-[20px] text-[var(--espresso)] font-medium\">01</span>\n      </a>\n\n      <a href=\"#\" class=\"menu-row group flex items-end py-3 cursor-pointer\">\n        <span class=\"font-serif text-[24px] text-[var(--espresso)]/40 w-12 transition-colors duration-220 group-hover:text-[var(--cherry)]\">III.</span>\n        <div class=\"flex flex-col\">\n          <span class=\"font-serif text-[24px] font-semibold text-[var(--ink)] leading-none tracking-wide uppercase transition-colors duration-220 group-hover:text-[var(--cherry)]\">Technical Repertory</span>\n          <span class=\"font-sans text-[12px] font-bold text-[var(--espresso)]/50 uppercase tracking-[0.1em] mt-1\">Skills</span>\n        </div>\n        <div class=\"dotted-leader\"></div>\n        <span class=\"font-serif text-[20px] text-[var(--espresso)] font-medium\">18</span>\n      </a>\n\n      <a href=\"#\" class=\"menu-row group flex items-end py-3 cursor-pointer\">\n        <span class=\"font-serif text-[24px] text-[var(--espresso)]/40 w-12 transition-colors duration-220 group-hover:text-[var(--cherry)]\">IV.</span>\n        <div class=\"flex flex-col\">\n          <span class=\"font-serif text-[24px] font-semibold text-[var(--ink)] leading-none tracking-wide uppercase transition-colors duration-220 group-hover:text-[var(--cherry)]\">Curriculum Vitae</span>\n          <span class=\"font-sans text-[12px] font-bold text-[var(--espresso)]/50 uppercase tracking-[0.1em] mt-1\">Experience</span>\n        </div>\n        <div class=\"dotted-leader\"></div>\n        <span class=\"font-serif text-[20px] text-[var(--espresso)] font-medium\">24</span>\n      </a>\n\n      <a href=\"#\" class=\"menu-row group flex items-end py-3 cursor-pointer\">\n        <span class=\"font-serif text-[24px] text-[var(--espresso)]/40 w-12 transition-colors duration-220 group-hover:text-[var(--cherry)]\">V.</span>\n        <div class=\"flex flex-col\">\n          <span class=\"font-serif text-[24px] font-semibold text-[var(--ink)] leading-none tracking-wide uppercase transition-colors duration-220 group-hover:text-[var(--cherry)]\">Correspondence</span>\n          <span class=\"font-sans text-[12px] font-bold text-[var(--espresso)]/50 uppercase tracking-[0.1em] mt-1\">Contact</span>\n        </div>\n        <div class=\"dotted-leader\"></div>\n        <span class=\"font-serif text-[20px] text-[var(--espresso)] font-medium\">++</span>\n      </a>\n\n    </nav>\n\n    <!-- Footer Stats / Details -->\n    <div class=\"mt-20 pt-10 border-t border-[var(--espresso)]/10 flex flex-col md:flex-row justify-between items-center gap-8\">\n      <div class=\"flex gap-12\">\n        <div class=\"text-center md:text-left\">\n          <p class=\"font-sans text-[10px] font-bold text-[var(--espresso)]/40 uppercase tracking-widest mb-1\">Location</p>\n          <p class=\"font-serif text-[18px] text-[var(--espresso)]\">Toronto, Canada</p>\n        </div>\n        <div class=\"text-center md:text-left\">\n          <p class=\"font-sans text-[10px] font-bold text-[var(--espresso)]/40 uppercase tracking-widest mb-1\">Status</p>\n          <p class=\"font-serif text-[18px] text-[var(--cherry)]\">Open for Craft</p>\n        </div>\n      </div>\n      \n      <div class=\"flex items-center gap-6\">\n        <a href=\"#\" class=\"text-[var(--espresso)] hover:text-[var(--cherry)] transition-colors\"><i class=\"fa-brands fa-github text-xl\"></i></a>\n        <a href=\"#\" class=\"text-[var(--espresso)] hover:text-[var(--cherry)] transition-colors\"><i class=\"fa-brands fa-linkedin-in text-xl\"></i></a>\n        <button class=\"btn-primary\">Download Folio</button>\n      </div>\n    </div>\n\n  </div>\n\n</main>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n<script>\n  gsap.registerPlugin(ScrollTrigger);\n\n  window.addEventListener('load', () => {\n    // Initial Entrance\n    gsap.from(\"#main-card\", {\n      opacity: 0,\n      y: 40,\n      duration: 0.8,\n      ease: \"power4.out\",\n      delay: 0.2\n    });\n\n    // Ambient Zoom Animation\n    gsap.to(\"#ambient-bg div\", {\n      scale: 1.1,\n      duration: 6,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\"\n    });\n\n    // Card Reveal Expansion (Token C: 400ms)\n    // We'll simulate a subtle expansion on load\n    gsap.from(\".menu-row\", {\n      x: -20,\n      opacity: 0,\n      stagger: 0.1,\n      duration: 0.4,\n      ease: \"power2.out\",\n      delay: 0.6\n    });\n\n    // Hover Lift Interaction (Token B: 220ms)\n    const menuRows = document.querySelectorAll('.menu-row');\n    menuRows.forEach(row => {\n      row.addEventListener('mouseenter', () => {\n        gsap.to(row, {\n          x: 10,\n          duration: 0.22,\n          ease: \"power1.out\"\n        });\n      });\n      row.addEventListener('mouseleave', () => {\n        gsap.to(row, {\n          x: 0,\n          duration: 0.22,\n          ease: \"power1.in\"\n        });\n      });\n    });\n\n    // Photo Badge Lift\n    const badge = document.querySelector('.photo-frame');\n    badge.addEventListener('mouseenter', () => {\n      gsap.to(badge, {\n        y: -10,\n        rotate: 0,\n        scale: 1.1,\n        duration: 0.22,\n        ease: \"power2.out\"\n      });\n    });\n    badge.addEventListener('mouseleave', () => {\n      gsap.to(badge, {\n        y: 0,\n        rotate: -3,\n        scale: 1,\n        duration: 0.22,\n        ease: \"power2.in\"\n      });\n    });\n  });\n</script>\n",
