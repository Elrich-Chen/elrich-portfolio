pan class=\"font-mono\" data-kid=\"394\">⎵ space</span></div>\n                <div class=\"flex justify-between\" data-kid=\"395\"><span data-kid=\"396\">Memorized</span><span class=\"font-mono\" data-kid=\"397\">→ right</span></div>\n                <div class=\"flex justify-between\" data-kid=\"398\"><span data-kid=\"399\">Practice</span><span class=\"font-mono\" data-kid=\"400\">← left</span></div>\n                <div class=\"flex justify-between\" data-kid=\"401\"><span data-kid=\"402\">Skip</span><span class=\"font-mono\" data-kid=\"403\">↓ down</span></div>\n              </div>\n            </div>\n\n            \n            <div class=\"col-span-6 flex justify-center\" data-kid=\"404\">\n              <div id=\"flipcard\" class=\"flip-card relative cursor-pointer stack-paper\" style=\"width: 380px; height: 500px;\" data-kid=\"405\">\n                <div class=\"flip-inner relative w-full h-full\" data-kid=\"406\">\n                  \n                  <div class=\"flip-face absolute inset-0 bg-cream text-ink rounded-sm border border-ink p-7 flex flex-col\" data-kid=\"407\">\n                    <div class=\"flex items-center justify-between font-mono text-[10px] tracking-widest\" data-kid=\"408\">\n                      <span data-kid=\"409\">CARD 014 / 032</span>\n                      <span class=\"text-campari\" data-kid=\"410\">● RECALL</span>\n                    </div>\n                    <div class=\"flex-1 flex flex-col items-center justify-center text-center\" data-kid=\"411\">\n                      <div class=\"font-mono text-[10px] tracking-[0.3em] opacity-50 mb-3\" data-kid=\"412\">APERITIVO · STIRRED</div>\n                      <h3 class=\"font-display text-[64px] leading-[0.9]\" data-kid=\"413\">Negroni</h3>\n                      <div class=\"font-display italic text-[16px] opacity-65 mt-2\" data-kid=\"414\">Florence, 1919</div>\n\n                      \n                      <svg viewBox=\"0 0 120 130\" class=\"w-28 mt-6\" data-kid=