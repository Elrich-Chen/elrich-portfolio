\"text-[12px] leading-relaxed\" data-kid=\"453\"><b data-kid=\"454\">Stir</b> over ice 30 rev. → julep-strain into rocks glass over <b data-kid=\"455\">one large cube</b>. Express orange peel, drop in.</div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            \n            <div class=\"col-span-3 space-y-4\" data-kid=\"456\">\n              <div class=\"font-mono text-[10px] tracking-widest text-cream/45\" data-kid=\"457\">SWIPE</div>\n\n              <button class=\"w-full border border-campari rounded-sm p-4 text-left hover:bg-campari/15 flex items-center justify-between group\" data-kid=\"458\">\n                <div data-kid=\"459\">\n                  <div class=\"font-mono text-[10px] tracking-widest text-campari\" data-kid=\"460\">← LEFT</div>\n                  <div class=\"font-display text-[22px] mt-1\" data-kid=\"461\">Needs practice</div>\n                  <div class=\"text-[11px] text-cream/55 mt-1\" data-kid=\"462\">Reshuffles to deck head</div>\n                </div>\n                <i class=\"ti ti-arrow-left text-[22px] text-campari\" data-kid=\"463\"></i>\n              </button>\n\n              <button class=\"w-full border border-rose rounded-sm p-4 text-left hover:bg-rose/15 flex items-center justify-between group\" data-kid=\"464\">\n                <div data-kid=\"465\">\n                  <div class=\"font-mono text-[10px] tracking-widest text-rose\" data-kid=\"466\">RIGHT →</div>\n                  <div class=\"font-display text-[22px] mt-1\" data-kid=\"467\">Memorized</div>\n                  <div class=\"text-[11px] text-cream/55 mt-1\" data-kid=\"468\">Locks for 24 h SRS</div>\n                </div>\n                <i class=\"ti ti-arrow-right text-[22px] text-rose\" data-kid=\"469\"></i>\n              </button>\n\n              <div class=\"border border-cream/15 rounded-sm p-4\" data-kid=\"470\">\n                <div class=\"font-mono text-[10px] tracking-widest text-cream/45 mb-2\" data-kid=\"471\">UP NEXT</div>\n                <ul class=\"text-[12px] space-y-1.5 text-cream/80\" data-kid=\"472\">\n                  <li class=\"flex justify-between\" data-kid=\"473\"><span data-kid=\"474\">15 · Boulevardier</span><span class=\"font-mono text-cream/45\" data-kid=\"475\">stir</span></li>\n                  <li class=\"flex justify-between\" data-kid=\"476\"><span data-kid=\"477\">16 · Old Pal</span><span class=\"font-mono text-cream/45\" data-kid=\"478\">stir</span></li>\n                  <li class=\"flex justify-between\" data-kid=\"479\"><span data-kid=\"480\">17 · Americano</span><span class=\"font-mono text-cream/45\" data-kid=\"481\">build</span></li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      \n      <footer class=\"px-10 py-6 border-t border-ink flex items-center justify-between font-mono text-[10px] tracking-widest uppercase text-ink/55\" data-kid=\"482\">\n        <span data-kid=\"483\">Vermuth Atlas · © 2025</span>\n        <span data-kid=\"484\">Drink responsibly · 21+ · Florence ↔ Brooklyn</span>\n        <span data-kid=\"485\">v3.2.1 · build 8842</span>\n      </footer>\n\n    </main>\n  </div>\n</div>\n\n<script data-kid=\"486\">\n  document.getElementById('flipcard').addEventListener('click', e => {\n    e.currentTarget.classList.toggle('flipped');\n  });\n\n  // Scroll reveal for technique ladder\n  const ladder = document.getElementById('technique-ladder');\n  const spine = ladder.querySelector('.spine-line');\n  const steps = ladder.querySelectorAll('.step-reveal');\n\n  const observer = new IntersectionObserver((entries) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        entry.target.classList.add('revealed');\n      }\n    });\n  }, { threshold: 0.15 });\n\n  // Observe spine\n  const spineObserver = new IntersectionObserver((entries) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        spine.classList.add('revealed');\n      }\n    });\n  }, { threshold: 0.05 });\n\n  spineObserver.observe(ladder);\n\n  // Observe each step with staggered delay\n  steps.forEach((step, i) => {\n    step.style.transitionDelay = `${i * 0.15}s`;\n    observer.observe(step);\n  });\n</script>\n  ",
