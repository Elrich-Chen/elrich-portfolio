    "node_paste_ec6998e3bec7": {
      "type": "variant",
      "id": "node_paste_ec6998e3bec7",
      "label": "Barcraft",
      "html": "\n    <style data-kid=\"0\">\n@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n.font-display { font-family: 'Fraunces', serif; font-optical-sizing: auto; letter-spacing: -0.02em; }\n.font-body { font-family: 'Inter', sans-serif; }\n.font-mono { font-family: 'JetBrains Mono', monospace; font-feature-settings: \"tnum\"; }\n\n.bg-cream { background-color: #F2EBD6; }\n.bg-ink { background-color: #1C1710; }\n.bg-amber { background-color: #A5742E; }\n.bg-campari { background-color: #B82E26; }\n.bg-rose { background-color: #D8968E; }\n.text-cream { color: #F2EBD6; }\n.text-ink { color: #1C1710; }\n.text-amber { color: #A5742E; }\n.text-campari { color: #B82E26; }\n.text-rose { color: #D8968E; }\n.border-ink { border-color: #1C1710; }\n.border-ink-soft { border-color: rgba(28,23,16,0.15); }\n\n.crosshatch {\n  background-image:\n    repeating-linear-gradient(45deg, rgba(28,23,16,0.18), rgba(28,23,16,0.18) 1px, transparent 1px, transparent 5px),\n    repeating-linear-gradient(-45deg, rgba(28,23,16,0.12), rgba(28,23,16,0.12) 1px, transparent 1px, transparent 5px);\n}\n.stripes-light {\n  background-image: repeating-linear-gradient(90deg, rgba(255,255,255,0.18) 0 1px, transparent 1px 7px);\n}\n\n.dotleader { background-image: radial-gradient(circle, #1C1710 1px, transparent 1.2px); background-size: 6px 6px; background-position: bottom; background-repeat: repeat-x; }\n\n.tab-active { position: relative; }\n.tab-active::before {\n  content: \"\"; position: absolute; left: 0; top: 6px; bottom: 6px; width: 2px; background: #B82E26;\n}\n\n.flip-card { perspective: 1200px; }\n.flip-inner { transform-style: preserve-3d; transition: transform 0.9s cubic-bezier(.2,1.3,.4,1); }\n.flip-card.flipped .flip-inner { transform: rotateY(180deg); }\n.flip-face { backface-visibility: hidden; -webkit-backface-visibility: hidden; }\n.flip-back { transform: rotateY(180deg); }\n\n.stack-paper::before, .stack-paper::after {\n  content: \"\"; position: absolute; background: #EDE4C6; border: 1px solid #1C1710; border-radius: 4px; z-index: -1;\n}\n.stack-paper::before { inset: 6px -6px -6px 6px; transform: rotate(2deg); }\n.stack-paper::after { inset: 12px -2px -10px 2px; transform: rotate(-2deg); background: #E5DBB8; }\n\n.ribbon-anim { stroke-dasharray: 2000; stroke-dashoffset: 2000; animation: drawRibbon 2.4s ease-out forwards; }\n@keyframes drawRibbon { to { stroke-dashoffset: 0; } }\n\n.fill-anim { animation: fillUp 2s ease-out 1.4s both; transform-origin: bottom; }\n@keyframes fillUp { from { transform: scaleY(0); } to { transform: scaleY(1); } }\n\n.chip { border: 1px solid #1C1710; padding: 4px 10px; border-radius: 999px; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; }\n.chip-on { background: #1C1710; color: #F2EBD6; }\n\n.btn-ink { background: #1C1710; color: #F2EBD6; }\n.btn-ink:hover { background: #B82E26; }\n\n.swatch { width: 10px; height: 10px; border-radius: 999px; display: inline-block; border: 1px solid rgba(28,23,16,0.4); }\n\n.glow-spot {\n  background: radial-gradient(ellipse at center, rgba(242,235,214,0.16) 0%, rgba(242,235,214,0.04) 35%, transparent 65%);\n}\n\n.no-scrollbar::-webkit-scrollbar { display: none; }\n\n/* Scroll reveal for technique section */\n.spine-line {\n  transform-origin: top;\n  transform: scaleY(0);\n  transition: transform 1.5s cubic-bezier(0.22, 1, 0.36, 1);\n}\n.spine-line.revealed { transform: scaleY(1); }\n\n.step-reveal {\n  opacity: 0;\n  transform: translateY(30px);\n  transition: opacity 0.7s ease, transform 0.7s ease;\n}\n.step-reveal.revealed {\n  opacity: 1;\n  transform: translateY(0);\n}\n</style>\n\n<div class=\"font-body text-ink bg-cream min-h-screen\" data-kid=\"1\">\n\n  \n  <div class=\"flex min-h-screen\" data-kid=\"2\">\n\n    \n    <aside class=\"w-[220px] shrink-0 bg-ink text-cream flex flex-col\" data-kid=\"3\">\n      <div class=\"px-6 pt-7 pb-8 border-b border-cream/15\" data-kid=\"4\">\n        <div class=\"font-display text-[26px] leading-none\" data-kid=\"5\">Vermuth<span class=\"text-campari\" data-kid=\"6\">.</span></div>\n        <div class=\"font-mono text-[10px] tracking-[0.2em] uppercase mt-2 text-cream/55\" data-kid=\"7\">Bartender Atlas · v3.2</div>\n      </div>\n\n      <nav class=\"flex flex-col py-5 text-[13px]\" data-kid=\"8\">\n        <div class=\"font-mono text-[10px] tracking-[0.2em] uppercase text-cream/40 px-6 mb-2\" data-kid=\"9\">Study</div>\n        <a class=\"tab-active px-6 py-2.5 text-cream flex items-center justify-between\" data-kid=\"10\"><span class=\"flex items-center gap-3\" data-kid=\"11\"><i class=\"ti ti-glass-cocktail text-[16px]\" data-kid=\"12\"></i>Recipes</span><span class=\"font-mono text-[11px] text-cream/50\" data-kid=\"13\">124</span></a>\n        <a class=\"px-6 py-2.5 text-cream/70 hover:text-cream flex items-center justify-between\" data-kid=\"14\"><span class=\"flex items-center gap-3\" data-kid=\"15\"><i class=\"ti ti-stretching text-[16px]\" data-kid=\"16\"></i>Techniques</span><span class=\"font-mono text-[11px] text-cream/40\" data-kid=\"17\">18</span></a>\n        <a class=\"px-6 py-2.5 text-cream/70 hover:text-cream flex items-center justify-between\" data-kid=\"18\"><span class=\"flex items-center gap-3\" data-kid=\"19\"><i class=\"ti ti-books text-[16px]\" data-kid=\"20\"></i>Library</span><span class=\"font-mono text-[11px] text-cream/40\" data-kid=\"21\">312</span></a>\n        <a class=\"px-6 py-2.5 text-cream/70 hover:text-cream flex items-center justify-between\" data-kid=\"22\"><span class=\"flex items-center gap-3\" data-kid=\"23\"><i class=\"ti ti-cards text-[16px]\" data-kid=\"24\"></i>Flashcards</span><span class=\"font-mono text-[11px] text-campari\" data-kid=\"25\">●</span></a>\n\n        <div class=\"font-mono text-[10px] tracking-[0.2em] uppercase text-cream/40 px-6 mb-2 mt-6\" data-kid=\"26\">Family</div>\n        <a class=\"px-6 py-2 text-cream/65 hover:text-cream flex items-center gap-3\" data-kid=\"27\"><span class=\"swatch bg-amber\" data-kid=\"28\"></span>Stirred & Boozy</a>\n        <a class=\"px-6 py-2 text-cream/65 hover:text-cream flex items-center gap-3\" data-kid=\"29\"><span class=\"swatch bg-campari\" data-kid=\"30\"></span>Bitter Aperitivi</a>\n        <a class=\"px-6 py-2 text-cream/65 hover:text-cream flex items-center gap-3\" data-kid=\"31\"><span class=\"swatch bg-rose\" data-kid=\"32\"></span>Sours & Citrus</a>\n        <a class=\"px-6 py-2 text-cream/65 hover:text-cream flex items-center gap-3\" data-kid=\"33\"><span class=\"swatch bg-[#F2EBD6] !border-cream/40\" data-kid=\"34\"></span>Sparkling Highballs</a>\n      </nav>\n\n      <div class=\"mt-auto px-6 py-5 border-t border-cream/15 text-[11px] text-cream/55\" data-kid=\"35\">\n        <div class=\"flex items-center gap-2 mb-2\" data-kid=\"36\">\n          <div class=\"w-7 h-7 rounded-full bg-cream text-ink font-display flex items-center justify-center text-[13px]\" data-kid=\"37\">M</div>\n          <div data-kid=\"38\">\n            <div class=\"text-cream text-[12px]\" data-kid=\"39\">Mira Castellanos</div>\n            <div class=\"font-mono text-[10px]\" data-kid=\"40\">Lvl 4 · 1,284 XP</div>\n          </div>\n        </div>\n        <div class=\"font-mono text-[10px] tracking-widest uppercase\" data-kid=\"41\">Streak · 14d ▰▰▰▰▰▰▱</div>\n      </div>\n    </aside>\n\n    \n    <main class=\"flex-1 min-w-0\" data-kid=\"42\">\n\n      \n      <div class=\"flex items-center justify-between px-10 py-5 border-b border-ink-soft\" data-kid=\"43\">\n        <div class=\"flex items-center gap-3 font-mono text-[11px] tracking-[0.18em] uppercase text-ink/60\" data-kid=\"44\">\n          <span data-kid=\"45\">Recipes</span><span data-kid=\"46\">/</span><span data-kid=\"47\">Stirred & Boozy</span><span data-kid=\"48\">/</span><span class=\"text-ink\" data-kid=\"49\">Negroni</span>\n        </div>\n        <div class=\"flex items-center gap-3\" data-kid=\"50\">\n          <div class=\"relative\" data-kid=\"51\">\n            <i class=\"ti ti-search text-[14px] absolute left-3 top-1/2 -translate-y-1/2 text-ink/50\" data-kid=\"52\"></i>\n            <input placeholder=\"Search 312 ingredients…\" class=\"bg-transparent border border-ink-soft rounded-full pl-9 pr-4 py-1.5 text-[12px] w-72 focus:outline-none focus:border-ink\" data-kid=\"53\">\n          </div>\n          <button class=\"btn-ink rounded-full px-4 py-1.5 text-[12px] flex items-center gap-2\" data-kid=\"54\"><i class=\"ti ti-player-play-filled text-[11px]\" data-kid=\"55\"></i>Drill</button>\n        </div>\n      </div>\n\n      \n      <section class=\"px-10 py-10 grid grid-cols-12 gap-10\" data-kid=\"56\">\n\n        \n        <div class=\"col-span-3\" data-kid=\"57\">\n          <div class=\"font-mono text-[10px] tracking-[0.25em] uppercase text-campari mb-3\" data-kid=\"58\">№ 014 · Aperitivo</div>\n          <h1 class=\"font-display text-[88px] leading-[0.86] font-medium\" data-kid=\"59\">Neg<span class=\"italic text-amber\" data-kid=\"60\">ro</span>ni</h1>\n          <div class=\"font-display italic text-[15px] text-ink/70 mt-4\" data-kid=\"61\">Equal parts, no apology.</div>\n\n          <p class=\"text-[13px] leading-[1.65] text-ink/75 mt-5\" data-kid=\"62\">\n            Born in Florence, 1919. Count Camillo Negroni asked Caffè Casoni to stiffen his Americano by trading soda for gin. The bartender obliged — and the bitter, ruby aperitivo of the modern century was poured.\n          </p>\n\n          <div class=\"mt-8 border-t border-ink pt-4\" data-kid=\"63\">\n            <div class=\"flex items-baseline justify-between mb-3\" data-kid=\"64\">\n              <div class=\"font-mono text-[10px] tracking-[0.25em] uppercase\" data-kid=\"65\">Specs</div>\n              <div class=\"font-mono text-[10px] text-ink/55\" data-kid=\"66\">Total · 3.00 oz</div>\n            </div>\n\n            <ul class=\"space-y-3 text-[13px]\" data-kid=\"67\">\n              <li class=\"flex items-center gap-3\" data-kid=\"68\">\n                <span class=\"swatch bg-amber\" data-kid=\"69\"></span>\n                <span class=\"flex-1\" data-kid=\"70\">London Dry Gin</span>\n                <span class=\"font-mono text-[12px]\" data-kid=\"71\">1.00 oz</span>\n              </li>\n              <li class=\"flex items-center gap-3\" data-kid=\"72\">\n                <span class=\"swatch bg-campari\" data-kid=\"73\"></span>\n                <span class=\"flex-1\" data-kid=\"74\">Campari</span>\n                <span class=\"font-mono text-[12px]\" data-kid=\"75\">1.00 oz</span>\n              </li>\n              <li class=\"flex items-center gap-3\" data-kid=\"76\">\n                <span class=\"swatch bg-rose\" data-kid=\"77\"></span>\n                <span class=\"flex-1\" data-kid=\"78\">Sweet Vermouth</span>\n                <span class=\"font-mono text-[12px]\" data-kid=\"79\">1.00 oz</span>\n              </li>\n              <li class=\"flex items-center gap-3 pt-2 border-t border-ink-soft\" data-kid=\"80\">\n                <span class=\"swatch bg-[#1C1710]\" data-kid=\"81\"></span>\n                <span class=\"flex-1\" data-kid=\"82\">Orange peel, expressed</span>\n                <span class=\"font-mono text-[12px]\" data-kid=\"83\">1 pc</span>\n              </li>\n            </ul>\n          </div>\n\n          <div class=\"mt-6 grid grid-cols-3 gap-2 font-mono text-[10px]\" data-kid=\"84\">\n            <div class=\"border border-ink-soft rounded p-2\" data-kid=\"85\"><div class=\"text-ink/50 tracking-widest\" data-kid=\"86\">ABV</div><div class=\"text-[14px] mt-1\" data-kid=\"87\">24%</div></div>\n            <div class=\"border border-ink-soft rounded p-2\" data-kid=\"88\"><div class=\"text-ink/50 tracking-widest\" data-kid=\"89\">DILUT</div><div class=\"text-[14px] mt-1\" data-kid=\"90\">22%</div></div>\n            <div class=\"border border-ink-soft rounded p-2\" data-kid=\"91\"><div class=\"text-ink/50 tracking-widest\" data-kid=\"92\">GLASS</div><div class=\"text-[14px] mt-1\" data-kid=\"93\">Rocks</div></div>\n          </div>\n\n          <div class=\"mt-6 flex gap-2\" data-kid=\"94\">\n            <button class=\"chip chip-on\" data-kid=\"95\">Negroni</button>\n            <button class=\"chip\" data-kid=\"96\">Sbagliato</button>\n            <button class=\"chip\" data-kid=\"97\">Bianco</button>\n          </div>\n        </div>\n\n        \n        <div class=\"col-span-9\" data-kid=\"98\">\n          <div class=\"border border-ink rounded-sm bg-[#F8F2DD] relative overflow-hidden\" data-kid=\"99\">\n            \n            <div class=\"flex items-center justify-between px-6 py-3 border-b border-ink-soft bg-cream\" data-kid=\"100\">\n              <div class=\"font-mono text-[10px] tracking-[0.25em] uppercase\" data-kid=\"101\">Flow Diagram · Volume → Glass</div>\n              <div class=\"flex gap-4 font-mono text-[10px] text-ink/65\" data-kid=\"102\">\n                <span data-kid=\"103\">1 unit = 0.25 oz</span>\n                <span data-kid=\"104\">scale 1:1</span>\n                <span class=\"text-campari\" data-kid=\"105\">● live</span>\n              </div>\n            </div>\n\n            \n            <div class=\"relative\" data-kid=\"106\">\n              \n              <div class=\"absolute inset-0 opacity-[0.06]\" style=\"background-image: linear-gradient(#1C1710 1px, transparent 1px), linear-gradient(90deg, #1C1710 1px, transparent 1px); background-size: 40px 40px;\" data-kid=\"107\"></div>\n\n              <svg viewBox=\"0 0 900 460\" class=\"w-full block relative\" data-kid=\"108\">\n                <defs data-kid=\"109\">\n                  <pattern id=\"hatchA\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\" data-kid=\"110\">\n                    <rect width=\"6\" height=\"6\" fill=\"#A5742E\" data-kid=\"111\"></rect>\n                    <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#8a5f24\" stroke-width=\"1.2\" data-kid=\"112\"></line>\n                  </pattern>\n                  <pattern id=\"hatchC\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(-45)\" data-kid=\"113\">\n                    <rect width=\"6\" height=\"6\" fill=\"#B82E26\" data-kid=\"114\"></rect>\n                    <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#8a1f19\" stroke-width=\"1.2\" data-kid=\"115\"></line>\n                  </pattern>\n                  <pattern id=\"hatchV\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\" data-kid=\"116\">\n                    <rect width=\"6\" height=\"6\" fill=\"#D8968E\" data-kid=\"117\"></rect>\n                    <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#b86b62\" stroke-width=\"1\" data-kid=\"118\"></line>\n                  </pattern>\n\n                  \n                  <clipPath id=\"glassClip\" data-kid=\"119\">\n                    <path d=\"M 680 120 L 850 120 L 838 360 Q 838 380 818 380 L 712 380 Q 692 380 692 360 Z\" data-kid=\"120\"></path>\n                  </clipPath>\n                </defs>\n\n                \n                <text x=\"30\" y=\"40\" class=\"font-mono\" font-family=\"JetBrains Mono\" font-size=\"9\" fill=\"#1C1710\" opacity=\"0.5\" letter-spacing=\"2\" data-kid=\"121\">INGREDIENTS</text>\n                <text x=\"430\" y=\"40\" class=\"font-mono\" font-family=\"JetBrains Mono\" font-size=\"9\" fill=\"#1C1710\" opacity=\"0.5\" letter-spacing=\"2\" text-anchor=\"middle\" data-kid=\"122\">FLOW (oz)</text>\n                <text x=\"765\" y=\"40\" class=\"font-mono\" font-family=\"JetBrains Mono\" font-size=\"9\" fill=\"#1C1710\" opacity=\"0.5\" letter-spacing=\"2\" text-anchor=\"middle\" data-kid=\"123\">VESSEL</text>\n\n                \n                \n                <clipPath id=\"ribbonClip\" data-kid=\"124\">\n                  <rect x=\"0\" y=\"0\" width=\"692\" height=\"460\" data-kid=\"125\"></rect>\n                </clipPath>\n                <g clip-path=\"url(#ribbonClip)\" data-kid=\"126\">\n                  \n                  <path d=\"M 44 130 C 300 130, 450 180, 700 220\" stroke=\"url(#hatchA)\" stroke-width=\"60\" fill=\"none\" opacity=\"0.85\" class=\"ribbon-anim\" style=\"animation-delay:0.1s\" data-kid=\"127\"></path>\n                  \n                  <path d=\"M 44 230 C 300 230, 450 265, 700 280\" stroke=\"url(#hatchC)\" stroke-width=\"60\" fill=\"none\" opacity=\"0.88\" class=\"ribbon-anim\" style=\"animation-delay:0.4s\" data-kid=\"128\"></path>\n                  \n                  <path d=\"M 44 330 C 300 330, 450 330, 700 340\" stroke=\"url(#hatchV)\" stroke-width=\"60\" fill=\"none\" opacity=\"0.88\" class=\"ribbon-anim\" style=\"animation-delay:0.7s\" data-kid=\"129\"></path>\n                </g>\n\n                \n                \n                <g data-kid=\"130\">\n                  <rect x=\"30\" y=\"100\" width=\"14\" height=\"60\" fill=\"#A5742E\" data-kid=\"131\"></rect>\n                  <text x=\"52\" y=\"120\" font-family=\"Fraunces\" font-size=\"16\" fill=\"#1C1710\" data-kid=\"132\">Gin</text>\n                  <text x=\"52\" y=\"138\" font-family=\"JetBrains Mono\" font-size=\"10\" fill=\"#1C1710\" opacity=\"0.65\" data-kid=\"133\">Tanqueray · 47.3%</text>\n                  <text x=\"52\" y=\"154\" font-family=\"JetBrains Mono\" font-size=\"11\" fill=\"#A5742E\" data-kid=\"134\">1.00 oz</text>\n                </g>\n                \n                <g data-kid=\"135\">\n                  <rect x=\"30\" y=\"200\" width=\"14\" height=\"60\" fill=\"#B82E26\" data-kid=\"136\"></rect>\n                  <text x=\"52\" y=\"220\" font-family=\"Fraunces\" font-size=\"16\" fill=\"#1C1710\" data-kid=\"137\">Campari</text>\n                  <text x=\"52\" y=\"238\" font-family=\"JetBrains Mono\" font-size=\"10\" fill=\"#1C1710\" opacity=\"0.65\" data-kid=\"138\">Italian bitter · 24%</text>\n                  <text x=\"52\" y=\"254\" font-family=\"JetBrains Mono\" font-size=\"11\" fill=\"#B82E26\" data-kid=\"139\">1.00 oz</text>\n                </g>\n                \n                <g data-kid=\"140\">\n                  <rect x=\"30\" y=\"300\" width=\"14\" height=\"60\" fill=\"#D8968E\" data-kid=\"141\"></rect>\n                  <text x=\"52\" y=\"320\" font-family=\"Fraunces\" font-size=\"16\" fill=\"#1C1710\" data-kid=\"142\">Sweet Vermouth</text>\n                  <text x=\"52\" y=\"338\" font-family=\"JetBrains Mono\" font-size=\"10\" fill=\"#1C1710\" opacity=\"0.65\" data-kid=\"143\">Carpano Antica · 16.5%</text>\n                  <text x=\"52\" y=\"354\" font-family=\"JetBrains Mono\" font-size=\"11\" fill=\"#D8968E\" data-kid=\"144\">1.00 oz</text>\n                </g>\n\n                \n                <g data-kid=\"145\">\n                  \n                  <g clip-path=\"url(#glassClip)\" data-kid=\"146\">\n                    <rect x=\"680\" y=\"180\" width=\"180\" height=\"200\" fill=\"url(#hatchV)\" opacity=\"0.7\" class=\"fill-anim\" style=\"animation-delay:1.4s\" data-kid=\"147\"></rect>\n                    <rect x=\"680\" y=\"180\" width=\"180\" height=\"200\" fill=\"url(#hatchC)\" opacity=\"0.6\" class=\"fill-anim\" style=\"animation-delay:1.6s\" data-kid=\"148\"></rect>\n                    <rect x=\"680\" y=\"180\" width=\"180\" height=\"200\" fill=\"url(#hatchA)\" opacity=\"0.5\" class=\"fill-anim\" style=\"animation-delay:1.8s\" data-kid=\"149\"></rect>\n                    \n                    <rect x=\"730\" y=\"160\" width=\"50\" height=\"50\" fill=\"#F2EBD6\" stroke=\"#1C1710\" stroke-width=\"1.2\" opacity=\"0.9\" transform=\"rotate(8 755 185)\" data-kid=\"150\"></rect>\n                    <rect x=\"770\" y=\"195\" width=\"36\" height=\"36\" fill=\"#F2EBD6\" stroke=\"#1C1710\" stroke-width=\"1.2\" opacity=\"0.8\" transform=\"rotate(-12 788 213)\" data-kid=\"151\"></rect>\n                  </g>\n\n                  \n                  <path d=\"M 680 120 L 850 120 L 838 360 Q 838 380 818 380 L 712 380 Q 692 380 692 360 Z\" fill=\"none\" stroke=\"#1C1710\" stroke-width=\"2\" data-kid=\"152\"></path>\n                  \n                  <ellipse cx=\"765\" cy=\"120\" rx=\"85\" ry=\"6\" fill=\"none\" stroke=\"#1C1710\" stroke-width=\"2\" data-kid=\"153\"></ellipse>\n                  \n                  <path d=\"M 745 105 Q 765 95 790 100 Q 800 108 785 115 Q 770 118 750 112 Z\" fill=\"#A5742E\" stroke=\"#1C1710\" stroke-width=\"1\" data-kid=\"154\"></path>\n                  <text x=\"810\" y=\"108\" font-family=\"JetBrains Mono\" font-size=\"9\" fill=\"#1C1710\" opacity=\"0.6\" data-kid=\"155\">peel</text>\n                </g>\n\n                \n                <g font-family=\"JetBrains Mono\" font-size=\"9\" fill=\"#1C1710\" opacity=\"0.65\" data-kid=\"156\">\n                  <text x=\"860\" y=\"270\" data-kid=\"157\">— mixed</text>\n                </g>\n\n                \n                <line x1=\"450\" y1=\"80\" x2=\"450\" y2=\"430\" stroke=\"#1C1710\" stroke-width=\"0.5\" stroke-dasharray=\"2 4\" opacity=\"0.3\" data-kid=\"158\"></line>\n                <text x=\"455\" y=\"78\" font-family=\"JetBrains Mono\" font-size=\"8\" fill=\"#1C1710\" opacity=\"0.5\" data-kid=\"159\">↓ STIRRING ZONE</text>\n\n              </svg>\n            </div>\n\n            \n            <div class=\"flex items-center border-t border-ink-soft px-6 py-2.5 font-mono text-[10px] tracking-wider uppercase text-ink/60 justify-between\" data-kid=\"160\">\n              <div class=\"flex gap-5\" data-kid=\"161\">\n                <span class=\"flex items-center gap-1.5\" data-kid=\"162\"><span class=\"swatch bg-amber\" data-kid=\"163\"></span>base · 33%</span>\n                <span class=\"flex items-center gap-1.5\" data-kid=\"164\"><span class=\"swatch bg-campari\" data-kid=\"165\"></span>bitter · 33%</span>\n                <span class=\"flex items-center gap-1.5\" data-kid=\"166\"><span class=\"swatch bg-rose\" data-kid=\"167\"></span>sweet · 33%</span>\n              </div>\n              <div data-kid=\"168\">Diagram by V. Atlas / verified 03·2025</div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      \n      <section class=\"px-10 pb-14\" data-kid=\"169\">\n        <div class=\"flex items-end justify-between border-b border-ink pb-4 mb-10\" data-kid=\"170\">\n          <div data-kid=\"171\">\n            <div class=\"font-mono text-[10px] tracking-[0.25em] uppercase text-campari\" data-kid=\"172\">02 · Technique</div>\n            <h2 class=\"font-display text-[48px] leading-none mt-1\" data-kid=\"173\">The Stir, in <span class=\"italic\" data-kid=\"174\">six</span> motions.</h2>\n          </div>\n          <div class=\"font-mono text-[11px] text-ink/60\" data-kid=\"175\">est. 45 sec · 30–40 revolutions</div>\n        </div>\n\n        <div class=\"relative max-w-5xl mx-auto\" id=\"technique-ladder\" data-kid=\"176\">\n          \n          <div class=\"absolute left-1/2 top-0 bottom-0 w-px bg-ink spine-line\" data-kid=\"177\"></div>\n\n          \n          <div class=\"grid grid-cols-2 gap-10 mb-12 items-center relative step-reveal\" data-kid=\"178\">\n            <div class=\"text-right pr-12\" data-kid=\"179\">\n              <div class=\"font-mono text-[10px] tracking-widest text-ink/50\" data-kid=\"180\">STEP 01 · 00:00</div>\n              <h3 class=\"font-display text-[26px] mt-1\" data-kid=\"181\">Chill the mixing glass</h3>\n              <p class=\"text-[13px] text-ink/75 mt-2 leading-relaxed\" data-kid=\"182\"><b data-kid=\"183\">Fill</b> the mixing glass with cracked ice, add a splash of cold water, and <b data-kid=\"184\">swirl</b> for ten seconds. Discard. A frosted vessel buys you precious dilution control.</p>\n            </div>\n            <div data-kid=\"185\"></div>\n            <div class=\"absolute left-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-cream border border-ink flex items-center justify-center text-[16px]\" data-kid=\"186\"><i class=\"ti ti-snowflake\" data-kid=\"187\"></i></div>\n          </div>\n\n          \n          <div class=\"grid grid-cols-2 gap-10 mb-12 items-center relative step-reveal\" data-kid=\"188\">\n            <div data-kid=\"189\"></div>\n            <div class=\"pl-12\" data-kid=\"190\">\n              <div class=\"font-mono text-[10px] tracking-widest text-ink/50\" data-kid=\"191\">STEP 02 · 00:10</div>\n              <h3 class=\"font-display text-[26px] mt-1\" data-kid=\"192\">Build & stir, gently</h3>\n              <div class=\"mt-3 grid grid-cols-[140px_1fr] gap-4 items-start\" data-kid=\"193\">\n                <div class=\"border border-ink rounded-lg overflow-hidden bg-ink\" data-kid=\"194\">\n                  <video src=\"https://videos.pexels.com/video-files/30211442/12952734_360_640_30fps.mp4\" poster=\"https://images.pexels.com/videos/30211442/pexels-photo-30211442.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=400&w=300\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-44 object-cover\" data-kid=\"195\"></video>\n                </div>\n                <p class=\"text-[13px] text-ink/75 leading-relaxed\" data-kid=\"196\"><b data-kid=\"197\">Pour</b> measured spirits over fresh, large-format ice. Insert a <b data-kid=\"198\">bar spoon</b> against the wall and rotate the cube tower — <b data-kid=\"199\">30 to 40 revolutions</b>, fluid, never agitated. The drink should hum, not roar.</p>\n              </div>\n            </div>\n            <div class=\"absolute left-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-ink text-cream flex items-center justify-center text-[16px]\" data-kid=\"200\"><i class=\"ti ti-rotate-clockwise-2\" data-kid=\"201\"></i></div>\n          </div>\n\n          \n          <div class=\"grid grid-cols-2 gap-10 mb-12 items-center relative step-reveal\" data-kid=\"202\">\n            <div class=\"text-right pr-12\" data-kid=\"203\">\n              <div class=\"font-mono text-[10px] tracking-widest text-ink/50\" data-kid=\"204\">STEP 03 · 00:38</div>\n              <h3 class=\"font-display text-[26px] mt-1\" data-kid=\"205\">Check temperature</h3>\n              <p class=\"text-[13px] text-ink/75 mt-2 leading-relaxed\" data-kid=\"206\"><b data-kid=\"207\">Taste</b> with a straw. Target: <span class=\"font-mono\" data-kid=\"208\">−5°C / 23°F</span>, ABV near <span class=\"font-mono\" data-kid=\"209\">24%</span>. Under-diluted bites; over-diluted whispers.</p>\n            </div>\n            <div data-kid=\"210\"></div>\n            <div class=\"absolute left-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-cream border border-ink flex items-center justify-center text-[16px]\" data-kid=\"211\"><i class=\"ti ti-temperature\" data-kid=\"212\"></i></div>\n          </div>\n\n          \n          <div class=\"grid grid-cols-2 gap-10 mb-12 items-center relative step-reveal\" data-kid=\"213\">\n            <div data-kid=\"214\"></div>\n            <div class=\"pl-12\" data-kid=\"215\">\n              <div class=\"font-mono text-[10px] tracking-widest text-ink/50\" data-kid=\"216\">STEP 04 · 00:45</div>\n              <h3 class=\"font-display text-[26px] mt-1\" data-kid=\"217\">Strain over a king cube</h3>\n              <p class=\"text-[13px] text-ink/75 leading-relaxed\" data-kid=\"218\"><b data-kid=\"219\">Julep-strain</b> into the rocks glass holding one <b data-kid=\"220\">2-inch cube</b>. The single mass melts slowly and keeps your ratios honest from first sip to last.</p>\n            </div>\n            <div class=\"absolute left-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-amber text-cream flex items-center justify-center text-[16px]\" data-kid=\"221\"><i class=\"ti ti-filter\" data-kid=\"222\"></i></div>\n          </div>\n\n          \n          <div class=\"grid grid-cols-2 gap-10 mb-12 items-center relative step-reveal\" data-kid=\"223\">\n            <div class=\"text-right pr-12\" data-kid=\"224\">\n              <div class=\"font-mono text-[10px] tracking-widest text-ink/50\" data-kid=\"225\">STEP 05 · 00:52</div>\n              <h3 class=\"font-display text-[26px] mt-1\" data-kid=\"226\">Express the oil</h3>\n              <p class=\"text-[13px] text-ink/75 leading-relaxed\" data-kid=\"227\"><b data-kid=\"228\">Snap</b> a fresh orange peel skin-down over the surface. The oils ignite the bouquet; the aroma is half the cocktail.</p>\n            </div>\n            <div data-kid=\"229\"></div>\n            <div class=\"absolute left-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-campari text-cream flex items-center justify-center text-[16px]\" data-kid=\"230\"><i class=\"ti ti-droplet\" data-kid=\"231\"></i></div>\n          </div>\n\n          \n          <div class=\"grid grid-cols-2 gap-10 items-center relative step-reveal\" data-kid=\"232\">\n            <div data-kid=\"233\"></div>\n            <div class=\"pl-12\" data-kid=\"234\">\n              <div class=\"font-mono text-[10px] tracking-widest text-ink/50\" data-kid=\"235\">STEP 06 · 01:00</div>\n              <h3 class=\"font-display text-[26px] mt-1\" data-kid=\"236\">Garnish & serve</h3>\n              <p class=\"text-[13px] text-ink/75 leading-relaxed\" data-kid=\"237\">Rest the peel on the rim, twist-side up. <b data-kid=\"238\">Serve immediately</b>. A Negroni waits for no one.</p>\n            </div>\n            <div class=\"absolute left-1/2 -translate-x-1/2 w-10 h-10 rounded-full bg-rose text-ink flex items-center justify-center text-[16px]\" data-kid=\"239\"><i class=\"ti ti-check\" data-kid=\"240\"></i></div>\n          </div>\n        </div>\n      </section>\n\n      \n      <section class=\"bg-ink text-cream px-10 py-14\" data-kid=\"241\">\n        <div class=\"flex items-end justify-between border-b border-cream/20 pb-4 mb-10\" data-kid=\"242\">\n          <div data-kid=\"243\">\n            <div class=\"font-mono text-[10px] tracking-[0.25em] uppercase text-rose\" data-kid=\"244\">03 · Library</div>\n            <h2 class=\"font-display text-[48px] leading-none mt-1\" data-kid=\"245\">312 bottles, <span class=\"italic\" data-kid=\"246\">indexed</span>.</h2>\n          </div>\n          <div class=\"font-mono text-[11px] text-cream/55\" data-kid=\"247\">A–Z · last updated 11·2025</div>\n        </div>\n\n        <div class=\"grid grid-cols-12 gap-8\" data-kid=\"248\">\n          \n          <aside class=\"col-span-3 font-body text-[13px]\" data-kid=\"249\">\n            <div class=\"font-mono text-[10px] tracking-[0.25em] uppercase text-cream/45 mb-3\" data-kid=\"250\">Category</div>\n            <div class=\"flex flex-wrap gap-2 mb-6\" data-kid=\"251\">\n              <button class=\"chip chip-on !border-cream !bg-cream !text-ink\" data-kid=\"252\">All · 312</button>\n              <button class=\"chip !border-cream/40 !text-cream/80\" data-kid=\"253\">Base Spirits</button>\n              <button class=\"chip !border-cream/40 !text-cream/80\" data-kid=\"254\">Amari</button>\n              <button class=\"chip !border-cream/40 !text-cream/80\" data-kid=\"255\">Vermouths</button>\n              <button class=\"chip !border-cream/40 !text-cream/80\" data-kid=\"256\">Syrups</button>\n              <button class=\"chip !border-cream/40 !text-cream/80\" data-kid=\"257\">Citrus</button>\n              <button class=\"chip !border-cream/40 !text-cream/80\" data-kid=\"258\">Bitters</button>\n            </div>\n\n            <div class=\"font-mono text-[10px] tracking-[0.25em] uppercase text-cream/45 mb-3\" data-kid=\"259\">ABV range</div>\n            <div class=\"relative h-1 bg-cream/15 rounded-full mb-2\" data-kid=\"260\">\n              <div class=\"absolute left-[20%] right-[30%] h-1 bg-campari rounded-full\" data-kid=\"261\"></div>\n              <div class=\"absolute left-[20%] -top-1 w-3 h-3 bg-cream rounded-full\" data-kid=\"262\"></div>\n              <div class=\"absolute right-[30%] -top-1 w-3 h-3 bg-cream rounded-full\" data-kid=\"263\"></div>\n            </div>\n            <div class=\"flex justify-between font-mono text-[10px] text-cream/55 mb-6\" data-kid=\"264\"><span data-kid=\"265\">15%</span><span data-kid=\"266\">52%</span></div>\n\n            <div class=\"font-mono text-[10px] tracking-[0.25em] uppercase text-cream/45 mb-3\" data-kid=\"267\">Flavor</div>\n            <ul class=\"space-y-2 text-cream/85\" data-kid=\"268\">\n              <li class=\"flex items-center justify-between\" data-kid=\"269\"><label class=\"flex items-center gap-2\" data-kid=\"270\"><span class=\"w-3 h-3 border border-cream/50 inline-block\" data-kid=\"271\"></span> Bitter</label><span class=\"font-mono text-[10px] text-cream/45\" data-kid=\"272\">48</span></li>\n              <li class=\"flex items-center justify-between\" data-kid=\"273\"><label class=\"flex items-center gap-2\" data-kid=\"274\"><span class=\"w-3 h-3 border border-cream/50 inline-block bg-cream\" data-kid=\"275\"></span> Herbaceous</label><span class=\"font-mono text-[10px] text-cream/45\" data-kid=\"276\">62</span></li>\n              <li class=\"flex items-center justify-between\" data-kid=\"277\"><label class=\"flex items-center gap-2\" data-kid=\"278\"><span class=\"w-3 h-3 border border-cream/50 inline-block\" data-kid=\"279\"></span> Citrus</label><span class=\"font-mono text-[10px] text-cream/45\" data-kid=\"280\">31</span></li>\n              <li class=\"flex items-center justify-between\" data-kid=\"281\"><label class=\"flex items-center gap-2\" data-kid=\"282\"><span class=\"w-3 h-3 border border-cream/50 inline-block\" data-kid=\"283\"></span> Smoky</label><span class=\"font-mono text-[10px] text-cream/45\" data-kid=\"284\">19</span></li>\n              <li class=\"flex items-center justify-between\" data-kid=\"285\"><label class=\"flex items-center gap-2\" data-kid=\"286\"><span class=\"w-3 h-3 border border-cream/50 inline-block\" data-kid=\"287\"></span> Floral</label><span class=\"font-mono text-[10px] text-cream/45\" data-kid=\"288\">24</span></li>\n            </ul>\n\n            <div class=\"mt-8 p-4 border border-cream/20 rounded-sm\" data-kid=\"289\">\n              <div class=\"font-mono text-[10px] tracking-widest text-cream/55 mb-2\" data-kid=\"290\">PAIR-WITH</div>\n              <div class=\"font-display text-[18px] leading-tight\" data-kid=\"291\">\"Show me only ingredients that appear in Negroni-family drinks.\"</div>\n              <button class=\"mt-3 font-mono text-[10px] tracking-widest text-campari\" data-kid=\"292\">APPLY FILTER →</button>\n            </div>\n          </aside>\n\n          \n          <div class=\"col-span-9 grid grid-cols-3 gap-5\" data-kid=\"293\">\n\n            \n            <div class=\"row-span-2 bg-[#D8968E] text-ink rounded-sm p-5 relative overflow-hidden border border-cream/10 flex flex-col\" data-kid=\"294\">\n              <div class=\"flex items-start justify-between\" data-kid=\"295\">\n                <div data-kid=\"296\">\n                  <div class=\"font-mono text-[10px] tracking-widest opacity-70\" data-kid=\"297\">VERMOUTH · 16.5%</div>\n                  <h3 class=\"font-display text-[34px] leading-none mt-2\" data-kid=\"298\">Carpano<br data-kid=\"299\"><span class=\"italic\" data-kid=\"300\">Antica</span></h3>\n                </div>\n                <i class=\"ti ti-bookmark text-[18px] opacity-60\" data-kid=\"301\"></i>\n              </div>\n              <div class=\"flex-1 flex items-center justify-center my-4 relative\" data-kid=\"302\">\n                <div class=\"absolute inset-0 crosshatch opacity-30 rounded\" data-kid=\"303\"></div>\n                <img src=\"https://images.pexels.com/photos/8148448/pexels-photo-8148448.jpeg?auto=compress&cs=tinysrgb&w=400&q=80\" class=\"h-56 object-contain mix-blend-multiply relative\" decoding=\"async\" loading=\"lazy\" alt data-kid=\"304\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n              </div>\n              <p class=\"text-[12px] leading-relaxed opacity-85\" data-kid=\"305\">Rich, vanilla-laden Italian sweet vermouth. Base wine fortified with brandy, botanized with bitter orange & saffron.</p>\n              <div class=\"mt-3 pt-3 border-t border-ink/20 font-mono text-[10px] flex justify-between\" data-kid=\"306\"><span data-kid=\"307\">USED IN 14 DRINKS</span><span data-kid=\"308\">→</span></div>\n            </div>\n\n            \n            <div class=\"bg-[#A5742E] text-cream rounded-sm p-5 border border-cream/10 relative overflow-hidden\" data-kid=\"309\">\n              <div class=\"absolute inset-0 crosshatch opacity-25\" data-kid=\"310\"></div>\n              <div class=\"relative\" data-kid=\"311\">\n                <div class=\"font-mono text-[10px] tracking-widest opacity-70\" data-kid=\"312\">GIN · 47.3%</div>\n                <h3 class=\"font-display text-[26px] leading-none mt-2\" data-kid=\"313\">Tanqueray<br data-kid=\"314\"><span class=\"italic\" data-kid=\"315\">No. Ten</span></h3>\n                <div class=\"h-20 flex items-center justify-center my-2\" data-kid=\"316\">\n                  <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/wine-bottle.svg\" class=\"h-16 invert opacity-90\" decoding=\"async\" loading=\"lazy\" alt data-kid=\"317\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n                </div>\n                <p class=\"text-[11px] opacity-80 leading-relaxed\" data-kid=\"318\">Citrus-forward London dry. Fresh grapefruit, juniper backbone.</p>\n                <div class=\"mt-3 font-mono text-[10px] opacity-70\" data-kid=\"319\">USED IN 22 DRINKS →</div>\n              </div>\n            </div>\n\n            \n            <div class=\"bg-[#B82E26] text-cream rounded-sm p-5 border border-cream/10 relative overflow-hidden\" data-kid=\"320\">\n              <div class=\"absolute inset-0 stripes-light opacity-30\" data-kid=\"321\"></div>\n              <div class=\"relative\" data-kid=\"322\">\n                <div class=\"font-mono text-[10px] tracking-widest opacity-80\" data-kid=\"323\">AMARO · 24%</div>\n                <h3 class=\"font-display text-[28px] leading-none mt-2\" data-kid=\"324\">Campari</h3>\n                <div class=\"h-20 flex items-center justify-center my-2\" data-kid=\"325\">\n                  <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/brandy-bottle.svg\" class=\"h-16 invert opacity-90\" decoding=\"async\" loading=\"lazy\" alt data-kid=\"326\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n                </div>\n                <p class=\"text-[11px] opacity-90 leading-relaxed\" data-kid=\"327\">Ruby Italian bitter. 60+ botanicals; cinchona-led, gentian-bone.</p>\n                <div class=\"mt-3 font-mono text-[10px] opacity-80\" data-kid=\"328\">USED IN 38 DRINKS →</div>\n              </div>\n            </div>\n\n            \n            <div class=\"bg-cream text-ink rounded-sm p-5 border border-ink/10 relative\" data-kid=\"329\">\n              <div class=\"font-mono text-[10px] tracking-widest opacity-60\" data-kid=\"330\">BITTERS · 44%</div>\n              <h3 class=\"font-display text-[24px] leading-none mt-2\" data-kid=\"331\">Angostura</h3>\n              <div class=\"h-16 flex items-center justify-center my-2\" data-kid=\"332\">\n                <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/glass-shot.svg\" class=\"h-14 opacity-90\" decoding=\"async\" loading=\"lazy\" alt data-kid=\"333\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n              </div>\n              <p class=\"text-[11px] opacity-75 leading-relaxed\" data-kid=\"334\">Trinidadian aromatic bitters — gentian, clove, cardamom. Sold by the dash.</p>\n              <div class=\"mt-3 font-mono text-[10px] text-campari\" data-kid=\"335\">USED IN 86 DRINKS →</div>\n            </div>\n\n            \n            <div class=\"row-span-2 bg-cream text-ink rounded-sm overflow-hidden border border-ink/10 flex flex-col\" data-kid=\"336\">\n              <div class=\"h-72 bg-[#1C1710] relative overflow-hidden\" data-kid=\"337\">\n                <img src=\"https://images.pexels.com/photos/7253927/pexels-photo-7253927.jpeg?auto=compress&cs=tinysrgb&w=500&q=80\" class=\"w-full h-full object-cover opacity-90\" decoding=\"async\" loading=\"lazy\" alt data-kid=\"338\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n                <div class=\"absolute top-3 left-3 font-mono text-[10px] tracking-widest text-cream bg-ink/60 px-2 py-1\" data-kid=\"339\">WHISKEY · 50%</div>\n              </div>\n              <div class=\"p-5 flex-1\" data-kid=\"340\">\n                <h3 class=\"font-display text-[28px] leading-none\" data-kid=\"341\">Rittenhouse<br data-kid=\"342\"><span class=\"italic\" data-kid=\"343\">Rye</span></h3>\n                <p class=\"text-[12px] opacity-75 leading-relaxed mt-2\" data-kid=\"344\">Bonded American rye — spice-forward, oily backbone. Spec-grade for Manhattans, Sazeracs, Old-Fashioneds.</p>\n                <div class=\"mt-3 pt-3 border-t border-ink/15 font-mono text-[10px] flex justify-between\" data-kid=\"345\"><span data-kid=\"346\">USED IN 19 DRINKS</span><span class=\"text-campari\" data-kid=\"347\">→</span></div>\n              </div>\n            </div>\n\n            \n            <div class=\"bg-[#F2EBD6] text-ink rounded-sm p-5 border border-ink/10\" data-kid=\"348\">\n              <div class=\"font-mono text-[10px] tracking-widest opacity-60\" data-kid=\"349\">CITRUS · ⌀ 7cm</div>\n              <h3 class=\"font-display text-[24px] leading-none mt-2\" data-kid=\"350\">Sicilian Orange</h3>\n              <div class=\"h-14 flex items-center justify-center my-2 gap-2\" data-kid=\"351\">\n                <span class=\"w-10 h-10 rounded-full bg-amber\" data-kid=\"352\"></span>\n                <span class=\"w-7 h-7 rounded-full bg-amber/70\" data-kid=\"353\"></span>\n                <span class=\"w-4 h-4 rounded-full bg-amber/40\" data-kid=\"354\"></span>\n              </div>\n              <p class=\"text-[11px] opacity-75 leading-relaxed\" data-kid=\"355\">Tarocco preferred — high oil yield, low pith. Express skin-down, never down.</p>\n              <div class=\"mt-3 font-mono text-[10px] opacity-60\" data-kid=\"356\">USED IN 47 DRINKS →</div>\n            </div>\n\n            \n            <div class=\"bg-[#D8968E]/40 text-cream rounded-sm p-5 border border-cream/15 relative overflow-hidden\" data-kid=\"357\">\n              <div class=\"absolute inset-0 crosshatch opacity-20\" data-kid=\"358\"></div>\n              <div class=\"relative\" data-kid=\"359\">\n                <div class=\"font-mono text-[10px] tracking-widest text-cream/70\" data-kid=\"360\">VERMOUTH · 18%</div>\n                <h3 class=\"font-display text-[22px] leading-none mt-2\" data-kid=\"361\">Dolin Dry</h3>\n                <p class=\"text-[11px] opacity-80 leading-relaxed mt-3\" data-kid=\"362\">Crisp Chambéry vermouth. Alpine herb, gentle white-wine bone.</p>\n                <div class=\"mt-3 font-mono text-[10px] opacity-70\" data-kid=\"363\">USED IN 11 DRINKS →</div>\n              </div>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      \n      <section class=\"relative bg-[#0e0a06] text-cream px-10 py-16 overflow-hidden\" data-kid=\"364\">\n        <div class=\"absolute inset-0 glow-spot\" data-kid=\"365\"></div>\n        <div class=\"relative\" data-kid=\"366\">\n          <div class=\"flex items-end justify-between border-b border-cream/20 pb-4 mb-10\" data-kid=\"367\">\n            <div data-kid=\"368\">\n              <div class=\"font-mono text-[10px] tracking-[0.25em] uppercase text-campari\" data-kid=\"369\">04 · Flashcards</div>\n              <h2 class=\"font-display text-[48px] leading-none mt-1\" data-kid=\"370\">Drill mode — <span class=\"italic\" data-kid=\"371\">recall</span>, then flip.</h