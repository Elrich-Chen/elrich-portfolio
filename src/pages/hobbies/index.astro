---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('hobbies');
const photos = await getCollection('photos');
const entries = await Promise.all(
  posts.map(async (entry) => {
    const { Content } = await entry.render();
    return { entry, Content };
  })
);
const sortedEntries = entries.sort((a, b) => {
  const dateA = Date.parse(a.entry.data.date || '');
  const dateB = Date.parse(b.entry.data.date || '');
  if (Number.isNaN(dateA) || Number.isNaN(dateB)) {
    return 0;
  }
  return dateB - dateA;
});

const fallbackPhoto = '/photos/hat.jpeg';
const getRandomPhotoForEntry = (seed: string) => {
  if (!photos.length) return fallbackPhoto;
  const hash = Array.from(seed).reduce((acc, ch) => acc + ch.charCodeAt(0), 0);
  return photos[hash % photos.length]?.data.image ?? fallbackPhoto;
};

const issueDate = new Date().toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
}).toUpperCase();

const entryCount = sortedEntries.length;
---

<Base title="Hobbies – Elrich Chen">
  <div class="hobbies-content-shell ascii-surface">
    <div class="hobbies-back">
      <a href="/" class="back-home-link">← Back to home</a>
    </div>

    <header class="masthead">
      <div class="masthead-meta">
        <span class="masthead-edition">Field Notes · Vol. IV</span>
        <span class="masthead-rule" aria-hidden="true"></span>
        <span class="masthead-date">{issueDate}</span>
      </div>
      <h1 class="masthead-title">
        <span class="masthead-amper">H</span>obbies
      </h1>
      <p class="masthead-sub">
        Off-keyboard rituals, side quests, and the small obsessions that keep the main thread human.
      </p>
    </header>

    <section class="entries-section" aria-labelledby="entries-heading">
      <p class="eyebrow" id="entries-heading">
        <span class="eyebrow-num">01</span>
        <span class="eyebrow-rule"></span>
        <span class="eyebrow-label">Catalog · {entryCount} {entryCount === 1 ? 'entry' : 'entries'}</span>
      </p>

      <div class="entries-catalog">
        {sortedEntries.map(({ entry, Content }, index) => (
          <details class="entry-row hobby-details">
            <summary class="entry-summary">
              <span class="entry-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="entry-main">
                <div class="entry-head">
                  <h2 class="entry-title">{entry.data.title}</h2>
                  {entry.data.date && (
                    <time class="entry-date" datetime={entry.data.date}>
                      {entry.data.date}
                    </time>
                  )}
                </div>
                {entry.data.summary && (
                  <p class="entry-lede">{entry.data.summary}</p>
                )}
                {entry.data.tags?.length > 0 && (
                  <div class="entry-tags" aria-label="Tags">
                    {entry.data.tags.map((tag: string) => (
                      <span class="entry-tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
              <span class="entry-chevron" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 8l4 4 4-4" />
                </svg>
              </span>
            </summary>

            <div class="entry-expand">
              <div class="entry-expand-inner">
                <figure class="entry-photo">
                  <img
                    src={getRandomPhotoForEntry(entry.slug)}
                    alt={`Hobby visual for ${entry.data.title}`}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <div class="entry-prose">
                  <Content />
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </section>

    <div class="hobbies-colophon" aria-hidden="true">
      <span>— end of issue —</span>
    </div>
  </div>
</Base>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.hobby-details').forEach((details) => {
      details.addEventListener('toggle', () => {
        if (details.open) {
          const title = details.querySelector('.entry-title')?.textContent?.trim() || 'unknown';
          window.posthog?.capture('hobby_expanded', {
            hobby_title: title,
          });
        }
      });
    });
  });
</script>

<style>
  /* ─── Shell: no opaque wrapper — ASCII stays visible ─────────────── */
  .hobbies-content-shell {
    position: relative;
    z-index: 3;
    color: #fff;
    padding-bottom: 2.5rem;
  }

  .hobbies-back {
    margin-bottom: 1.25rem;
  }

  /* ─── Masthead ───────────────────────────────────────────────────── */
  .masthead {
    margin: 0.5rem 0 2.2rem;
  }

  .masthead-meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Menlo', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 1.2rem;
  }

  .masthead-edition,
  .masthead-date {
    white-space: nowrap;
  }

  .masthead-rule {
    flex: 1 1 auto;
    height: 1px;
    min-width: 1.5rem;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0.25),
      rgba(255, 255, 255, 0.06)
    );
  }

  .masthead-title {
    margin: 0;
    font-family: 'Syne', 'Rubik', sans-serif;
    font-weight: 700;
    font-size: clamp(2.8rem, 9vw, 5.4rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: #fff;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.45);
  }

  .masthead-amper {
    display: inline-block;
    font-style: italic;
    transform: translateY(-0.04em);
  }

  .masthead-sub {
    margin: 1rem 0 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
    max-width: 48ch;
    line-height: 1.55;
  }

  /* ─── Eyebrow ────────────────────────────────────────────────────── */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.15rem;
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Menlo', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }

  .eyebrow-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.55rem;
    height: 1.55rem;
    padding: 0 0.32rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffd28a;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .eyebrow-rule {
    width: 1.4rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.3);
  }

  .eyebrow-label {
    white-space: nowrap;
  }

  /* ─── Catalog: spaced rows, glass cards ──────────────────────────── */
  .entries-section {
    margin-bottom: 2rem;
  }

  .entries-catalog {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .entry-row {
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(8, 10, 18, 0.38);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
    overflow: hidden;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      background 0.3s ease;
  }

  .entry-row[open] {
    border-color: rgba(255, 210, 138, 0.35);
    background: rgba(8, 10, 18, 0.48);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.38);
  }

  .entry-summary {
    cursor: pointer;
    list-style: none;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 1rem 1.1rem;
    padding: 1.35rem 1.4rem 1.3rem;
    color: inherit;
    transition: background 0.25s ease;
  }

  .entry-summary:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .entry-summary::-webkit-details-marker {
    display: none;
  }

  .entry-summary::marker {
    content: '';
  }

  .entry-index {
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Menlo', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: rgba(255, 210, 138, 0.85);
    padding-top: 0.35rem;
    min-width: 1.75rem;
  }

  .entry-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .entry-title {
    margin: 0;
    font-family: 'Syne', 'Rubik', sans-serif;
    font-size: clamp(1.05rem, 2.4vw, 1.28rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .entry-date {
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Menlo', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    white-space: nowrap;
  }

  .entry-lede {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
    max-width: 58ch;
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .entry-tag {
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Menlo', monospace;
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.28rem 0.62rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.88);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .entry-row[open] .entry-tag {
    border-color: rgba(255, 210, 138, 0.35);
    background: rgba(255, 210, 138, 0.1);
  }

  .entry-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-top: 0.1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.9);
    transition:
      transform 0.38s cubic-bezier(0.34, 1.2, 0.5, 1),
      border-color 0.25s ease,
      background 0.25s ease;
  }

  .entry-chevron svg {
    width: 16px;
    height: 16px;
  }

  .entry-row[open] .entry-chevron {
    transform: rotate(180deg);
    border-color: rgba(255, 210, 138, 0.5);
    background: rgba(255, 210, 138, 0.12);
    color: #ffd28a;
  }

  /* ─── Expanded body ──────────────────────────────────────────────── */
  .entry-expand {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0 1.4rem 1.35rem;
    animation: entry-reveal 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes entry-reveal {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .entry-expand-inner {
    display: grid;
    grid-template-columns: minmax(0, 200px) minmax(0, 1fr);
    gap: 1.25rem 1.5rem;
    align-items: start;
    padding-top: 1.15rem;
  }

  .entry-photo {
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
    aspect-ratio: 1;
  }

  .entry-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .entry-prose {
    font-size: 0.9rem;
    line-height: 1.68;
    color: rgba(255, 255, 255, 0.86);
    max-width: 65ch;
  }

  .entry-prose :global(p) {
    margin: 0 0 0.95rem;
  }

  .entry-prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .entry-prose :global(a) {
    color: #ffd28a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .entry-prose :global(a:hover) {
    color: #fff;
  }

  .entry-prose :global(strong) {
    color: #fff;
    font-weight: 600;
  }

  .entry-prose :global(:is(p, li, ul, ol, h1, h2, h3, h4, h5, h6, blockquote, span, div, em, code)) {
    color: #fff !important;
  }

  /* Card copy always white (both themes) */
  .entry-row,
  .entry-row :is(.entry-summary, .entry-expand, .entry-main, .entry-expand-inner) {
    color: #fff !important;
  }

  .entry-row :is(.entry-title, .entry-lede, .entry-date, .entry-tag, .entry-chevron) {
    color: #fff !important;
  }

  .entry-row .entry-index {
    color: rgba(255, 210, 138, 0.9) !important;
  }

  .entry-row .entry-lede,
  .entry-row .entry-date {
    color: rgba(255, 255, 255, 0.78) !important;
  }

  .entry-row .entry-prose :global(a) {
    color: #ffd28a !important;
  }

  /* ─── Colophon ───────────────────────────────────────────────────── */
  .hobbies-colophon {
    text-align: center;
    margin: 2rem 0 0.5rem;
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Menlo', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
  }

  :global(html.light) .entry-row {
    background: rgba(8, 10, 18, 0.42);
    border-color: rgba(255, 255, 255, 0.16);
  }

  :global(html.light) .entry-row[open] {
    background: rgba(8, 10, 18, 0.5);
    border-color: rgba(255, 210, 138, 0.38);
  }

  :global(html.light) .entry-summary:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  /* ─── Tablet ─────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .masthead {
      margin-bottom: 1.8rem;
    }

    .masthead-sub {
      font-size: 0.88rem;
    }

    .entries-catalog {
      gap: 1.25rem;
    }

    /* Mobile: lighter glass so ASCII backdrop reads through gaps */
    .entry-row {
      background: rgba(8, 10, 18, 0.28);
      border-color: rgba(255, 255, 255, 0.12);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.22);
    }

    .entry-row[open] {
      background: rgba(8, 10, 18, 0.34);
    }

    .entry-summary {
      grid-template-columns: auto 1fr auto;
      gap: 0.85rem 0.75rem;
      padding: 1.15rem 1.1rem 1.1rem;
    }

    .entry-expand {
      padding: 0 1.1rem 1.15rem;
    }

    .entry-expand-inner {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .entry-photo {
      max-width: 220px;
      aspect-ratio: 4 / 3;
    }

    .entry-chevron {
      width: 2.35rem;
      height: 2.35rem;
    }
  }

  /* ─── Small phones ───────────────────────────────────────────────── */
  @media (max-width: 480px) {
    .hobbies-content-shell {
      padding-bottom: 1.5rem;
    }

    .masthead-meta {
      gap: 0.55rem;
      font-size: 0.62rem;
      letter-spacing: 0.18em;
    }

    .masthead-sub {
      margin-top: 0.85rem;
      font-size: 0.85rem;
    }

    .eyebrow {
      margin-bottom: 0.9rem;
      font-size: 0.65rem;
    }

    .entries-catalog {
      gap: 1.35rem;
    }

    .entry-row {
      border-radius: 14px;
      background: rgba(8, 10, 18, 0.24);
    }

    .entry-row[open] {
      background: rgba(8, 10, 18, 0.32);
    }

    .entry-summary {
      padding: 1rem 0.95rem 0.95rem;
    }

    .entry-title {
      font-size: 1rem;
    }

    .entry-lede {
      font-size: 0.86rem;
    }

    .entry-photo {
      max-width: none;
      width: 100%;
    }

    .entry-prose {
      font-size: 0.86rem;
    }

    .hobbies-colophon {
      font-size: 0.62rem;
      letter-spacing: 0.22em;
    }
  }
</style>
