---
import PostHog from '../components/posthog.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Elrich Chen — Portfolio in Progress</title>
    <meta name="description" content="Portfolio currently under construction. Check back soon." />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/e.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Syne:wght@700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="wip" aria-label="Portfolio in progress">
      <div class="wip-atmosphere" aria-hidden="true">
        <div class="wip-noise"></div>
        <div class="wip-grid"></div>
        <div class="wip-orb wip-orb--a"></div>
        <div class="wip-orb wip-orb--b"></div>
        <div class="wip-scan"></div>
      </div>

      <div class="wip-stage">
        <p class="wip-brand">Elrich Chen</p>

        <p class="wip-status">
          <span class="wip-pulse" aria-hidden="true"></span>
          <span>Work in progress</span>
        </p>

        <h1 class="wip-title">
          <span class="wip-line" style="--i: 0">Portfolio</span>
          <span class="wip-line wip-line--accent" style="--i: 1">in progress</span>
        </h1>

        <div
          class="wip-meter"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="67"
          aria-label="Build progress"
        >
          <div class="wip-meter-track">
            <div class="wip-meter-fill"></div>
            <div class="wip-meter-glint"></div>
          </div>
          <div class="wip-meter-meta">
            <span>Rebuilding</span>
            <span class="wip-meter-pct" data-wip-pct>67%</span>
          </div>
        </div>

        <p class="wip-note">
          Everything is being rebuilt from scratch. Reach me at
          <a href="mailto:eklchen@uwaterloo.ca" class="wip-mail">eklchen@uwaterloo.ca</a>
          in the meantime.
        </p>
      </div>
    </main>

    <PostHog />

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
        const pct = document.querySelector('[data-wip-pct]');
        if (!(pct instanceof HTMLElement) || prefersReducedMotion) return;

        const target = 67;
        const duration = 3200;
        const start = performance.now();

        const tick = (now: number) => {
          const t = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          pct.textContent = `${Math.round(eased * target)}%`;
          if (t < 1) requestAnimationFrame(tick);
        };

        requestAnimationFrame(tick);

        document.querySelectorAll('a[href^="mailto:"]').forEach((el) => {
          el.addEventListener('click', () => {
            window.posthog?.capture('contact_email_clicked', { location: 'wip_holding' });
          });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
    background: #07080c;
    color: #f4f1ea;
  }

  body {
    min-height: 100dvh;
    font-family: 'Syne', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  .wip {
    --wip-ink: 244 241 234;
    --wip-muted: 168 174 186;
    --wip-accent: 255 176 92;
    --wip-accent-deep: 220 118 48;

    position: relative;
    isolation: isolate;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 5vw, 3rem);
    overflow: hidden;
    color: rgb(var(--wip-ink));
  }

  .wip-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(ellipse 80% 55% at 50% 35%, rgba(36, 28, 18, 0.9), transparent 70%),
      linear-gradient(160deg, #0a0b10 0%, #12141c 45%, #08090d 100%);
  }

  .wip-noise {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
  }

  .wip-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: radial-gradient(ellipse 65% 55% at 50% 45%, black 15%, transparent 72%);
    animation: wip-grid-drift 28s linear infinite;
  }

  .wip-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(64px);
    opacity: 0.5;
  }

  .wip-orb--a {
    width: min(48vw, 30rem);
    height: min(48vw, 30rem);
    top: 4%;
    left: 8%;
    background: radial-gradient(circle, rgba(255, 150, 60, 0.32), transparent 68%);
    animation: wip-orb-float 12s ease-in-out infinite;
  }

  .wip-orb--b {
    width: min(40vw, 24rem);
    height: min(40vw, 24rem);
    right: 4%;
    bottom: 8%;
    background: radial-gradient(circle, rgba(90, 130, 190, 0.22), transparent 68%);
    animation: wip-orb-float 15s ease-in-out infinite reverse;
  }

  .wip-scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(255, 200, 140, 0.06) 48%,
      transparent 52%
    );
    background-size: 100% 220%;
    animation: wip-scan 5.5s ease-in-out infinite;
  }

  .wip-stage {
    position: relative;
    z-index: 1;
    width: min(100%, 38rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.95rem, 2.5vw, 1.45rem);
  }

  .wip-brand {
    margin: 0;
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(1.35rem, 3.2vw, 1.85rem);
    font-style: italic;
    letter-spacing: 0.01em;
    color: rgb(var(--wip-ink));
    opacity: 0;
    animation: wip-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.05s forwards;
  }

  .wip-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    padding: 0.35rem 0.8rem 0.35rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(var(--wip-muted), 0.95);
    opacity: 0;
    animation: wip-enter 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.15s forwards;
  }

  .wip-pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: rgb(var(--wip-accent));
    box-shadow: 0 0 0 0 rgba(255, 176, 92, 0.55);
    animation: wip-pulse 1.8s ease-out infinite;
  }

  .wip-title {
    margin: 0;
    display: grid;
    gap: 0.02em;
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.92;
    text-transform: uppercase;
  }

  .wip-line {
    display: block;
    font-size: clamp(2.75rem, 12vw, 5.75rem);
    opacity: 0;
    transform: translateY(0.5em);
    animation: wip-title-in 1.05s cubic-bezier(0.22, 1, 0.36, 1) calc(0.25s + var(--i) * 0.12s) forwards;
  }

  .wip-line--accent {
    color: rgb(var(--wip-accent));
    text-shadow: 0 0 0.4em rgba(255, 176, 92, 0.35);
    animation-name: wip-title-in, wip-accent-glow;
    animation-duration: 1.05s, 3.2s;
    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1), ease-in-out;
    animation-delay: calc(0.25s + var(--i) * 0.12s), 1.4s;
    animation-fill-mode: forwards, none;
    animation-iteration-count: 1, infinite;
  }

  .wip-meter {
    width: min(100%, 22rem);
    display: grid;
    gap: 0.55rem;
    opacity: 0;
    animation: wip-enter 0.95s cubic-bezier(0.22, 1, 0.36, 1) 0.55s forwards;
  }

  .wip-meter-track {
    position: relative;
    height: 3px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
  }

  .wip-meter-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    border-radius: inherit;
    background: linear-gradient(90deg, rgb(var(--wip-accent-deep)), rgb(var(--wip-accent)), #ffe0b0);
    box-shadow: 0 0 18px rgba(255, 176, 92, 0.45);
    animation:
      wip-fill 3.6s cubic-bezier(0.22, 1, 0.36, 1) 0.75s forwards,
      wip-breathe 2.8s ease-in-out 4.4s infinite;
  }

  .wip-meter-glint {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 28%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: translateX(-120%);
    animation: wip-glint 2.4s ease-in-out 1.2s infinite;
  }

  .wip-meter-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(var(--wip-muted), 0.9);
  }

  .wip-meter-pct {
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: rgb(var(--wip-accent));
    font-variant-numeric: tabular-nums;
  }

  .wip-note {
    margin: 0;
    max-width: 28rem;
    font-size: clamp(0.95rem, 2.2vw, 1.08rem);
    line-height: 1.55;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: rgba(var(--wip-muted), 0.98);
    opacity: 0;
    animation: wip-enter 0.95s cubic-bezier(0.22, 1, 0.36, 1) 0.75s forwards;
  }

  .wip-mail {
    color: rgb(var(--wip-accent));
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 176, 92, 0.4);
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .wip-mail:hover {
    color: #ffe4b8;
    text-decoration-color: rgba(255, 228, 184, 0.85);
  }

  @keyframes wip-enter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes wip-title-in {
    from {
      opacity: 0;
      transform: translateY(0.5em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes wip-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(255, 176, 92, 0.55);
    }
    70% {
      box-shadow: 0 0 0 12px rgba(255, 176, 92, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(255, 176, 92, 0);
    }
  }

  @keyframes wip-fill {
    0% {
      width: 0%;
    }
    70%,
    100% {
      width: 67%;
    }
  }

  @keyframes wip-breathe {
    0%,
    100% {
      filter: brightness(1);
      box-shadow: 0 0 18px rgba(255, 176, 92, 0.35);
    }
    50% {
      filter: brightness(1.18);
      box-shadow: 0 0 26px rgba(255, 176, 92, 0.6);
    }
  }

  @keyframes wip-glint {
    0%,
    35% {
      transform: translateX(-120%);
    }
    70%,
    100% {
      transform: translateX(380%);
    }
  }

  @keyframes wip-accent-glow {
    0%,
    100% {
      color: rgb(var(--wip-accent));
      text-shadow: 0 0 0.35em rgba(255, 176, 92, 0.3);
    }
    50% {
      color: #ffe4b8;
      text-shadow: 0 0 0.55em rgba(255, 210, 150, 0.55);
    }
  }

  @keyframes wip-scan {
    0%,
    100% {
      background-position: 0% 0%;
    }
    50% {
      background-position: 0% 100%;
    }
  }

  @keyframes wip-grid-drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-52px, -52px, 0);
    }
  }

  @keyframes wip-orb-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(4%, -6%, 0) scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wip-grid,
    .wip-orb,
    .wip-scan,
    .wip-pulse,
    .wip-meter-fill,
    .wip-meter-glint,
    .wip-line--accent {
      animation: none;
    }

    .wip-brand,
    .wip-status,
    .wip-line,
    .wip-meter,
    .wip-note {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .wip-line--accent {
      color: rgb(var(--wip-accent));
    }

    .wip-meter-fill {
      width: 67%;
    }
  }
</style>
