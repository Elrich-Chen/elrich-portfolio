---
import LumenLayout from '../layouts/LumenLayout.astro';
import Hero from '../components/lumen/Hero.astro';
import Statement from '../components/lumen/Statement.astro';
import Principles from '../components/lumen/Principles.astro';
import ProductWindow from '../components/lumen/ProductWindow.astro';
import CTA from '../components/lumen/CTA.astro';
---

<LumenLayout>
  <Hero />
  <Statement />
  <Principles />
  <ProductWindow />
  <CTA />

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const boot = () => initAnimations();
    if (document.readyState === 'complete') boot();
    else window.addEventListener('load', boot, { once: true });

    function initAnimations() {
      const desktopMQ = window.matchMedia('(min-width: 1024px)');

      // Hero fade on scroll (desktop)
      if (desktopMQ.matches) {
        gsap.to('.hero-copy', {
          scrollTrigger: {
            trigger: '#hero',
            start: 'top top',
            end: 'bottom top',
            scrub: true,
          },
          opacity: 0,
          y: -50,
          scale: 0.95,
        });

        gsap.to('.spline-col', {
          scrollTrigger: {
            trigger: '#hero',
            start: 'top top',
            end: 'bottom top',
            scrub: true,
          },
          opacity: 0,
          scale: 0.9,
        });
      }

      // Nav appears after hero
      const hero = document.getElementById('hero');
      if (hero) {
        ScrollTrigger.create({
          trigger: hero,
          start: 'bottom 20%',
          onEnter: () => {
            gsap.to('#site-nav', {
              opacity: 1,
              y: 0,
              pointerEvents: 'auto',
              duration: 0.4,
              ease: 'power2.out',
            });
          },
          onLeaveBack: () => {
            gsap.to('#site-nav', {
              opacity: 0,
              y: '-100%',
              pointerEvents: 'none',
              duration: 0.4,
              ease: 'power2.in',
            });
          },
        });
      }

      // Page thread progress
      gsap.to('#page-thread', {
        scrollTrigger: {
          trigger: document.documentElement,
          start: 'top top',
          end: 'bottom bottom',
          scrub: true,
        },
        scaleY: 1,
        ease: 'none',
      });

      // Statement word reveal — CSS sticky handles pinning; GSAP only animates
      if (desktopMQ.matches) {
        const words = gsap.utils.toArray<HTMLElement>('.statement-word');
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: '.statement-pin',
            start: 'top top',
            end: 'bottom bottom',
            scrub: 1,
          },
        });

        words.forEach((word, i) => {
          tl.to(word, { opacity: 1, duration: 0.5 }, i * 0.15);
        });

        tl.to('.statement-rule', { scaleX: 1, duration: 0.8 }, '+=0.2');
        tl.to('.statement-caption', { opacity: 1, y: 0, duration: 0.8 }, '-=0.4');
      }

      // Principles horizontal scroll
      if (desktopMQ.matches) {
        const track = document.getElementById('principles-track');
        if (track) {
          gsap.to(track, {
            scrollTrigger: {
              trigger: '.principles-pin',
              start: 'top top',
              end: 'bottom bottom',
              scrub: 1,
            },
            x: () => -(track.scrollWidth - window.innerWidth + 120),
            ease: 'none',
          });
        }
      }

      // Product window scale-up
      if (desktopMQ.matches) {
        gsap.fromTo(
          '#product-window',
          { scale: 0.8 },
          {
            scrollTrigger: {
              trigger: '.product-pin',
              start: 'top top',
              end: 'bottom bottom',
              scrub: 1,
            },
            scale: 1,
            ease: 'none',
          }
        );
      }

      window.addEventListener('resize', () => ScrollTrigger.refresh());
    }
  </script>
</LumenLayout>
