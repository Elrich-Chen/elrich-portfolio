---
import Base from '../layouts/Base.astro';
import HeroAsciiBackdrop from '../components/HeroAsciiBackdrop.astro';
import ScrollStack from '../components/ScrollStack.astro';
import { getEntry, getCollection } from 'astro:content';

const highlights    = await getEntry('highlights', 'home');
const testimonials  = await getCollection('testimonials');

// Ensure at least 6 cards for the carousel
const carouselItems = (() => {
  if (testimonials.length === 0) return [];
  if (testimonials.length >= 6) return testimonials;
  const repeated: typeof testimonials = [];
  while (repeated.length < 6) repeated.push(...testimonials);
  return repeated.slice(0, 6);
})();

const cardMeta = {
  recent: {
    kicker: '01',
    title: 'Recently, I:',
    subtitle: 'A quick scan of wins, roles, and proof points from the last stretch.',
    chips: [] as string[],
    cta: { href: '/projects', label: 'Browse the work' },
  },
  building: {
    kicker: '02',
    title: 'Things in progress:',
    subtitle: 'Current product bets, community work, and systems I am actively shipping.',
    chips: [] as string[],
    cta: { href: '/projects', label: 'See active builds' },
  },
  clients: {
    kicker: '03',
    title: 'Client References',
    subtitle: 'Compact notes from people who trusted me to ship useful software.',
    chips: [] as string[],
    cta: { href: 'mailto:elrichchen123@gmail.com', label: 'Start a project' },
  },
};

function toPlainLabel(text: string) {
  return text
    .replace(/\[LOGO:[^\]]+\]/gi, '')
    .replace(/\[IMAGE:[^\]]+\]/gi, '')
    .replace(/\[LINK:\s*([^\]]+?)\s*\](.+?)\[\/LINK\]/gi, '$2')
    .replace(/<[^>]*>/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

// ── Company link map ──────────────────────────────────────────────────────────
const companyData: Record<string, { url: string; logo?: string }> = {
  'Ontario Legal Tech':                      { url: 'https://ontariomandatorymediation.my.canva.site/ontario-court-helper' },
  "Queen's COMPSA":                          { url: 'https://compsa.ca/', logo: 'compsa' },
  'DoneMaker':                               { url: 'https://donemaker.com', logo: 'zivko' },
  'UWaterloo':                               { url: 'https://uwaterloo.ca', logo: 'uwaterloo' },
  'QueensU':                                 { url: 'http://queensu.ca/', logo: 'queenu' },
  'University of Toronto Engineering Outreach': { url: 'https://outreach.engineering.utoronto.ca', logo: 'uoft2' },
  'TypeScript':                              { url: 'https://www.typescriptlang.org' },
  'Next.js':                                 { url: 'https://nextjs.org' },
  'React':                                   { url: 'https://react.dev' },
  'Flask':                                   { url: 'https://flask.palletsprojects.com' },
  'FastAPI':                                 { url: 'https://fastapi.tiangolo.com' },
  'TailwindCSS':                             { url: 'https://tailwindcss.com' },
  'Figma':                                   { url: 'https://www.figma.com' },
  'Python':                                  { url: 'https://www.python.org' },
  'PyTorch':                                 { url: 'https://pytorch.org' },
  'NumPy':                                   { url: 'https://numpy.org' },
  'Pandas':                                  { url: 'https://pandas.pydata.org' },
  'Jupyter docs tool':                       { url: 'https://github.com/Elrich-Chen/jupyterlab_docs_helper' },
  'MongoDB':                                 { url: 'https://www.mongodb.com' },
  'JavaScript':                              { url: 'https://developer.mozilla.org/en-US/docs/Web/JavaScript' },
  'PostgreSQL':                              { url: 'https://www.postgresql.org' },
  'SQLAlchemy':                              { url: 'https://www.sqlalchemy.org' },
  'JWT':                                     { url: 'https://jwt.io' },
  'Stanford Code In Place':                  { url: 'https://codeinplace.stanford.edu', logo: 'stanford' },
  "Queen's Sports Analytics Organization":  { url: 'https://www.instagram.com/p/DH4J-30SmkA/?img_index=6', logo: 'qsao' },
  'Chinese Lion Dancing':                    { url: 'https://www.chinadailyhk.com/hk/article/603804' },
  'Tech Plus UW':                            { url: 'https://www.techplusuw.com', logo: 'techplusuw' },
  'UW FinTech':                              { url: 'https://www.instagram.com/uwfintech/?hl=en', logo: 'fintech' },
  'UW Data Science':                         { url: 'https://www.uwdatascience.ca/', logo: 'uw_dsc' },
};

const logoOverrides: Record<string, string> = {
  'uw_cube': 'cube',
  'uw cube': 'cube',
};

function resolveLogoFileName(logoName: string) {
  const cleaned = String(logoName).trim().toLowerCase();
  const normalized = logoOverrides[cleaned] ?? cleaned.replace(/\s+/g, '-');
  return normalized.replace(/[^a-z0-9_-]/g, '');
}

function escapeHtml(value: string) {
  return value.replace(/[&<>"']/g, (char) => {
    const entities: Record<string, string> = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    };
    return entities[char] ?? char;
  });
}

function renderLogoImg(logoName: string, options: { width?: number; height?: number; className?: string; alt?: string } = {}) {
  const fileName = resolveLogoFileName(String(logoName).trim());
  if (!fileName) return '';
  const width = options.width ?? 20;
  const height = options.height ?? 20;
  const className = options.className ?? 'inline-block align-middle mx-1 logo-placeholder';
  const alt = options.alt ?? logoName;
  const pngSrc = `/logos/${fileName}.png`;
  const svgSrc = `/logos/${fileName}.svg`;

  return `<img src="${escapeHtml(pngSrc)}" data-logo-fallback-src="${escapeHtml(svgSrc)}" alt="${escapeHtml(String(alt))}" width="${width}" height="${height}" loading="lazy" class="${escapeHtml(className)}" />`;
}

function formatSummaryText(text: string) {
  const statPattern = /(\d+(?:\.\d+)?(?:st|nd|rd|th|[KMB%+]\+?))/gi;
  return toPlainLabel(text).replace(statPattern, '<strong><em>$1</em></strong>');
}

function formatStatsAndCompanies(text: string) {
  const statPattern = /(\d+(?:\.\d+)?(?:st|nd|rd|th|[KMB%+]\+?))/gi;
  let result = text.replace(statPattern, '<strong><em>$1</em></strong>');

  result = result.replace(
    /\[LINK:\s*([^\]]+?)\s*\](.+?)\[\/LINK\]/gi,
    '<a href="$1" class="company-link" target="_blank" rel="noopener noreferrer"><strong><em>$2</em></strong></a>'
  );

  result = result.replace(/\[IMAGE:\s*([^\]|]+?)(?:\|([^\]]+))?\s*\]/gi, (_, fileName, link) => {
    const safeName = String(fileName).trim().replace(/^\/+/, '');
    const src = safeName.startsWith('http') ? safeName : `/photos/elrich_photos/${safeName}`;
    if (link) {
      const href = String(link).trim();
      return `<a href="${href}" class="highlight-preview-link" target="_blank" rel="noopener noreferrer"><img src="${src}" alt="Preview" loading="lazy" class="highlight-preview" /></a>`;
    }
    return `<img src="${src}" alt="Preview" loading="lazy" class="highlight-preview" />`;
  });

  result = result.replace(/\[LOGO:([^\]]+)\]/gi, (_, logoName) => {
    return renderLogoImg(String(logoName).trim());
  });

  const companyKeys = Object.keys(companyData).sort((a, b) => b.length - a.length);
  const companyMap  = new Map(companyKeys.map((k) => [k.toLowerCase(), k]));
  const companyPattern = new RegExp(
    `(${companyKeys.map((k) => k.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`,
    'gi'
  );

  const tokens = result.split(/(<[^>]+>)/g);
  let insideAnchor = false;
  const rebuilt: string[] = [];

  for (const token of tokens) {
    if (/^<a\b/i.test(token))  { insideAnchor = true;  rebuilt.push(token); continue; }
    if (/^<\/a/i.test(token))  { insideAnchor = false; rebuilt.push(token); continue; }
    if (token.startsWith('<') || insideAnchor) { rebuilt.push(token); continue; }
    rebuilt.push(token.replace(companyPattern, (match) => {
      const key  = companyMap.get(match.toLowerCase());
      if (!key) return match;
      const data = companyData[key];
      return `<a href="${data.url}" target="_blank" rel="noopener" class="company-link"><strong><em>${match}</em></strong></a>`;
    }));
  }
  result = rebuilt.join('');
  result = result.replace(/View project\s*→/gi, '<a href="/projects" class="view-project-link">View project →</a>');
  return result;
}

// Contact links used in both connect sections
const contactLinks = [
  { href: 'mailto:elrichchen123@gmail.com', label: 'Email',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zm0 2v.01L12 13l8-5.99V7H4z"/></svg>` },
  { href: 'https://github.com/Elrich-Chen', label: 'GitHub',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>` },
  { href: 'https://linkedin.com/in/elrichchen', label: 'LinkedIn',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 23.2 24 22.222 0h.003z"/></svg>` },
  { href: 'https://x.com/ChenElrich_', label: 'X',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>` },
];
---

<Base title="Elrich Chen" description="CS @ UWaterloo | AI automations for DoneMaker | Aspiring Backend Engineer" fullscreen={true} homeLoading={true}>

  <!-- One WebGL ASCII layer for the whole page (fixed); Grainient stays underneath -->
  <HeroAsciiBackdrop videoSrc="/videos/po.mp4" />

  <div class="home-ascii-first-screen">
    <section id="section-hero" class="hero-atop-ascii-section" aria-label="Introduction">
      <div class="hero-atop-inner">
        <h1 class="hero-name">Elrich Chen</h1>
        <div class="hero-tagline">
          <a href="https://uwaterloo.ca/future-students/programs/computer-science" target="_blank" rel="noopener noreferrer" class="tagline-link">CS @ UWaterloo</a>
          <span class="tagline-dot">·</span>
          <span class="tagline-plain">Builder</span>
          <span class="tagline-dot">·</span>
          <a href="https://www.ycombinator.com/companies/medme-health" target="_blank" rel="noopener noreferrer" class="tagline-link">SWE @ MedMe Health (YC W21)</a>
        </div>
        <div class="hero-scroll-hint" aria-hidden="true">
          <span class="hint-label">scroll</span>
          <span class="hint-arrow">↓</span>
        </div>
      </div>
    </section>
  </div>

  <!-- ── BODY: stacked transparent cards ──────────────────────────────────── -->
  <ScrollStack itemDistance={44} itemStackDistance={12}>

    {highlights?.data?.what_makes_me_different?.length > 0 && (
      <div class="scroll-stack-card" id="section-recent">
        <div class="home-card-intro">
          <p class="card-kicker">{cardMeta.recent.kicker}</p>
          <h2 class="panel-header">{cardMeta.recent.title}</h2>
          <p class="card-subtitle">{cardMeta.recent.subtitle}</p>
        </div>
        <ul class="highlight-list">
          {highlights.data.what_makes_me_different.map((item: any) => {
            const mainPoint = typeof item === 'string' ? item : (item.point || '');
            const subPoints: string[] = typeof item === 'string' ? [] : (item.details || []);
            const parts = mainPoint.split(/\[LOGO:([^\]]+)\]/g);
            const plainLabel = toPlainLabel(mainPoint);
            return (
              <li class="highlight-item-group">
                {subPoints.length > 0 ? (
                  <details class="highlight-details" data-highlight-section="recent" data-highlight-label={plainLabel}>
                    <summary class="highlight-summary">
                      <span class="highlight-main-point">
                        {parts.map((part: string, i: number) => {
                          if (i % 2 === 1) {
                            return <span set:html={renderLogoImg(part)}></span>;
                          }
                          return <span set:html={formatSummaryText(part)}></span>;
                        })}
                      </span>
                      <span class="details-cue details-cue--chevron" aria-hidden="true">
                        <svg class="highlight-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    </summary>
                    <div class="highlight-details-body">
                      <p class="highlight-expanded-main" set:html={formatStatsAndCompanies(mainPoint)}></p>
                      <ul class="highlight-sub-points">
                        {subPoints.map((sub: string) => (
                          <li class="highlight-sub-item" set:html={formatStatsAndCompanies(sub)}></li>
                        ))}
                      </ul>
                    </div>
                  </details>
                ) : (
                  <div class="highlight-row highlight-row--no-bullet">
                    <div class="highlight-main-point">
                      {parts.map((part: string, i: number) => {
                        if (i % 2 === 1) {
                          return <span set:html={renderLogoImg(part)}></span>;
                        }
                        return <span set:html={formatStatsAndCompanies(part)}></span>;
                      })}
                    </div>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    )}

    {highlights?.data?.building?.length > 0 && (
      <div class="scroll-stack-card" id="section-building">
        <div class="home-card-intro">
          <p class="card-kicker">{cardMeta.building.kicker}</p>
          <h2 class="panel-header">{cardMeta.building.title}</h2>
          <p class="card-subtitle">{cardMeta.building.subtitle}</p>
        </div>
        <ul class="highlight-list">
          {highlights.data.building.map((item: any) => {
            const mainPoint = typeof item === 'string' ? item : (item.point || '');
            let subPoints: string[] = typeof item === 'string' ? [] : (item.details || []);
            if (mainPoint.includes('TechPlus UW')) {
              subPoints = ["Organised mentorship & dinner for <strong><em>200+</em></strong> members for the F25 term.", ...subPoints];
            }
            const parts = mainPoint.split(/\[LOGO:([^\]]+)\]/g);
            const plainLabel = toPlainLabel(mainPoint);
            return (
              <li class="highlight-item-group">
                {subPoints.length > 0 ? (
                  <details class="highlight-details" data-highlight-section="building" data-highlight-label={plainLabel}>
                    <summary class="highlight-summary">
                      <span class="highlight-main-point">
                        {parts.map((part: string, i: number) => {
                          if (i % 2 === 1) {
                            return <span set:html={renderLogoImg(part)}></span>;
                          }
                          return <span set:html={formatSummaryText(part)}></span>;
                        })}
                      </span>
                      <span class="details-cue details-cue--chevron" aria-hidden="true">
                        <svg class="highlight-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    </summary>
                    <div class="highlight-details-body">
                      <p class="highlight-expanded-main" set:html={formatStatsAndCompanies(mainPoint)}></p>
                      <ul class="highlight-sub-points">
                        {subPoints.map((sub: string) => (
                          <li class="highlight-sub-item" set:html={formatStatsAndCompanies(sub)}></li>
                        ))}
                      </ul>
                    </div>
                  </details>
                ) : (
                  <div class="highlight-row highlight-row--no-bullet">
                    <div class="highlight-main-point">
                      {parts.map((part: string, i: number) => {
                        if (i % 2 === 1) {
                          return <span set:html={renderLogoImg(part)}></span>;
                        }
                        return <span set:html={formatStatsAndCompanies(part)}></span>;
                      })}
                    </div>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    )}

    {testimonials.length > 0 && (
      <div class="scroll-stack-card" id="section-clients">
        <div class="home-card-intro">
          <p class="card-kicker">{cardMeta.clients.kicker}</p>
          <h2 class="panel-header">{cardMeta.clients.title}</h2>
          <p class="card-subtitle">{cardMeta.clients.subtitle}</p>
        </div>
        <div class="proof-grid">
          {testimonials.map((t) => (
            <details class="proof-card" data-testimonial-company={t.data.company} data-testimonial-project={t.data.project || 'unspecified'}>
              <summary class="proof-summary">
                <span class="proof-topline">
                  {t.data.companyLogo && (
                    <span set:html={renderLogoImg(t.data.companyLogo, { width: 28, height: 28, className: 'proof-logo', alt: '' })}></span>
                  )}
                  <span>
                    {t.data.project && <span class="proof-project">{t.data.project}</span>}
                    <span class="proof-company">{t.data.company}</span>
                  </span>
                </span>
                <span class="proof-meta">
                  <span aria-label={`${t.data.rating} out of 5 stars`}>
                    <span aria-hidden="true">{'★'.repeat(t.data.rating)}</span>
                  </span>
                  <span class="details-cue details-cue--chevron" aria-hidden="true">
                    <svg class="highlight-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </span>
              </summary>
              <div class="proof-body">
                <p class="quote-text">"{t.data.text}"</p>
                <p class="quote-author">— {t.data.author}, {t.data.title} · {t.data.company}</p>
                {t.data.techStack && t.data.techStack.length > 0 && (
                  <div class="tech-chips" aria-label={`Tech stack for ${t.data.project || t.data.company}`}>
                    {t.data.techStack.map((tech) => <span>{tech}</span>)}
                  </div>
                )}
              </div>
            </details>
          ))}
        </div>
      </div>
    )}

  </ScrollStack>

  <!-- ── LET'S CONNECT — standalone footer section ─────────────────────────── -->
  <section id="section-connect1" class="connect-section">
    <p class="contact-eyebrow">◆ Email</p>
    <h2 class="contact-heading">Let's connect.</h2>
    <p class="contact-body">
      Reach me directly at
      <a href="mailto:elrichchen123@gmail.com" class="contact-inline-link">elrichchen123@gmail.com</a>.
    </p>
    <a href="mailto:elrichchen123@gmail.com" class="contact-cta">Send an email</a>
    <div class="contact-icons">
      {contactLinks.map((link) => (
        <a
          href={link.href}
          aria-label={link.label}
          class="contact-icon"
          target={link.href.startsWith('mailto:') ? undefined : '_blank'}
          rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
        >
          <span class="contact-icon-svg" set:html={link.icon}></span>
        </a>
      ))}
    </div>
  </section>

  <script is:inline>
  document.addEventListener('error', (event) => {
    const el = event.target;
    if (!(el instanceof HTMLImageElement)) return;
    const fallbackSrc = el.dataset.logoFallbackSrc;
    if (!fallbackSrc) return;
    if (el.dataset.logoFallbackAttempted === 'true') {
      el.style.display = 'none';
      return;
    }
    el.dataset.logoFallbackAttempted = 'true';
    el.src = fallbackSrc;
  }, true);

    document.addEventListener('DOMContentLoaded', () => {
      // Track email CTA clicks (primary conversion event)
      document.querySelectorAll('a[href^="mailto:"]').forEach((el) => {
        el.addEventListener('click', () => {
          if (el.classList.contains('home-card-cta')) return;
          window.posthog?.capture('contact_email_clicked', {
            location: el.classList.contains('contact-cta') ? 'cta_button' : el.classList.contains('contact-icon') ? 'icon' : 'inline_link'
          });
        });
      });

      // Track social icon clicks
      document.querySelectorAll('.contact-icon').forEach((el) => {
        const href = el.getAttribute('href') || '';
        const label = el.getAttribute('aria-label') || 'unknown';
        if (href.startsWith('mailto:') || label.toLowerCase() === 'email') return;
        el.addEventListener('click', () => {
          window.posthog?.capture('social_link_clicked', {
            platform: label
          });
        });
      });

      document.querySelectorAll('.home-card-cta').forEach((el) => {
        el.addEventListener('click', () => {
          window.posthog?.capture('home_card_cta_clicked', {
            card_id: el.getAttribute('data-card-id') || 'unknown',
            label: el.getAttribute('data-cta-label') || el.textContent?.trim() || 'unknown',
            href: el.getAttribute('href') || ''
          });
        });
      });

      document.querySelectorAll('.highlight-details').forEach((el) => {
        el.addEventListener('toggle', () => {
          if (!(el instanceof HTMLDetailsElement) || !el.open) return;
          window.posthog?.capture('home_highlight_expanded', {
            section: el.getAttribute('data-highlight-section') || 'unknown',
            item_label: el.getAttribute('data-highlight-label') || 'unknown'
          });
        });
      });

      document.querySelectorAll('.proof-card').forEach((el) => {
        el.addEventListener('toggle', () => {
          if (!(el instanceof HTMLDetailsElement) || !el.open) return;
          window.posthog?.capture('home_testimonial_expanded', {
            company: el.getAttribute('data-testimonial-company') || 'unknown',
            project: el.getAttribute('data-testimonial-project') || 'unspecified'
          });
        });
      });

      const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
      const easeOutExpo = 'cubic-bezier(0.22, 1, 0.36, 1)';
      const openMs = 560;
      const closeMs = 480;

      const stripInlineHeight = (body) => {
        body.style.transition = '';
        body.style.height = '';
        body.style.opacity = '';
        body.style.overflow = '';
      };

      const smoothToggle = (el, body, summary) => {
        if (prefersReducedMotion) return;
        if (el.dataset.smoothToggle === 'attached') return;
        el.dataset.smoothToggle = 'attached';

        if (el.open) el.classList.add('is-open');

        summary.addEventListener('click', (event) => {
          event.preventDefault();
          if (el.dataset.animating === 'true') return;

          const opening = !el.open;
          el.dataset.animating = 'true';

          if (opening) {
            el.open = true;
            el.classList.add('is-open');
            const target = body.scrollHeight;
            body.style.overflow = 'hidden';
            body.style.height = '0px';
            body.style.opacity = '0';
            requestAnimationFrame(() => {
              body.style.transition =
                `height ${openMs}ms ${easeOutExpo}, opacity ${openMs - 80}ms ease`;
              body.style.height = target + 'px';
              body.style.opacity = '1';
            });
            const onEnd = (ev) => {
              if (ev.propertyName !== 'height') return;
              body.removeEventListener('transitionend', onEnd);
              stripInlineHeight(body);
              el.dataset.animating = 'false';
            };
            body.addEventListener('transitionend', onEnd);
          } else {
            const start = body.scrollHeight;
            body.style.overflow = 'hidden';
            body.style.height = start + 'px';
            body.style.opacity = '1';
            el.classList.remove('is-open');
            requestAnimationFrame(() => {
              body.style.transition =
                `height ${closeMs}ms ${easeOutExpo}, opacity ${closeMs - 80}ms ease`;
              body.style.height = '0px';
              body.style.opacity = '0';
            });
            const onEnd = (ev) => {
              if (ev.propertyName !== 'height') return;
              body.removeEventListener('transitionend', onEnd);
              el.open = false;
              stripInlineHeight(body);
              el.dataset.animating = 'false';
            };
            body.addEventListener('transitionend', onEnd);
          }
        });
      };

      document.querySelectorAll('.highlight-details').forEach((el) => {
        if (!(el instanceof HTMLDetailsElement)) return;
        const body = el.querySelector(':scope > .highlight-details-body');
        const summary = el.querySelector(':scope > summary');
        if (body instanceof HTMLElement && summary instanceof HTMLElement) {
          smoothToggle(el, body, summary);
        }
      });

      document.querySelectorAll('.proof-card').forEach((el) => {
        if (!(el instanceof HTMLDetailsElement)) return;
        const body = el.querySelector(':scope > .proof-body');
        const summary = el.querySelector(':scope > summary');
        if (body instanceof HTMLElement && summary instanceof HTMLElement) {
          smoothToggle(el, body, summary);
        }
      });

    });
  </script>

