---
import Base from '../layouts/Base.astro';
import HeroAsciiBackdrop from '../components/HeroAsciiBackdrop.astro';
import MagicBentoGrid from '../components/MagicBentoGrid.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

// Sort projects: order first, then featured, then by year (newest first)
const sortedProjects = projects.sort((a, b) => {
  const orderA = a.data.order ?? 999;
  const orderB = b.data.order ?? 999;
  if (orderA !== orderB) return orderA - orderB;

  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;

  const yearA = parseInt(a.data.year) || 0;
  const yearB = parseInt(b.data.year) || 0;
  return yearB - yearA;
});
---

<Base title="Projects – Elrich Chen">
  <HeroAsciiBackdrop videoSrc="/videos/closepo.mp4" />
  <div class="projects-content-shell">
    <div class="mb-6">
      <a href="/" class="back-home-link">← Back to home</a>
    </div>
    <h1 class="page-title text-xl font-semibold mb-8">Projects</h1>

    <div class="projects-container pb-24">
      <MagicBentoGrid
        glowColor="90, 138, 232"
        enableBorderGlow={true}
        enableSpotlight={true}
        enableStars={true}
        enableTilt={false}
        enableMagnetism={true}
        clickEffect={true}
        spotlightRadius={360}
        particleCount={12}
      >
      <div class="projects-grid">
        {sortedProjects.map((p, index) => {
        const highlights = p.data.highlights ?? [];
        const visibleHighlightCount = p.data.featured ? 3 : 2;
        const visibleHighlights = highlights.slice(0, visibleHighlightCount);
        const hiddenHighlights = highlights.slice(visibleHighlightCount);
        const categoryLabel = p.data.category ?? 'Project';

        return (
          <article class={`project-card ${p.data.featured ? 'featured' : ''} ${p.data.wide ? 'wide' : ''} ${index % 7 === 2 ? 'accent-wide' : ''} ${index % 7 === 5 ? 'accent-tall' : ''}`}>
            {p.data.wide && p.data.image && (
              <div class="card-hero">
                <img
                  src={p.data.image}
                  alt={p.data.name}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="card-content">
              <div class="card-eyebrow" aria-label="Project details">
                <span class="eyebrow-category">{categoryLabel}</span>
                {p.data.year && <span class="eyebrow-item">{p.data.year}</span>}
                {p.data.deployed && <span class="status-badge">Live</span>}
              </div>

              <div class="card-header">
                <div class="title-wrapper">
                  <div class="title-row">
                    {!p.data.wide && p.data.image && (
                      <div class="card-icon">
                        <img
                          src={p.data.image}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    )}
                    <h3 class="card-title">{p.data.name}</h3>
                  </div>
                </div>
                {p.data.href && (
                  <a
                    href={p.data.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="icon-link project-cta"
                    aria-label={`Open ${p.data.name} project`}
                  >
                    <span>View project</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                    </svg>
                  </a>
                )}
              </div>

              {p.data.tagline && (
                <p class="card-tagline">{p.data.tagline}</p>
              )}

              {highlights.length > 0 && (
                <div class="highlights-block">
                  <ul class="card-highlights">
                    {visibleHighlights.map((highlight: string) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>

                  {hiddenHighlights.length > 0 && (
                    <details class="card-details">
                      <summary class="card-details-summary">
                        <span class="summary-collapsed">Show {hiddenHighlights.length} more detail{hiddenHighlights.length === 1 ? '' : 's'}</span>
                        <span class="summary-open">Show fewer details</span>
                      </summary>
                      <ul class="card-highlights expanded">
                        {hiddenHighlights.map((highlight: string) => (
                          <li>{highlight}</li>
                        ))}
                      </ul>
                    </details>
                  )}
                </div>
              )}

              {(p.data.role || p.data.duration) && (
                <div class="card-meta">
                  {p.data.role && (
                    <span class="meta-item">
                      <span class="meta-label">Role</span>
                      <span>{p.data.role}</span>
                    </span>
                  )}
                  {p.data.duration && (
                    <span class="meta-item">
                      <span class="meta-label">Timeline</span>
                      <span>{p.data.duration}</span>
                    </span>
                  )}
                </div>
              )}

              {p.data.tags && p.data.tags.length > 0 && (
                <div class="card-tags" aria-label={`${p.data.name} technologies`}>
                  {p.data.tags.map((tag: string) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </article>
        );
        })}
      </div>
      </MagicBentoGrid>
    </div>
  </div>
</Base>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.icon-link').forEach((el) => {
      el.addEventListener('click', () => {
        const card = el.closest('article');
        const projectName = card?.querySelector('.card-title')?.textContent?.trim() || 'unknown';
        window.posthog?.capture('project_link_clicked', {
          project_name: projectName,
          href: el.getAttribute('href') || ''
        });
      });
    });
  });
</script>

<style>
  .projects-content-shell {
    position: relative;
    z-index: 3;
  }

  .projects-container {
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
  }

  .page-title {
    color: rgb(var(--fg));
  }

  :global(html.light) .page-title {
    color: #ffffff;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    grid-auto-flow: row;
    align-items: stretch;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (min-width: 1200px) {
    .projects-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.75rem;
    }
  }

  @media (max-width: 767px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .project-card.wide {
      grid-column: span 1;
    }
  }

  .project-card {
    position: relative;
    --card-surface: rgba(255, 255, 255, 0.78);
    --card-surface-strong: rgba(255, 255, 255, 0.92);
    --card-fg: rgb(var(--fg));
    --card-muted: rgba(var(--fg), 0.68);
    --card-subtle: rgba(var(--fg), 0.54);
    --card-border: rgba(var(--border), 0.12);
    --card-border-strong: rgba(var(--border), 0.2);
    --card-accent: #2563eb;
    --card-accent-soft: rgba(37, 99, 235, 0.1);
    --card-badge-bg: rgba(37, 99, 235, 0.12);
    --card-shadow: 0 18px 45px rgba(15, 23, 42, 0.1);
    background:
      linear-gradient(145deg, var(--card-surface-strong), var(--card-surface)),
      radial-gradient(circle at 18% 0%, var(--card-accent-soft), transparent 34%);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    overflow: hidden;
    transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    color: var(--card-fg);
    backdrop-filter: blur(18px);
  }

  .project-card.wide {
    grid-column: span 1;
  }

  .project-card.accent-wide,
  .project-card.featured,
  .project-card.wide {
    grid-column: span 1;
  }

  .project-card.accent-tall,
  .project-card.featured {
    grid-row: span 1;
  }

  @media (min-width: 768px) {
    .project-card.wide,
    .project-card.accent-wide,
    .project-card.featured {
      grid-column: span 2;
    }
  }

  @media (min-width: 1200px) {
    .project-card.wide,
    .project-card.accent-wide {
      grid-column: span 2;
    }

    .project-card.featured {
      grid-column: span 2;
      grid-row: span 2;
    }

    .project-card.accent-tall {
      grid-row: span 2;
    }
  }

  @media (prefers-color-scheme: dark) {
    .project-card {
      --card-surface: rgba(17, 24, 39, 0.72);
      --card-surface-strong: rgba(10, 10, 10, 0.82);
      --card-fg: rgba(255, 255, 255, 0.95);
      --card-muted: rgba(255, 255, 255, 0.74);
      --card-subtle: rgba(255, 255, 255, 0.58);
      --card-border: rgba(255, 255, 255, 0.18);
      --card-border-strong: rgba(255, 255, 255, 0.3);
      --card-accent: #8ab4ff;
      --card-accent-soft: rgba(90, 138, 232, 0.18);
      --card-badge-bg: rgba(90, 138, 232, 0.18);
      --card-shadow: 0 18px 45px rgba(0, 0, 0, 0.34);
    }
  }

  :global(html.light) .project-card {
    --card-surface: rgba(255, 255, 255, 0.78);
    --card-surface-strong: rgba(255, 255, 255, 0.92);
    --card-fg: rgb(var(--fg));
    --card-muted: rgba(var(--fg), 0.68);
    --card-subtle: rgba(var(--fg), 0.54);
    --card-border: rgba(var(--border), 0.12);
    --card-border-strong: rgba(var(--border), 0.2);
    --card-accent: #2563eb;
    --card-accent-soft: rgba(37, 99, 235, 0.1);
    --card-badge-bg: rgba(37, 99, 235, 0.12);
    --card-shadow: 0 18px 45px rgba(15, 23, 42, 0.1);
  }

  :global(html.dark) .project-card {
    --card-surface: rgba(17, 24, 39, 0.72);
    --card-surface-strong: rgba(10, 10, 10, 0.82);
    --card-fg: rgba(255, 255, 255, 0.95);
    --card-muted: rgba(255, 255, 255, 0.74);
    --card-subtle: rgba(255, 255, 255, 0.58);
    --card-border: rgba(255, 255, 255, 0.18);
    --card-border-strong: rgba(255, 255, 255, 0.3);
    --card-accent: #8ab4ff;
    --card-accent-soft: rgba(90, 138, 232, 0.18);
    --card-badge-bg: rgba(90, 138, 232, 0.18);
    --card-shadow: 0 18px 45px rgba(0, 0, 0, 0.34);
  }

  .project-card:hover {
    box-shadow: 0 20px 54px rgba(37, 99, 235, 0.16);
    border-color: var(--card-border-strong);
  }

  :global(html.dark) .project-card:hover {
    box-shadow: 0 8px 28px rgba(90, 138, 232, 0.25);
  }

  .project-card.featured {
    --card-accent: #1d4ed8;
    --card-accent-soft: rgba(37, 99, 235, 0.14);
    border-color: rgba(37, 99, 235, 0.28);
    box-shadow: 0 22px 60px rgba(37, 99, 235, 0.16);
  }

  @media (prefers-color-scheme: dark) {
    .project-card.featured {
      --card-accent: #8ab4ff;
      --card-accent-soft: rgba(90, 138, 232, 0.22);
      border-color: rgba(90, 138, 232, 0.34);
    }
  }

  :global(html.light) .project-card.featured {
    --card-accent: #1d4ed8;
    --card-accent-soft: rgba(37, 99, 235, 0.14);
    border-color: rgba(37, 99, 235, 0.28);
  }

  :global(html.dark) .project-card.featured {
    --card-accent: #8ab4ff;
    --card-accent-soft: rgba(90, 138, 232, 0.22);
    border-color: rgba(90, 138, 232, 0.34);
  }

  .project-card.featured:hover {
    border-color: rgba(37, 99, 235, 0.42);
    box-shadow: 0 26px 70px rgba(37, 99, 235, 0.24);
  }

  /* Card Content */
  .card-content {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex: 1;
  }

  .card-hero {
    width: 100%;
    height: 240px;
    overflow: hidden;
    background: rgba(var(--border), 0.04);
    border-bottom: 1px solid var(--card-border);
  }

  .card-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: var(--card-subtle);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow-category,
  .eyebrow-item,
  .status-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.45rem;
  }

  .eyebrow-category {
    color: var(--card-accent);
  }

  .eyebrow-item::before {
    content: '';
    width: 4px;
    height: 4px;
    margin-right: 0.45rem;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.45;
  }

  .status-badge {
    padding: 0.12rem 0.48rem;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
    border-radius: 999px;
    box-shadow: 0 8px 18px rgba(16, 185, 129, 0.2);
  }

  /* Card Header */
  .card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .title-wrapper {
    flex: 1 1 12rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .card-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--card-badge-bg);
    border: 1px solid var(--card-border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .card-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-title {
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--card-fg);
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  @media (min-width: 768px) {
    .project-card.featured .card-content {
      padding: 1.35rem;
      gap: 1rem;
    }

    .project-card.featured .card-title {
      font-size: 1.35rem;
    }

    .project-card.featured .card-tagline {
      font-size: 1.06rem;
    }
  }

  .icon-link {
    min-height: 40px;
    max-width: 100%;
    border-radius: 999px;
    background: var(--card-accent);
    border: 1px solid transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    color: white;
    flex: 0 0 auto;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.55rem 0.8rem;
    white-space: nowrap;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    text-decoration: none;
  }

  .icon-link:hover {
    background: transparent;
    border-color: var(--card-accent);
    color: var(--card-accent);
    transform: translateY(-2px);
  }

  /* Tagline */
  .card-tagline {
    font-size: 1rem;
    color: var(--card-muted);
    font-weight: 500;
    line-height: 1.5;
    margin: 0;
  }

  /* Tech Tags */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding-top: 0.2rem;
  }

  .tag-pill {
    display: inline-block;
    padding: 0.24rem 0.55rem;
    background: var(--card-badge-bg);
    border: 1px solid var(--card-border);
    color: var(--card-muted);
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: all 0.2s ease;
  }

  .tag-pill:hover {
    background: var(--card-accent-soft);
    color: var(--card-accent);
    border-color: rgba(37, 99, 235, 0.24);
  }

  /* Highlights */
  .highlights-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem;
    background: rgba(var(--border), 0.035);
    border: 1px solid var(--card-border);
    border-radius: 14px;
  }

  :global(html.dark) .highlights-block {
    background: rgba(255, 255, 255, 0.04);
  }

  .card-highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .card-details {
    display: block;
  }

  .card-details-summary {
    cursor: pointer;
    list-style: none;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--card-accent);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    width: fit-content;
    min-height: 44px;
    padding: 0.2rem 0;
    border-bottom: 1px solid currentColor;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .card-details-summary:hover {
    color: var(--card-fg);
  }

  .card-details-summary::-webkit-details-marker {
    display: none;
  }

  .card-details-summary::marker {
    content: '';
  }

  .card-details .card-highlights {
    margin-top: 0.15rem;
  }

  .summary-open {
    display: none;
  }

  .card-details[open] .summary-open {
    display: inline;
  }

  .card-details[open] .summary-collapsed {
    display: none;
  }

  .card-highlights li {
    font-size: 0.92rem;
    color: var(--card-fg);
    line-height: 1.5;
    padding-left: 1rem;
    position: relative;
  }

  .card-highlights li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--card-accent);
    font-weight: 600;
  }

  /* Metadata */
  .card-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.55rem;
    font-size: 0.82rem;
    color: var(--card-muted);
    padding-top: 0.1rem;
    margin-top: auto;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.55rem 0.65rem;
    background: rgba(var(--border), 0.035);
    border: 1px solid var(--card-border);
    border-radius: 12px;
  }

  .meta-label {
    color: var(--card-subtle);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 480px) {
    .projects-container {
      padding-inline: 0.1rem;
    }

    .projects-grid {
      gap: 1rem;
    }

    .project-card {
      border-radius: 14px;
    }

    .card-content {
      padding: 0.9rem;
      gap: 0.65rem;
    }

    .card-hero {
      height: 190px;
    }

    .card-header {
      gap: 0.7rem;
      align-items: stretch;
      flex-direction: column;
    }

    .title-row {
      gap: 0.45rem;
      align-items: flex-start;
    }

    .card-title {
      font-size: 1.05rem;
      line-height: 1.35;
    }

    .card-tagline {
      font-size: 0.96rem;
      line-height: 1.5;
    }

    .tag-pill {
      font-size: 0.72rem;
      padding: 0.26rem 0.5rem;
    }

    .card-highlights li {
      font-size: 0.9rem;
      line-height: 1.45;
      padding-left: 1rem;
    }

    .card-details-summary {
      min-height: 44px;
      font-size: 0.88rem;
      border-bottom-color: currentColor;
    }

    .icon-link {
      width: fit-content;
      min-height: 40px;
      border-radius: 999px;
      padding-inline: 0.85rem;
      align-self: flex-start;
    }

    .icon-link svg {
      width: 19px;
      height: 19px;
    }

    .card-meta {
      gap: 0.45rem;
      font-size: 0.8rem;
      padding-top: 0.35rem;
    }
  }
</style>
