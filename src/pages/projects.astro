---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

// Sort projects: order first, then featured, then by year (newest first)
const sortedProjects = projects.sort((a, b) => {
  const orderA = a.data.order ?? 999;
  const orderB = b.data.order ?? 999;
  if (orderA !== orderB) return orderA - orderB;

  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;

  const yearA = parseInt(a.data.year) || 0;
  const yearB = parseInt(b.data.year) || 0;
  return yearB - yearA;
});

const featuredProjects = sortedProjects.filter((p) => p.data.featured === true);
const carouselProjects = sortedProjects.filter((p) => p.data.featured !== true);

const allProjects = [...featuredProjects, ...carouselProjects];

const slugify = (label: string) =>
  label
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '') || 'other';

const categoryOf = (p: (typeof allProjects)[number]) => p.data.category ?? 'Other';

const orderedCategories = Array.from(
  new Set(allProjects.map(categoryOf))
);
const filters: { label: string; slug: string; count: number }[] = [
  { label: 'All', slug: 'all', count: allProjects.length },
  ...orderedCategories.map((cat) => ({
    label: cat,
    slug: slugify(cat),
    count: allProjects.filter((p) => categoryOf(p) === cat).length,
  })),
];

const pad2 = (n: number) => n.toString().padStart(2, '0');
---

<Base title="Projects – Elrich Chen">
  <div class="projects-content-shell">
    <div class="mb-6">
      <a href="/" class="back-home-link">← Back to home</a>
    </div>

    <header class="projects-masthead">
      <p class="masthead-eyebrow">
        <span class="masthead-dot" aria-hidden="true"></span>
        Catalogue · {pad2(allProjects.length)} entries · {new Date().getFullYear()}
      </p>
      <h1 class="masthead-title">Projects<span class="masthead-stop">.</span></h1>
      <p class="masthead-lede">
        A working archive of things I've shipped, broken, and shipped again. Hover to peek, tap to crack one open.
      </p>
    </header>

    <nav class="filter-rail" aria-label="Filter projects by category">
      <ul class="filter-chips" role="list">
        {filters.map((f) => (
          <li>
            <button
              type="button"
              class="filter-chip"
              data-filter={f.slug}
              aria-pressed={f.slug === 'all' ? 'true' : 'false'}
            >
              <span class="chip-label">{f.label}</span>
              <span class="chip-count">{pad2(f.count)}</span>
            </button>
          </li>
        ))}
      </ul>
    </nav>

    {featuredProjects.length > 0 && (
      <section class="spotlight-section" aria-label="Featured projects">
        <header class="section-rule">
          <span class="rule-marker">★</span>
          <span class="rule-label">Spotlight</span>
          <span class="rule-meta">{pad2(featuredProjects.length)} featured</span>
          <span class="rule-line" aria-hidden="true"></span>
        </header>

        <div class="spotlight-stage">
          {featuredProjects.map((p, idx) => {
          const highlights = p.data.highlights ?? [];
          const visibleHighlights = highlights.slice(0, 2);
          const hiddenHighlights = highlights.slice(2);
          const categoryLabel = p.data.category ?? 'Project';
          const slug = slugify(categoryLabel);
          const orientation = idx % 2 === 0 ? 'left' : 'right';

          return (
            <article
              class={`spotlight-card spotlight-card--${orientation}`}
              data-category={slug}
              style={`--spot-delay: ${idx * 90}ms;`}
            >
              <div class="spotlight-image-frame">
                {p.data.image ? (
                  <img
                    src={p.data.image}
                    alt={p.data.name}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="spotlight-image-fallback" aria-hidden="true">
                    {p.data.name.slice(0, 2)}
                  </div>
                )}
                <span class="spotlight-index" aria-hidden="true">{pad2(idx + 1)}</span>
                {p.data.deployed && (
                  <span class="status-pulse" aria-label="Live in production">
                    <span class="status-dot"></span>Live
                  </span>
                )}
              </div>

              <div class="spotlight-body">
                <p class="spotlight-eyebrow">
                  <span class="eyebrow-tick" aria-hidden="true">/</span>
                  {categoryLabel}
                </p>
                <h2 class="spotlight-title">{p.data.name}</h2>
                {p.data.tagline && <p class="spotlight-tagline">{p.data.tagline}</p>}

                {visibleHighlights.length > 0 && (
                  <ul class="spotlight-highlights">
                    {visibleHighlights.map((h: string) => <li>{h}</li>)}
                  </ul>
                )}

                {hiddenHighlights.length > 0 && (
                  <details class="spotlight-more">
                    <summary>
                      <span class="more-collapsed">+ {hiddenHighlights.length} more detail{hiddenHighlights.length === 1 ? '' : 's'}</span>
                      <span class="more-open">− show fewer</span>
                    </summary>
                    <ul class="spotlight-highlights">
                      {hiddenHighlights.map((h: string) => <li>{h}</li>)}
                    </ul>
                  </details>
                )}

                {p.data.tags && p.data.tags.length > 0 && (
                  <div class="meta-tags" aria-label={`${p.data.name} stack`}>
                    {p.data.tags.slice(0, 6).map((t: string) => <span class="meta-tag">{t}</span>)}
                  </div>
                )}

                <div class="spotlight-cta-row">
                  {p.data.duration && (
                    <span class="spotlight-duration">
                      <span class="duration-label">Timeline</span>
                      <span class="duration-value">{p.data.duration}</span>
                    </span>
                  )}
                  {p.data.href && (
                    <a
                      href={p.data.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="icon-link spotlight-cta cursor-target"
                      aria-label={`Open ${p.data.name}`}
                    >
                      <span>View project</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                        <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
          })}
        </div>
      </section>
    )}

    {carouselProjects.length > 0 && (
      <section class="catalogue-section" aria-label="All other projects">
        <header class="section-rule">
          <span class="rule-marker">◇</span>
          <span class="rule-label">Catalogue</span>
          <span class="rule-meta">{pad2(carouselProjects.length)} entries · click to expand</span>
          <span class="rule-line" aria-hidden="true"></span>
        </header>

        <div class="catalogue-grid" id="catalogue-grid">
          {carouselProjects.map((p, idx) => {
            const highlights = p.data.highlights ?? [];
            const visibleHighlights = highlights.slice(0, 2);
            const hiddenHighlights = highlights.slice(2);
            const categoryLabel = p.data.category ?? 'Project';
            const slug = slugify(categoryLabel);
            const overallIndex = featuredProjects.length + idx + 1;

            // Asymmetric span patterns rotate every 5 tiles
            const spanClass =
              idx % 5 === 0 ? 'tile--wide' :
              idx % 5 === 3 ? 'tile--tall' :
              '';
            const offsetClass = idx % 2 === 0 ? 'tile--offset-l' : 'tile--offset-r';

            return (
              <details
                class={`tile ${spanClass} ${offsetClass}`}
                data-category={slug}
                style={`--tile-delay: ${(idx % 4) * 70}ms;`}
              >
                <summary class="tile-summary">
                  <span class="tile-index" aria-hidden="true">{pad2(overallIndex)}</span>

                  <div class="tile-head">
                    <p class="tile-eyebrow">
                      {p.data.image && (
                        <span class="tile-icon" aria-hidden="true">
                          <img src={p.data.image} alt="" loading="lazy" decoding="async" />
                        </span>
                      )}
                      <span class="tile-eyebrow-label">{categoryLabel}</span>
                      {p.data.deployed && (
                        <span class="tile-live"><span class="status-dot"></span>Live</span>
                      )}
                    </p>
                    <h3 class="tile-title">{p.data.name}</h3>
                    {p.data.tagline && <p class="tile-tagline">{p.data.tagline}</p>}
                  </div>

                  {visibleHighlights.length > 0 && (
                    <ul class="tile-highlights">
                      {visibleHighlights.map((h: string) => <li>{h}</li>)}
                    </ul>
                  )}

                  <div class="tile-foot">
                    {p.data.tags && p.data.tags.length > 0 && (
                      <div class="tile-tags">
                        {p.data.tags.slice(0, 3).map((t: string) => (
                          <span class="meta-tag meta-tag--mini">{t}</span>
                        ))}
                        {p.data.tags.length > 3 && (
                          <span class="meta-tag meta-tag--mini meta-tag--ghost">+{p.data.tags.length - 3}</span>
                        )}
                      </div>
                    )}
                    <span class="tile-expand" aria-hidden="true">
                      <span class="tile-expand-text">
                        <span class="expand-when-closed">Expand</span>
                        <span class="expand-when-open">Collapse</span>
                      </span>
                      <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M3 6l5 4 5-4" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>
                </summary>

                <div class="tile-drawer">
                  {hiddenHighlights.length > 0 && (
                    <ul class="tile-highlights tile-highlights--extra">
                      {hiddenHighlights.map((h: string) => <li>{h}</li>)}
                    </ul>
                  )}

                  <dl class="tile-drawer-meta">
                    {p.data.duration && (
                      <div class="meta-row">
                        <dt>Timeline</dt>
                        <dd>{p.data.duration}</dd>
                      </div>
                    )}
                    {p.data.role && (
                      <div class="meta-row">
                        <dt>Role</dt>
                        <dd>{p.data.role}</dd>
                      </div>
                    )}
                    {p.data.year && (
                      <div class="meta-row">
                        <dt>Year</dt>
                        <dd>{p.data.year}</dd>
                      </div>
                    )}
                  </dl>

                  {p.data.tags && p.data.tags.length > 3 && (
                    <div class="tile-tags tile-tags--full">
                      {p.data.tags.map((t: string) => (
                        <span class="meta-tag meta-tag--mini">{t}</span>
                      ))}
                    </div>
                  )}

                  {p.data.href && (
                    <a
                      href={p.data.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="icon-link tile-cta cursor-target"
                      aria-label={`Open ${p.data.name}`}
                    >
                      <span>View project</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
                        <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  )}
                </div>
              </details>
            );
          })}
        </div>

        <p class="catalogue-empty" id="catalogue-empty" aria-live="polite" hidden>
          Nothing here under that filter — try another tag.
        </p>
      </section>
    )}
  </div>
</Base>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.icon-link').forEach((el) => {
      el.addEventListener('click', () => {
        const card = el.closest('article, details');
        const titleEl = card?.querySelector('.spotlight-title, .tile-title');
        const projectName = titleEl?.textContent?.trim() || 'unknown';
        window.posthog?.capture('project_link_clicked', {
          project_name: projectName,
          href: el.getAttribute('href') || ''
        });
      });
    });

    document.querySelectorAll('.tile').forEach((tile) => {
      tile.addEventListener('toggle', () => {
        if (!tile.open) return;
        const name = tile.querySelector('.tile-title')?.textContent?.trim() || 'unknown';
        window.posthog?.capture('project_card_expanded', { project_name: name });
      });
    });

    const chips = Array.from(document.querySelectorAll('.filter-chip'));
    const filterables = Array.from(document.querySelectorAll('[data-category]'));
    const emptyMsg = document.getElementById('catalogue-empty');

    const applyFilter = (filter) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', c.dataset.filter === filter ? 'true' : 'false'));
      filterables.forEach((el) => {
        const matches = filter === 'all' || el.dataset.category === filter;
        el.classList.toggle('is-hidden', !matches);
      });
      if (emptyMsg) {
        const gridVisible = document.querySelectorAll('#catalogue-grid .tile:not(.is-hidden)').length;
        const spotlightVisible = document.querySelectorAll('.spotlight-card:not(.is-hidden)').length;
        emptyMsg.hidden = (gridVisible + spotlightVisible) > 0;
      }
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const filter = chip.dataset.filter || 'all';
        applyFilter(filter);
        window.posthog?.capture('projects_filter_selected', { filter });
      });
    });

    // Pointer-driven tilt for spotlight cards (skip if reduced motion)
    const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePtr = window.matchMedia('(pointer: fine)').matches;
    if (motionOk && finePtr) {
      document.querySelectorAll('.spotlight-card').forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width;
          const py = (e.clientY - rect.top) / rect.height;
          const rx = (0.5 - py) * 4;
          const ry = (px - 0.5) * 6;
          card.style.setProperty('--rx', rx.toFixed(2) + 'deg');
          card.style.setProperty('--ry', ry.toFixed(2) + 'deg');
        });
        card.addEventListener('mouseleave', () => {
          card.style.setProperty('--rx', '0deg');
          card.style.setProperty('--ry', '0deg');
        });
      });
    }
  });
</script>

<style>
  /* ───────────────────────────────────────────────────────────────────────
     Layering — content sits above the fixed ASCII video (z-index 1) and
     the grainient (z-index var(--layer-bg)). We never paint an opaque
     ancestor at full width; cards are glassy so the backdrop bleeds through.
     ─────────────────────────────────────────────────────────────────── */
  .projects-content-shell {
    position: relative;
    z-index: 3;
    --ink: 245 245 245;
    --ink-soft: 230 232 240;
    --ink-dim: 160 168 184;
    --hairline: rgba(255, 255, 255, 0.14);
    --hairline-strong: rgba(255, 255, 255, 0.28);
    --glass: rgba(10, 12, 22, 0.52);
    --glass-strong: rgba(10, 12, 22, 0.66);
    --accent: #f7a76b;
    --accent-soft: rgba(247, 167, 107, 0.16);
    --accent-cool: #8cb6ff;
    --live: #4ade80;
    color: rgb(var(--ink));
  }

  /* ─── MASTHEAD ──────────────────────────────────────────────────────── */
  .projects-masthead {
    margin: 0 0 2rem;
    padding: 0 0 1.4rem;
    border-bottom: 1px solid var(--hairline);
    position: relative;
  }

  .masthead-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1rem;
    font-family: 'Rubik', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--ink-soft));
    opacity: 0.86;
  }

  .masthead-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft), 0 0 14px rgba(247, 167, 107, 0.55);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.55; transform: scale(0.78); }
  }

  .masthead-title {
    font-family: 'Syne', 'Rubik', sans-serif;
    font-size: clamp(2.6rem, 8.4vw, 5.5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.045em;
    margin: 0;
    color: #fff;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.45);
  }

  .masthead-stop {
    color: var(--accent);
    font-style: italic;
  }

  .masthead-lede {
    margin: 0.8rem 0 0;
    max-width: 36rem;
    font-size: clamp(0.88rem, 1.5vw, 1.02rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
  }

  /* ─── FILTER CHIPS ──────────────────────────────────────────────────── */
  .filter-rail {
    margin: 0 0 2.2rem;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .filter-rail::-webkit-scrollbar { display: none; }

  .filter-chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: inline-flex;
    align-items: stretch;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.42rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: var(--glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: rgba(255, 255, 255, 0.82);
    font-family: 'Rubik', sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease, transform 0.15s ease;
    white-space: nowrap;
  }

  .filter-chip:hover {
    color: #fff;
    border-color: var(--hairline-strong);
    transform: translateY(-1px);
  }

  .filter-chip[aria-pressed="true"] {
    color: #0c0c14;
    background: rgba(255, 255, 255, 0.94);
    border-color: rgba(255, 255, 255, 0.94);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
  }

  .chip-count {
    font-variant-numeric: tabular-nums;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.08rem 0.42rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.65);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .filter-chip[aria-pressed="true"] .chip-count {
    background: rgba(12, 12, 20, 0.12);
    color: #0c0c14;
  }

  /* ─── SECTION RULES ─────────────────────────────────────────────────── */
  .section-rule {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.1rem;
    font-family: 'Rubik', sans-serif;
    color: rgba(255, 255, 255, 0.72);
  }

  .rule-marker {
    color: var(--accent);
    font-size: 0.9rem;
    line-height: 1;
  }

  .rule-label {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #fff;
  }

  .rule-meta {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .rule-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--hairline), transparent);
  }

  /* ─── SPOTLIGHT STAGE ───────────────────────────────────────────────── */
  .spotlight-section {
    margin-bottom: 3rem;
  }

  .spotlight-stage {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .spotlight-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 0;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--glass-strong);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.35);
    transform-style: preserve-3d;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 0.3s ease,
                box-shadow 0.3s ease;
    transform: perspective(1100px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    will-change: transform;
    opacity: 0;
    animation: card-rise 0.7s cubic-bezier(0.2, 0.7, 0.1, 1) forwards;
    animation-delay: var(--spot-delay, 0ms);
  }

  @keyframes card-rise {
    0%   { opacity: 0; transform: perspective(1100px) translateY(18px) rotateX(0) rotateY(0); }
    100% { opacity: 1; transform: perspective(1100px) translateY(0)    rotateX(0) rotateY(0); }
  }

  .spotlight-card:hover {
    border-color: var(--hairline-strong);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45),
                0 0 0 1px rgba(247, 167, 107, 0.18);
  }

  /* Asymmetric offsets — pulls the card off-center so the ASCII video
     bleeds through opposite gutter at desktop widths. */
  @media (min-width: 1024px) {
    .spotlight-card--left  { margin-right: 3.5rem; }
    .spotlight-card--right { margin-left:  3.5rem; }
    .spotlight-card--right { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); }
    .spotlight-card--right .spotlight-image-frame { order: 2; }
    .spotlight-card--right .spotlight-body        { order: 1; }
  }

  .spotlight-image-frame {
    position: relative;
    min-height: 280px;
    background: linear-gradient(135deg, rgba(247, 167, 107, 0.12), rgba(140, 182, 255, 0.08));
    overflow: hidden;
  }

  .spotlight-image-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.45) 100%);
    pointer-events: none;
  }

  .spotlight-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.4s ease;
    filter: saturate(1.05) contrast(1.02);
  }

  .spotlight-card:hover .spotlight-image-frame img {
    transform: scale(1.045);
  }

  .spotlight-image-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-family: 'Syne', sans-serif;
    font-size: 4rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.34);
    text-transform: uppercase;
  }

  .spotlight-index {
    position: absolute;
    top: 0.85rem;
    left: 1rem;
    z-index: 2;
    font-family: 'Syne', sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #fff;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: rgba(8, 8, 14, 0.55);
    border: 1px solid var(--hairline);
    backdrop-filter: blur(6px);
  }

  .status-pulse {
    position: absolute;
    top: 0.85rem;
    right: 1rem;
