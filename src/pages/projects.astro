---
import Base from '../layouts/Base.astro';
import HeroAsciiBackdrop from '../components/HeroAsciiBackdrop.astro';
import MagicBentoGrid from '../components/MagicBentoGrid.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

// Sort projects: order first, then featured, then by year (newest first)
const sortedProjects = projects.sort((a, b) => {
  const orderA = a.data.order ?? 999;
  const orderB = b.data.order ?? 999;
  if (orderA !== orderB) return orderA - orderB;

  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;

  const yearA = parseInt(a.data.year) || 0;
  const yearB = parseInt(b.data.year) || 0;
  return yearB - yearA;
});

const featuredProjects = sortedProjects.filter((p) => p.data.featured === true);
const carouselProjects = sortedProjects.filter((p) => p.data.featured !== true);
---

<Base title="Projects – Elrich Chen">
  <HeroAsciiBackdrop videoSrc="/videos/closepo.mp4" />
  <div class="projects-content-shell">
    <div class="mb-6">
      <a href="/" class="back-home-link">← Back to home</a>
    </div>
    <h1 class="page-title text-base font-semibold mb-5">Projects</h1>

    <div class="projects-container pb-24">
      <MagicBentoGrid
        glowColor="90, 138, 232"
        enableBorderGlow={true}
        enableSpotlight={true}
        enableStars={true}
        enableTilt={false}
        enableMagnetism={true}
        clickEffect={true}
        spotlightRadius={360}
        particleCount={12}
      >
      <div class="featured-projects-grid">
        {featuredProjects.map((p, index) => {
        const highlights = p.data.highlights ?? [];
        const visibleHighlightCount = 2;
        const visibleHighlights = highlights.slice(0, visibleHighlightCount);
        const hiddenHighlights = highlights.slice(visibleHighlightCount);
        const categoryLabel = p.data.category ?? 'Project';
        const isHackathon =
          (p.data.tags?.some((t: string) => t.toLowerCase().trim() === 'hackathon') ?? false) ||
          (typeof p.data.category === 'string' && p.data.category.toLowerCase() === 'hackathons');

        return (
          <article class={`project-card ${p.data.featured ? 'featured' : ''} ${p.data.wide ? 'wide' : ''} ${index % 7 === 2 ? 'accent-wide' : ''} ${index % 7 === 5 ? 'accent-tall' : ''} ${isHackathon ? 'hackathon-card' : ''}`}>
            {p.data.wide && p.data.image && (
              <div class="card-hero">
                <img
                  src={p.data.image}
                  alt={p.data.name}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="card-content">
              <div class="card-eyebrow" aria-label="Project details">
                <span class="eyebrow-category">{categoryLabel}</span>
                {p.data.deployed && <span class="status-badge">Live</span>}
              </div>

              <div class="card-header">
                <div class="title-wrapper">
                  <div class="title-row">
                    {!p.data.wide && p.data.image && (
                      <div class="card-icon">
                        <img
                          src={p.data.image}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    )}
                    <h3 class="card-title">{p.data.name}</h3>
                  </div>
                </div>
                {p.data.href && (
                  <a
                    href={p.data.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="icon-link project-cta"
                    aria-label={`Open ${p.data.name} project`}
                  >
                    <span>View project</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                    </svg>
                  </a>
                )}
              </div>

              {p.data.tagline && (
                <p class="card-tagline">{p.data.tagline}</p>
              )}

              {highlights.length > 0 && (
                <div class="highlights-block">
                  <ul class="card-highlights">
                    {visibleHighlights.map((highlight: string) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>

                  {hiddenHighlights.length > 0 && (
                    <details class="card-details">
                      <summary class="card-details-summary">
                        <span class="summary-collapsed">Show {hiddenHighlights.length} more detail{hiddenHighlights.length === 1 ? '' : 's'}</span>
                        <span class="summary-open">Show fewer details</span>
                      </summary>
                      <ul class="card-highlights expanded">
                        {hiddenHighlights.map((highlight: string) => (
                          <li>{highlight}</li>
                        ))}
                      </ul>
                    </details>
                  )}
                </div>
              )}

              {p.data.duration && (
                <div class="card-meta">
                  <span class="meta-item">
                    <span class="meta-label">Timeline</span>
                    <span>{p.data.duration}</span>
                  </span>
                </div>
              )}

              {p.data.tags && p.data.tags.length > 0 && (
                <div class="card-tags" aria-label={`${p.data.name} technologies`}>
                  {p.data.tags.map((tag: string) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </article>
        );
        })}
      </div>
      </MagicBentoGrid>

      {carouselProjects.length > 0 && (
        <section class="projects-carousel-wrap" aria-label="Additional projects">
          <div
            class="projects-carousel"
            role="region"
            aria-roledescription="carousel"
            aria-label="More projects"
          >
            <button class="carousel-arrow carousel-arrow--prev" aria-label="Previous project" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button class="carousel-arrow carousel-arrow--next" aria-label="Next project" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
            <div class="carousel-viewport" tabindex="0">
              <div class="carousel-track" data-clone-count={Math.min(3, carouselProjects.length)}>
                {carouselProjects.map((p, index) => {
                const highlights = p.data.highlights ?? [];
                const visibleHighlightCount = p.data.featured ? 3 : 2;
                const visibleHighlights = highlights.slice(0, visibleHighlightCount);
                const hiddenHighlights = highlights.slice(visibleHighlightCount);
                const categoryLabel = p.data.category ?? 'Project';
                const isHackathon =
                  (p.data.tags?.some((t: string) => t.toLowerCase().trim() === 'hackathon') ?? false) ||
                  (typeof p.data.category === 'string' && p.data.category.toLowerCase() === 'hackathons');

                return (
                  <div class="carousel-slide" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${carouselProjects.length}`}>
                    <article class={`project-card ${p.data.featured ? 'featured' : ''} ${p.data.wide ? 'wide' : ''} ${index % 7 === 2 ? 'accent-wide' : ''} ${index % 7 === 5 ? 'accent-tall' : ''} ${isHackathon ? 'hackathon-card' : ''}`}>
                      {p.data.wide && p.data.image && (
                        <div class="card-hero">
                          <img
                            src={p.data.image}
                            alt={p.data.name}
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                      )}
                      <div class="card-content">
                        <div class="card-eyebrow" aria-label="Project details">
                          <span class="eyebrow-category">{categoryLabel}</span>
                          {p.data.deployed && <span class="status-badge">Live</span>}
                        </div>

                        <div class="card-header">
                          <div class="title-wrapper">
                            <div class="title-row">
                              {!p.data.wide && p.data.image && (
                                <div class="card-icon">
                                  <img
                                    src={p.data.image}
                                    alt=""
                                    loading="lazy"
                                    decoding="async"
                                  />
                                </div>
                              )}
                              <h3 class="card-title">{p.data.name}</h3>
                            </div>
                          </div>
                          {p.data.href && (
                            <a
                              href={p.data.href}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="icon-link project-cta"
                              aria-label={`Open ${p.data.name} project`}
                            >
                              <span>View project</span>
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                              </svg>
                            </a>
                          )}
                        </div>

                        {p.data.tagline && (
                          <p class="card-tagline">{p.data.tagline}</p>
                        )}

                        {highlights.length > 0 && (
                          <div class="highlights-block">
                            <ul class="card-highlights">
                              {visibleHighlights.map((highlight: string) => (
                                <li>{highlight}</li>
                              ))}
                            </ul>

                            {hiddenHighlights.length > 0 && (
                              <details class="card-details">
                                <summary class="card-details-summary">
                                  <span class="summary-collapsed">Show {hiddenHighlights.length} more detail{hiddenHighlights.length === 1 ? '' : 's'}</span>
                                  <span class="summary-open">Show fewer details</span>
                                </summary>
                                <ul class="card-highlights expanded">
                                  {hiddenHighlights.map((highlight: string) => (
                                    <li>{highlight}</li>
                                  ))}
                                </ul>
                              </details>
                            )}
                          </div>
                        )}

                        {p.data.duration && (
                          <div class="card-meta">
                            <span class="meta-item">
                              <span class="meta-label">Timeline</span>
                              <span>{p.data.duration}</span>
                            </span>
                          </div>
                        )}

                        {p.data.tags && p.data.tags.length > 0 && (
                          <div class="card-tags" aria-label={`${p.data.name} technologies`}>
                            {p.data.tags.map((tag: string) => (
                              <span class="tag-pill">{tag}</span>
                            ))}
                          </div>
                        )}
                      </div>
                    </article>
                  </div>
                );
                })}
              </div>
            </div>
          </div>
        </section>
      )}
    </div>
  </div>
</Base>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.icon-link').forEach((el) => {
      el.addEventListener('click', () => {
        const card = el.closest('article');
        const projectName = card?.querySelector('.card-title')?.textContent?.trim() || 'unknown';
        window.posthog?.capture('project_link_clicked', {
          project_name: projectName,
          href: el.getAttribute('href') || ''
        });
      });
    });

    const carousel = document.querySelector('.projects-carousel');
    const viewport = carousel?.querySelector('.carousel-viewport');
    const track = carousel?.querySelector('.carousel-track');
    const prevButton = document.querySelector('.carousel-arrow--prev');
    const nextButton = document.querySelector('.carousel-arrow--next');
    if (!carousel || !viewport || !track || !prevButton || !nextButton) return;

    const realSlides = Array.from(track.children);
    if (realSlides.length <= 1) return;

    const cloneCount = Math.min(Number(track.dataset.cloneCount) || 3, realSlides.length);
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const transitionValue = 'transform 2s cubic-bezier(0.4, 0, 0.2, 1)';
    let reducedMotionEnabled = reducedMotion.matches;
    let cardStep = 0;
    let activeIndex = cloneCount;
    let isTransitioning = false;

    const createClone = (node, suffix) => {
      const clone = node.cloneNode(true);
      clone.dataset.clone = suffix;
      clone.setAttribute('aria-hidden', 'true');
      clone.querySelectorAll('a, button, input, select, textarea, summary, [tabindex]').forEach((focusable) => {
        focusable.setAttribute('tabindex', '-1');
      });
      return clone;
    };

    const headClones = realSlides.slice(-cloneCount).map((slide, idx) => createClone(slide, `head-${idx}`));
    const tailClones = realSlides.slice(0, cloneCount).map((slide, idx) => createClone(slide, `tail-${idx}`));
    headClones.forEach((clone) => track.prepend(clone));
    tailClones.forEach((clone) => track.append(clone));

    const applyTransition = () => {
      track.style.transition = reducedMotionEnabled ? 'none' : transitionValue;
    };

    const updateMeasurements = () => {
      const firstSlide = track.querySelector('.carousel-slide');
      if (!firstSlide) return;
      const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || '0');
      cardStep = firstSlide.getBoundingClientRect().width + gap;
    };

    const applyTransform = (withTransition = true) => {
      if (!cardStep) updateMeasurements();
      if (!cardStep) return;
      if (!withTransition) {
        track.style.transition = 'none';
      } else {
        applyTransition();
      }
      track.style.transform = `translateX(${-(activeIndex * cardStep)}px)`;
      if (!withTransition) {
        track.getBoundingClientRect();
        applyTransition();
      }
    };

    const moveBy = (delta) => {
      if (isTransitioning && !reducedMotionEnabled) return;
      isTransitioning = !reducedMotionEnabled;
      activeIndex += delta;
      applyTransform(!reducedMotionEnabled);
      if (reducedMotionEnabled) {
        normalizeIndex();
      }
    };

    const normalizeIndex = () => {
      const maxRealIndex = cloneCount + realSlides.length - 1;
      if (activeIndex < cloneCount) {
        activeIndex += realSlides.length;
        applyTransform(false);
      } else if (activeIndex > maxRealIndex) {
        activeIndex -= realSlides.length;
        applyTransform(false);
      }
      isTransitioning = false;
    };

    track.addEventListener('transitionend', (event) => {
      if (event.propertyName !== 'transform') return;
      normalizeIndex();
    });

    reducedMotion.addEventListener('change', (event) => {
      reducedMotionEnabled = event.matches;
      applyTransition();
    });

    prevButton.addEventListener('click', () => moveBy(-1));
    nextButton.addEventListener('click', () => moveBy(1));

    viewport.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        moveBy(-1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        moveBy(1);
      }
    });

    window.addEventListener('resize', () => {
      updateMeasurements();
      applyTransform(false);
    });

    applyTransition();
    updateMeasurements();
    applyTransform(false);
  });
</script>

<style>
  .projects-content-shell {
    position: relative;
    z-index: 3;
  }

  .projects-container {
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
  }

  .page-title {
    color: rgb(var(--fg));
  }

  :global(html.light) .page-title {
    color: #ffffff;
  }

  /* Featured row: flex + center so when cards wrap to a single column they
     are centered in the container (vs. left-aligned with empty grid space). */
  .featured-projects-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .featured-projects-grid > .project-card {
    flex: 1 1 18rem;
    min-width: 0;
    max-width: 22rem;
  }

  @media (max-width: 767px) {
    .featured-projects-grid {
      gap: 1.25rem;
    }

    .featured-projects-grid > .project-card {
      flex: 1 1 100%;
      max-width: 100%;
    }
  }

  .projects-carousel-wrap {
    margin-top: 0.5rem;
  }

  .projects-carousel {
    position: relative;
  }

  /* White circular chevron arrows overlaying the carousel edges. */
  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 6;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 999px;
    border: 1.5px solid rgba(0, 0, 0, 0.08);
    background: #ffffff;
    color: #111111;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    padding: 0;
  }

  .carousel-arrow svg {
    width: 14px;
    height: 14px;
    display: block;
  }

  .carousel-arrow--prev {
    left: 0.4rem;
  }

  .carousel-arrow--next {
    right: 0.4rem;
  }

  .carousel-arrow:hover {
    transform: translateY(-50%) scale(1.07);
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.38);
    background: #ffffff;
  }

  .carousel-arrow:focus-visible {
    outline: 2px solid #2563eb;
    outline-offset: 3px;
  }

  @media (min-width: 1024px) {
    .carousel-arrow {
      width: 2rem;
      height: 2rem;
    }
    .carousel-arrow svg {
      width: 16px;
      height: 16px;
    }
    .carousel-arrow--prev {
      left: -0.75rem;
    }
    .carousel-arrow--next {
      right: -0.75rem;
    }
  }

  @media (max-width: 480px) {
    .carousel-arrow {
      width: 1.55rem;
      height: 1.55rem;
    }
    .carousel-arrow svg {
      width: 12px;
      height: 12px;
    }
  }

  :global(html.dark) .carousel-arrow {
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.55);
  }

  .carousel-viewport {
    overflow: hidden;
    border-radius: 14px;
    outline: none;
  }

  .carousel-track {
    display: flex;
    gap: 1rem;
    will-change: transform;
    transform: translateX(0);
    transition: transform 2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* One card visible at a time, full width of the container.
     The track translates by exactly one slide width + gap on each prev/next.
     Cards that scroll past .carousel-viewport are clipped (overflow: hidden). */
  .carousel-slide {
    flex: 0 0 100%;
    display: flex;
  }

  .carousel-slide .project-card {
    width: 100%;
    min-height: 19rem;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      transition: none;
    }
  }

  /* Hackathon cards: keep clamped copy while carousel enforces uniform size */
  .project-card.hackathon-card {
    grid-column: span 1 !important;
    grid-row: span 1 !important;
    height: 100%;
  }

  .project-card.hackathon-card .card-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .project-card.hackathon-card .card-tagline {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .project-card.hackathon-card .card-highlights li {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .project-card.hackathon-card .card-tags {
    margin-top: auto;
  }

  .project-card {
    position: relative;
    --card-surface: rgba(255, 255, 255, 0.78);
    --card-surface-strong: rgba(255, 255, 255, 0.92);
    --card-fg: rgb(var(--fg));
    --card-muted: rgba(var(--fg), 0.68);
    --card-subtle: rgba(var(--fg), 0.54);
    --card-border: rgba(var(--border), 0.12);
    --card-border-strong: rgba(var(--border), 0.2);
    --card-accent: #2563eb;
    --card-accent-soft: rgba(37, 99, 235, 0.1);
    --card-badge-bg: rgba(37, 99, 235, 0.12);
    --card-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
    background:
      linear-gradient(145deg, var(--card-surface-strong), var(--card-surface)),
      radial-gradient(circle at 18% 0%, var(--card-accent-soft), transparent 34%);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    color: var(--card-fg);
    backdrop-filter: blur(18px);
  }

  .project-card.wide {
    grid-column: span 1;
  }

  .project-card.accent-wide,
  .project-card.featured,
  .project-card.wide {
    grid-column: span 1;
  }

  .project-card.accent-tall,
  .project-card.featured {
    grid-row: span 1;
  }

  @media (min-width: 640px) {
    .project-card.wide,
    .project-card.accent-wide,
    .project-card.featured {
      grid-column: span 2;
    }
  }

  @media (min-width: 1200px) {
    .project-card.wide,
    .project-card.accent-wide {
      grid-column: span 2;
    }

    .project-card.featured {
      grid-column: span 2;
      grid-row: span 1;
    }

    .project-card.accent-tall {
      grid-row: span 1;
    }
  }

  @media (prefers-color-scheme: dark) {
    .project-card {
      --card-surface: rgba(17, 24, 39, 0.72);
      --card-surface-strong: rgba(10, 10, 10, 0.82);
      --card-fg: rgba(255, 255, 255, 0.95);
      --card-muted: rgba(255, 255, 255, 0.74);
      --card-subtle: rgba(255, 255, 255, 0.58);
      --card-border: rgba(255, 255, 255, 0.18);
      --card-border-strong: rgba(255, 255, 255, 0.3);
      --card-accent: #8ab4ff;
      --card-accent-soft: rgba(90, 138, 232, 0.18);
      --card-badge-bg: rgba(90, 138, 232, 0.18);
      --card-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
    }
  }

  :global(html.light) .project-card {
    --card-surface: rgba(255, 255, 255, 0.78);
    --card-surface-strong: rgba(255, 255, 255, 0.92);
    --card-fg: rgb(var(--fg));
    --card-muted: rgba(var(--fg), 0.68);
    --card-subtle: rgba(var(--fg), 0.54);
    --card-border: rgba(var(--border), 0.12);
    --card-border-strong: rgba(var(--border), 0.2);
    --card-accent: #2563eb;
    --card-accent-soft: rgba(37, 99, 235, 0.1);
    --card-badge-bg: rgba(37, 99, 235, 0.12);
    --card-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
  }

  :global(html.dark) .project-card {
    --card-surface: rgba(17, 24, 39, 0.72);
    --card-surface-strong: rgba(10, 10, 10, 0.82);
    --card-fg: rgba(255, 255, 255, 0.95);
    --card-muted: rgba(255, 255, 255, 0.74);
    --card-subtle: rgba(255, 255, 255, 0.58);
    --card-border: rgba(255, 255, 255, 0.18);
    --card-border-strong: rgba(255, 255, 255, 0.3);
    --card-accent: #8ab4ff;
    --card-accent-soft: rgba(90, 138, 232, 0.18);
    --card-badge-bg: rgba(90, 138, 232, 0.18);
    --card-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
