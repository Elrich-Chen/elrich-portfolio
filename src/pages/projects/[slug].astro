---
import { getCollection } from 'astro:content';
import LumenLayout from '../../layouts/LumenLayout.astro';
import CaseStudy from '../../components/lumen/CaseStudy.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const {
  name,
  tagline,
  category,
  image,
  imageFit,
  year,
  role,
  duration,
  tags,
  highlights,
  href,
  devpost,
  linkedin,
  deployed,
  award,
} = project.data;

const meta = [role, year, duration].filter(Boolean) as string[];
const ctaHref = href ?? devpost ?? linkedin;
const ctaLabel =
  href && href !== devpost && href !== linkedin
    ? 'Visit project'
    : devpost
      ? 'View on Devpost'
      : 'Read on LinkedIn';

let secondaryHref: string | undefined;
let secondaryLabel = 'View on Devpost';
if (href && devpost && href !== devpost) {
  secondaryHref = devpost;
  secondaryLabel = 'View on Devpost';
} else if (href && linkedin && href !== linkedin) {
  secondaryHref = linkedin;
  secondaryLabel = 'Read on LinkedIn';
}

const figureHref = linkedin ?? devpost ?? href;
const figureLabel = linkedin
  ? 'LinkedIn →'
  : devpost
    ? 'Devpost →'
    : 'Open project →';
---

<LumenLayout title={`${name} — Elrich`}>
  <CaseStudy
    title={name}
    tagline={tagline}
    eyebrow={`— Case Study${category ? ` · ${category}` : ''}`}
    backHref="/#projects"
    backLabel="← Projects"
    meta={meta}
    live={Boolean(deployed)}
    award={award}
    image={image}
    imageAlt={`${name} preview`}
    imageFit={imageFit}
    externalHref={figureHref}
    externalLabel={figureLabel}
    highlights={highlights ?? []}
    tags={tags ?? []}
    ctaHref={ctaHref}
    ctaLabel={ctaLabel}
    secondaryHref={secondaryHref}
    secondaryLabel={secondaryLabel}
    footerBackHref="/#projects"
    footerBackLabel="← Back to projects"
  >
    <Content />
  </CaseStudy>
</LumenLayout>
