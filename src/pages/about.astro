<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('polaroid-stack');
    if (!wrapper) return;

    const polaroidItems = wrapper.querySelectorAll('.polaroid-item');
    const totalItems = polaroidItems.length;
    let cycleTimer = null;

    const cycle = () => {
      polaroidItems.forEach((polaroid) => {
        const currentIndex = parseInt(polaroid.getAttribute('data-index') || '0', 10);
        const nextIndex = (currentIndex + 1) % totalItems;
        polaroid.setAttribute('data-index', String(nextIndex));
      });

      wrapper.classList.add('is-cycling');
      if (cycleTimer) window.clearTimeout(cycleTimer);
      cycleTimer = window.setTimeout(() => {
        wrapper.classList.remove('is-cycling');
      }, 560);
    };

    polaroidItems.forEach((item) => {
      item.addEventListener('click', cycle);
    });

    const cyclePill = wrapper.querySelector('.cycle-pill');
    if (cyclePill) {
      cyclePill.addEventListener('click', (event) => {
        event.stopPropagation();
        cycle();
      });
    }
  });
</script>
