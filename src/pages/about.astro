---
import Base from '../layouts/Base.astro';
import Polaroid from '../components/Polaroid.astro';

const stats = [
  { value: '5', label: 'Hackathons' },
  { value: '2', label: 'Years Exp' },
  { value: '500+', label: 'Commits' },
  { value: '200+', label: 'Students Mentored' },
];

const socials = [
  {
    href: 'mailto:elrichchen123@gmail.com',
    label: 'Email',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zm0 2v.01L12 13l8-5.99V7H4z"/></svg>`,
  },
  {
    href: 'https://github.com/Elrich-Chen',
    label: 'GitHub',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`,
  },
  {
    href: 'https://linkedin.com/in/elrichchen',
    label: 'LinkedIn',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
];

const tldr = {
  hook: 'CS @ Waterloo, Aspring Backend Engineer.',
  body: "I build across student orgs and freelance projects, and I care about clarity, reliability, and community impact.",
};

const highlights = [
  {
    text: "Secured 2nd place among 20+ teams in Queen's University NBA Data Analytics case competition",
    href: 'https://www.instagram.com/p/DH4J-30SmkA/?img_index=6',
    logo: '/logos/qsao.png',
  },
  {
    text: "Mentored 200+ students at University of Toronto Engineering Outreach as a Residence Counsellor",
    href: 'https://outreach.engineering.utoronto.ca',
    logo: '/logos/uoft2.png',
  },
];

const education = [
  {
    school: 'University of Waterloo',
    degree: 'Bachelors in Computer Science',
    logo: '/logos/uwaterloo.png',
  },
  {
    school: "Queen's University",
    degree: 'Bachelors in Computer Science',
    logo: '/logos/queensu.png',
  },
];

const techStack = {
  Languages: ['C', 'TypeScript', 'Python', 'Java', 'JavaScript', 'Bash', 'SQL'],
  Frameworks: ['React', 'Next.js', 'Flask', 'FastAPI', 'TailwindCSS', 'PostgresSQL'],
  Tools: ['Figma', 'GitHub', 'Notion', 'MongoDB', 'Git'],
};

const issueDate = new Date().toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
}).toUpperCase();
---

<Base title="About – Elrich Chen">
  <div class="about-content-shell">
    <div class="about-back">
      <a href="/" class="back-home-link">← Back to home</a>
    </div>

    <!-- Magazine masthead -->
    <header class="masthead">
      <div class="masthead-meta">
        <span class="masthead-edition">Field Notes · Vol. III</span>
        <span class="masthead-rule" aria-hidden="true"></span>
        <span class="masthead-date">{issueDate}</span>
      </div>
      <h1 class="masthead-title">
        <span class="masthead-amper">A</span>bout
        <span class="masthead-name">Elrich</span>
      </h1>
      <p class="masthead-sub">A short paper on what I build, study, and reach for on my days off.</p>
    </header>

    <!-- HERO row: TL;DR + fanned polaroid stack -->
    <section class="hero-strip">
      <div class="hero-prose">
        <p class="eyebrow">
          <span class="eyebrow-num">01</span>
          <span class="eyebrow-rule"></span>
          <span class="eyebrow-label">TL;DR</span>
        </p>
        <h2 class="hero-hook">{tldr.hook}</h2>
        <p class="hero-body">{tldr.body}</p>

        <div class="hero-socials" aria-label="Social links">
          {socials.map((link) => (
            <a
              href={link.href}
              aria-label={link.label}
              class="hero-social"
              target={link.href.startsWith('mailto:') ? undefined : '_blank'}
              rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
            >
              <span class="hero-social-svg" set:html={link.icon}></span>
              <span class="hero-social-label">{link.label}</span>
            </a>
          ))}
        </div>
      </div>

      <aside class="hero-aside">
        <div class="polaroid-wrapper" id="polaroid-stack">
          <div class="polaroid-item" data-index="0">
            <Polaroid
              src="/photos/elrich_photos/gym.jpeg"
              alt="Elrich at the gym"
              caption="Staying active"
              rotation={-3}
            />
          </div>
          <div class="polaroid-item" data-index="2">
            <Polaroid
              src="/photos/elrich_photos/IMG_7489.jpeg"
              alt="Elrich"
              caption="Making memories"
              rotation={2}
            />
          </div>
          <div class="polaroid-item" data-index="1">
            <Polaroid
              src="/photos/elrich_photos/IMG_8352.jpeg"
              alt="Elrich"
              caption="Exploring new hobbies"
              rotation={-2}
            />
          </div>
          <button type="button" class="cycle-pill" aria-label="Cycle through photos">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
              <path d="M3 3v5h5"/>
            </svg>
            <span>Click to cycle</span>
          </button>
        </div>

        <figcaption class="hero-tag">
          <span class="hero-tag-line">— Elrich Chen</span>
          <span class="hero-tag-sub">CS @ Waterloo</span>
        </figcaption>
      </aside>
    </section>

    <!-- STATS ticker -->
    <div class="stats-strip" aria-label="Personal stats">
      {stats.map((stat, i) => (
        <div class="stat-cell">
          <span class="stat-index">{String(i + 1).padStart(2, '0')}</span>
          <span class="stat-value">{stat.value}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))}
    </div>

    <!-- FIELD NOTES grid -->
    <div class="field-grid">
      <!-- Highlights (wide) -->
      <section class="field-card field-highlights">
        <p class="eyebrow">
          <span class="eyebrow-num">02</span>
          <span class="eyebrow-rule"></span>
          <span class="eyebrow-label">Highlights</span>
        </p>
        <ul class="highlights-list">
          {highlights.map((item, i) => (
            <li class="highlights-item">
              <span class="highlights-marker">{String(i + 1).padStart(2, '0')}</span>
              <img src={item.logo} alt="" class="highlights-logo" loading="lazy" />
              <a href={item.href} class="highlights-link" target="_blank" rel="noopener noreferrer">
                {item.text}
                <span class="highlights-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <!-- Tech Stack (narrow) -->
      <section class="field-card field-stack">
        <p class="eyebrow">
          <span class="eyebrow-num">03</span>
          <span class="eyebrow-rule"></span>
          <span class="eyebrow-label">Tech Stack</span>
        </p>
        <div class="stack-groups">
          {Object.entries(techStack).map(([group, items]) => (
            <div class="stack-group">
              <h3 class="stack-label">{group}</h3>
              <div class="stack-badges">
                {items.map((item) => (
                  <span class="stack-badge">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Education (two stamps + transfer note) -->
      <section class="field-card field-education">
        <p class="eyebrow">
          <span class="eyebrow-num">04</span>
          <span class="eyebrow-rule"></span>
          <span class="eyebrow-label">Education</span>
        </p>
        <div class="edu-stamps">
          {education.map((item, i) => (
            <div class={`edu-stamp ${i === 0 ? 'edu-stamp-primary' : 'edu-stamp-prior'}`}>
              <span class="edu-stamp-corner edu-stamp-corner-tl" aria-hidden="true"></span>
              <span class="edu-stamp-corner edu-stamp-corner-tr" aria-hidden="true"></span>
              <span class="edu-stamp-corner edu-stamp-corner-bl" aria-hidden="true"></span>
              <span class="edu-stamp-corner edu-stamp-corner-br" aria-hidden="true"></span>
              <img src={item.logo} alt={item.school} class="edu-stamp-logo" loading="lazy" />
              <h3 class="edu-stamp-school">{item.school}</h3>
              <p class="edu-stamp-degree">{item.degree}</p>
              <span class="edu-stamp-status">{i === 0 ? 'Current' : 'Prior'}</span>
            </div>
          ))}
        </div>
        <p class="edu-note">
          <span class="edu-note-mark" aria-hidden="true">※</span>
          Transferred from Queen's University to the University of Waterloo for Computer Science.
        </p>
      </section>
    </div>

    <!-- BEYOND the keyboard -->
    <section class="beyond-section">
      <p class="eyebrow eyebrow-center">
        <span class="eyebrow-num">05</span>
        <span class="eyebrow-rule"></span>
        <span class="eyebrow-label">Beyond the Keyboard</span>
      </p>
      <div class="beyond-grid">
        <figure class="beyond-photo">
          <img src="/photos/elrich_photos/liondance.png" alt="Lion dance performance" loading="lazy" />
          <figcaption>
            <span class="beyond-photo-label">Lion Dancing</span>
            <span class="beyond-photo-sub">Drums, footwork, weekends.</span>
          </figcaption>
        </figure>
        <div class="beyond-tile beyond-teach">
          <span class="beyond-tile-glyph" aria-hidden="true">✦</span>
          <h4>Teaching</h4>
          <p>Mentoring and workshops with the next wave of CS students.</p>
        </div>
        <div class="beyond-tile beyond-climb">
          <span class="beyond-tile-glyph" aria-hidden="true">△</span>
          <h4>Climbing</h4>
          <p>Weekly bouldering — the reset button for everything else.</p>
        </div>
      </div>
    </section>

    <div class="about-colophon" aria-hidden="true">
      <span>— end of issue —</span>
    </div>
  </div>
</Base>

<style>
  /* ─── Layering: keep ASCII visible at all times ─────────────────────── */
  .about-content-shell {
    position: relative;
    z-index: 3;
    color: #fff;
    padding-bottom: 2.5rem;
  }

  .about-back {
    margin-bottom: 1.25rem;
  }

  /* ─── Masthead ──────────────────────────────────────────────────────── */
  .masthead {
    margin: 0.5rem 0 2.4rem;
  }

  .masthead-meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Menlo', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 1.2rem;
  }

  .masthead-edition {
    white-space: nowrap;
  }

  .masthead-rule {
    flex: 1 1 auto;
    height: 1px;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0.25),
      rgba(255, 255, 255, 0.06)
    );
    min-width: 1.5rem;
  }

  .masthead-date {
    white-space: nowrap;
  }

  .masthead-title {
    margin: 0;
    font-family: 'Syne', 'Rubik', sans-serif;
    font-weight: 700;
    font-size: clamp(2.8rem, 9vw, 5.4rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: #fff;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 0.45);
  }

  .masthead-amper {
    display: inline-block;
    font-style: italic;
    transform: translateY(-0.04em);
  }

  .masthead-name {
    font-family: 'Reenie Beanie', cursive;
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
    font-size: 1.12em;
    color: #ffd28a;
    display: inline-block;
    transform: rotate(-3deg) translateY(0.08em);
    margin-left: 0.4rem;
  }

  .masthead-sub {
    margin: 1rem 0 0;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
    max-width: 44ch;
    line-height: 1.55;
  }

  /* ─── Shared eyebrow label (numbered field-note marker) ─────────────── */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Menlo', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }

  .eyebrow-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.55rem;
    height: 1.55rem;
    padding: 0 0.32rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffd28a;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .eyebrow-rule {
    width: 1.4rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.3);
  }

  .eyebrow-label {
    white-space: nowrap;
  }

  .eyebrow-center {
    justify-content: center;
  }

  .eyebrow-center .eyebrow-rule {
    width: 2.4rem;
  }

  /* ─── HERO strip: TL;DR + fanned polaroid stack ─────────────────────── */
  .hero-strip {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    margin-bottom: 3rem;
    padding: 1.8rem 1.9rem;
    border-radius: 18px;
    background: rgba(8, 10, 18, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.35);
    position: relative;
    overflow: hidden;
  }

  .hero-strip::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(255, 210, 138, 0.06), transparent 40%),
      radial-gradient(circle at 85% 110%, rgba(96, 165, 250, 0.08), transparent 55%);
    pointer-events: none;
  }

  .hero-prose {
    position: relative;
    z-index: 1;
  }

  .hero-hook {
    margin: 0 0 0.85rem;
    font-family: 'Syne', 'Rubik', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.05rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: #fff;
    max-width: 22ch;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.4);
  }

  .hero-body {
    margin: 0 0 1.5rem;
    font-size: 0.96rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
    max-width: 46ch;
  }

  .hero-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .hero-social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem 0.5rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }

  .hero-social:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 210, 138, 0.55);
    background: rgba(255, 255, 255, 0.13);
  }

  .hero-social-svg {
    display: inline-flex;
    width: 15px;
    height: 15px;
  }

  .hero-social-svg :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* ─── HERO aside: fanned polaroid stack ─────────────────────────────── */
  .hero-aside {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .polaroid-wrapper {
    position: relative;
    width: 220px;
    min-height: 320px;
    margin: 0 auto;
  }

  .hero-aside :global(.polaroid) {
    width: 100%;
    max-width: 220px;
    margin-top: 0;
  }

  .polaroid-item {
    position: absolute;
    top: 0;
    left: 0;
    cursor: pointer;
    transition:
      transform 0.55s cubic-bezier(0.34, 1.4, 0.5, 1),
      filter 0.4s ease,
      opacity 0.4s ease;
    transform-origin: 50% 70%;
  }

  /* Fan the stack so all three peek out — depth without dominating the frame */
  .polaroid-item[data-index="0"] {
    z-index: 1;
    transform: translate(-22px, 16px) rotate(-7deg);
    filter: brightness(0.78);
    opacity: 0.94;
  }

  .polaroid-item[data-index="1"] {
    z-index: 2;
    transform: translate(14px, 8px) rotate(5deg);
    filter: brightness(0.9);
    opacity: 0.96;
  }

  .polaroid-item[data-index="2"] {
    z-index: 3;
    transform: translate(0, 0) rotate(-1deg);
    filter: brightness(1);
    opacity: 1;
  }

  .polaroid-item:hover {
    filter: brightness(1.05) !important;
  }

  .polaroid-wrapper.is-cycling .polaroid-item[data-index="2"] {
    animation: polaroid-shake 0.55s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  }

  @keyframes polaroid-shake {
    0%   { transform: translate(0, 0) rotate(-1deg); }
    25%  { transform: translate(-4px, -3px) rotate(-5deg) scale(1.03); }
    55%  { transform: translate(5px, 1px) rotate(3deg) scale(1.04); }
    80%  { transform: translate(-2px, 2px) rotate(-2deg) scale(1.01); }
    100% { transform: translate(0, 0) rotate(-1deg); }
  }

  .cycle-pill {
    position: absolute;
    bottom: -14px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.32rem 0.7rem;
    background: rgba(10, 10, 14, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.88);
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Menlo', monospace;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
    transition: transform 0.2s ease, border-color 0.2s ease;
    z-index: 10;
  }

  .cycle-pill:hover {
    border-color: rgba(255, 210, 138, 0.7);
    transform: translateX(-50%) translateY(-1px);
  }

  .hero-tag {
    margin: 1.4rem 0 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hero-tag-line {
    font-family: 'Reenie Beanie', cursive;
    font-size: 1.65rem;
    line-height: 1;
    color: #ffd28a;
  }

  .hero-tag-sub {
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Menlo', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  /* ─── Stats ticker strip ────────────────────────────────────────────── */
  .stats-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin-bottom: 3rem;
    padding: 0;
    border-radius: 14px;
    background: rgba(8, 10, 18, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
  }

  .stat-cell {
    position: relative;
    padding: 1.1rem 0.9rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .stat-cell + .stat-cell::before {
    content: '';
    position: absolute;
    top: 18%;
    bottom: 18%;
    left: 0;
    width: 1px;
    background: rgba(255, 255, 255, 0.14);
  }

  .stat-index {
    font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Menlo', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    color: rgba(255, 210, 138, 0.75);
  }

  .stat-value {
    font-family: 'Syne', 'Rubik', sans-serif;
    font-size: clamp(1.4rem, 3.4vw, 1.95rem);
    font-weight: 700;
    line-height: 1.05;
    color: #fff;
