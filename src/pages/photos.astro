---
import Base from '../layouts/Base.astro';
import HeroAsciiBackdrop from '../components/HeroAsciiBackdrop.astro';
import TiltedCard from '../components/TiltedCard.astro';
import { getCollection } from 'astro:content';

const allPhotos = await getCollection('photos');
---

<Base title="Photos – Elrich Chen">
  <HeroAsciiBackdrop videoSrc="/videos/tiger.mp4" />
  <div class="photos-content-shell">
    <div class="mb-6">
      <a href="/" class="back-home-link">← Back to home</a>
    </div>
    <h1 class="page-title text-xl font-semibold mb-8">Photos</h1>
    <p class="photo-intro">Drag or tap photos to explore the gallery.</p>

    {allPhotos.length === 0 ? (
      <p class="text-neutral-600">No photos yet. Add your photos to src/content/photos/</p>
    ) : (
      <div
        class="photo-grid grid w-full max-w-screen-2xl mx-auto grid-cols-2 gap-2 md:grid-cols-3 md:gap-3 xl:grid-cols-4 2xl:grid-cols-5 xl:gap-3 pt-4 pb-12"
      >
        {allPhotos.map((photo) => (
          <div class="photo-cell flex min-w-0 flex-col gap-2 md:gap-3">
            <div class="photo-thumb aspect-square w-full min-w-0">
              <TiltedCard
                imageSrc={photo.data.image}
                altText={photo.data.caption}
                captionText={[photo.data.caption, photo.data.location].filter(Boolean).join(' · ')}
                containerHeight="100%"
                containerWidth="100%"
                imageHeight="100%"
                imageWidth="100%"
                rotateAmplitude={12}
                scaleOnHover={1.06}
                showMobileWarning={false}
                showTooltip={true}
              />
            </div>
            <div class="photo-meta">
              <p class="photo-caption">{photo.data.caption}</p>
              <div class="photo-sub">
                <span>{photo.data.date}</span>
                {photo.data.location && (
                  <>
                    <span class="dot">·</span>
                    <span>{photo.data.location}</span>
                  </>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</Base>

<style>
  .photos-content-shell {
    position: relative;
    z-index: 3;
  }

  .page-title {
    color: #fff;
  }

  .photo-intro {
    margin: -1.2rem 0 0.8rem;
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .photo-thumb {
    min-height: 0;
  }

  .photo-thumb :global(.tc-figure) {
    height: 100% !important;
    width: 100% !important;
    min-height: 0;
  }

  .photo-thumb :global(.tc-inner) {
    width: 100% !important;
    height: 100% !important;
    min-height: 0;
  }

  .photo-thumb :global(.tc-img) {
    object-fit: cover;
    object-position: center;
  }

  .photo-meta {
    text-align: center;
  }

  .photo-caption {
    font-family: 'Reenie Beanie', cursive;
    font-size: 1.4rem;
    color: #fff;
    line-height: 1.3;
    margin-bottom: 0.2rem;
  }

  .photo-sub {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: #fff;
    font-weight: 500;
    opacity: 0.9;
    flex-wrap: wrap;
  }

  .dot {
    color: #fff;
    opacity: 0.7;
  }

  @media (max-width: 480px) {
    .photo-thumb :global(.tc-img) {
      border-radius: 12px;
    }

    .photo-caption {
      font-size: 1.22rem;
      margin-bottom: 0.1rem;
      line-height: 1.24;
    }

    .photo-sub {
      font-size: 0.78rem;
      row-gap: 0.2rem;
    }

    .photo-intro {
      margin-top: -1rem;
      margin-bottom: 0.55rem;
      font-size: 0.84rem;
    }
  }
</style>
