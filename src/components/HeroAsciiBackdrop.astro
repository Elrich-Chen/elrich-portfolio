---
import HeroAsciiVideo from './HeroAsciiVideo';
const { videoSrc = '/videos/jellyfish.mp4', loop = true } = Astro.props;
---

<!-- Fixed ASCII layer: decorative only (aria-hidden). -->
<div
  class="home-ascii-global-root"
  id="hero-ascii-shell"
  data-hero-video={videoSrc}
  data-hero-loop={loop ? '1' : '0'}
  aria-hidden="true"
>
  <div class="hero-name-ascii-shell">
    <div class="hero-name-ascii-mount">
      <HeroAsciiVideo videoSrc={videoSrc} loop={loop} client:load />
    </div>
  </div>
</div>

<style>
  /* Above Grainient (layer 0); keep z below home columns/hero (.home-ascii-first-screen is higher). */
  .home-ascii-global-root {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    min-height: 100vh;
    min-height: 100dvh;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    /* Transparent so Grainient shows when WebGL/video is not ready (avoids flat #080808 void). */
    background: transparent;
  }

  .hero-name-ascii-shell {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-name-ascii-mount {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 100dvh;
    box-sizing: border-box;
  }

  .hero-name-ascii-mount :global(.hero-ascii-size-guard) {
    width: 100%;
    height: 100%;
    min-width: 120px;
    min-height: 100%;
    box-sizing: border-box;
  }

  .hero-name-ascii-mount :global(.hero-video-ascii) {
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    box-sizing: border-box;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-ascii-global-root {
      display: none;
    }
  }
</style>
