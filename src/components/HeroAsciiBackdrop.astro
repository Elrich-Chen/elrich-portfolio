---
import HeroAsciiVideo from './HeroAsciiVideo';
const { videoSrc = '/videos/jellyfish.mp4' } = Astro.props;
---

<!-- Single island: fixed under main content (+Grainient below), spans the viewport while you scroll -->
<div class="home-ascii-global-root" aria-hidden="true">
  <div class="hero-name-ascii-shell">
    <div class="hero-name-ascii-mount">
      <HeroAsciiVideo videoSrc={videoSrc} client:media="(prefers-reduced-motion: no-preference)" />
    </div>
  </div>
</div>

<style>
  /* Above Grainient (layer 0); keep z below home columns/hero (.home-ascii-first-screen is higher). */
  .home-ascii-global-root {
    position: fixed;
    inset: 0;
    width: 100vw;
    min-height: 100vh;
    min-height: 100dvh;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    background: #080808;
  }

  .hero-name-ascii-shell {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-name-ascii-mount {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
  }

  .hero-name-ascii-mount :global(.hero-ascii-size-guard) {
    width: 100%;
    height: 100%;
    min-width: 120px;
    min-height: 100%;
    box-sizing: border-box;
  }

  .hero-name-ascii-mount :global(.hero-video-ascii) {
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    box-sizing: border-box;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-ascii-global-root {
      display: none;
    }
  }
</style>
