---
import type { PageFlowEntry } from '../utils/pageFlow';

interface Props {
  prev: PageFlowEntry;
  next: PageFlowEntry;
}

const { prev, next } = Astro.props;
---

<nav class="page-flow-nav" aria-label="Page navigation">
  <a
    href={prev.href}
    data-astro-prefetch
    class="page-flow-link back-home-link page-flow-link--prev cursor-target"
    aria-label={`Previous page: ${prev.label}`}
    data-page-flow="prev"
  >
    ← {prev.label}
  </a>
  <a
    href={next.href}
    data-astro-prefetch
    class="page-flow-link back-home-link page-flow-link--next cursor-target"
    aria-label={`Next page: ${next.label}`}
    data-page-flow="next"
  >
    {next.label} →
  </a>
</nav>

<style>
  .page-flow-nav {
    position: fixed;
    top: calc(var(--nav-top-offset) + var(--nav-height) + 0.5rem);
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-inline: clamp(1.5rem, 4vw, 2rem);
    z-index: var(--layer-page-flow, 50);
    pointer-events: none;
  }

  .page-flow-link {
    pointer-events: auto;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    white-space: nowrap;
    flex: 0 1 auto;
    max-width: min(42vw, 12rem);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .page-flow-link--prev {
    text-align: left;
  }

  .page-flow-link--next {
    text-align: right;
    margin-left: auto;
  }

  .page-flow-link:focus-visible {
    outline: 2px solid #2563eb;
    outline-offset: 3px;
    opacity: 1;
  }

  @media (min-width: 640px) {
    .page-flow-nav {
      padding-inline: 2rem;
    }
  }

  @media (max-width: 480px) {
    .page-flow-nav {
      top: calc(var(--nav-top-offset) + var(--nav-height) + 0.4rem);
      padding-inline: max(var(--nav-mobile-inline, 0.6rem), env(safe-area-inset-left, 0px))
        max(var(--nav-mobile-inline, 0.6rem), env(safe-area-inset-right, 0px));
      gap: 0.5rem;
    }

    .page-flow-link {
      max-width: min(38vw, 9.5rem);
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-flow-link {
      transition: opacity 0.15s ease;
    }
  }
</style>
