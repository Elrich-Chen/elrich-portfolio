---
import { Image } from 'astro:assets';
import ramenPhoto from '../../assets/hobbies/ramen.jpeg';
import ravingPhoto from '../../assets/hobbies/raving.jpeg';

import cooking1 from '../../assets/hobbies/cooking/cooking-1.jpg';
import cooking2 from '../../assets/hobbies/cooking/cooking-2.jpg';

import sports1 from '../../assets/hobbies/sports/sports-1.jpg';
import sports2 from '../../assets/hobbies/sports/sports-2.jpg';
import sports3 from '../../assets/hobbies/sports/sports-3.jpg';
import sports4 from '../../assets/hobbies/sports/sports-4-liondance.png';

import gardening1 from '../../assets/hobbies/gardening/gardening-1.jpg';
import gardening2 from '../../assets/hobbies/gardening/gardening-2.jpg';
import gardening3 from '../../assets/hobbies/gardening/gardening-3.jpg';
import gardening4 from '../../assets/hobbies/gardening/gardening-4.jpg';

import brunoMars1 from '../../assets/hobbies/music/bruno-mars-1.jpg';
import brunoMars2 from '../../assets/hobbies/music/bruno-mars-2.jpg';
import brunoMarsVideo1Poster from '../../assets/hobbies/music/bruno-mars-video-1-poster.jpg';
import brunoMarsVideo2Poster from '../../assets/hobbies/music/bruno-mars-video-2-poster.jpg';
import martinGarrix1 from '../../assets/hobbies/music/martin-garrix-1.jpg';
import martinGarrix2 from '../../assets/hobbies/music/martin-garrix-2.jpg';

const hobbies = [
  {
    id: 'eating',
    label: 'Cooking',
    media: [
      { type: 'image', src: cooking1, alt: 'Shakshuka', caption: 'Shakshuka' },
      { type: 'image', src: cooking2, alt: 'Steak', caption: 'Steak' },
      { type: 'image', src: ramenPhoto, alt: 'Mala ramen', caption: 'Mala ramen' },
    ],
  },
  {
    id: 'sports',
    label: 'Sports',
    media: [
      { type: 'image', src: sports1, alt: 'Downtown Markham run', caption: 'Downtown Markham' },
      { type: 'image', src: sports2, alt: 'The Arborfront run', caption: 'The Arborfront' },
      { type: 'image', src: sports3, alt: 'Toronto run', caption: 'Toronto' },
      { type: 'image', src: sports4, alt: 'Chinese lion dance', caption: 'Chinese lion dance' },
    ],
  },
  {
    id: 'gardening',
    label: 'Gardening',
    media: [
      { type: 'image', src: gardening4, alt: 'Blueberry plant', caption: 'Blueberry plant' },
      { type: 'image', src: gardening1, alt: 'Chili plant', caption: 'Chili plant' },
      { type: 'image', src: gardening2, alt: 'Dandelions', caption: 'Dandelions' },
      { type: 'image', src: gardening3, alt: 'Strawflowers', caption: 'Strawflowers' },
    ],
  },
  {
    id: 'music',
    label: 'Music',
    media: [
      { type: 'image', src: ravingPhoto, alt: 'Broken hand', caption: 'Broken hand' },
      {
        type: 'video',
        src: '/video/hobbies/bruno-mars-1.mp4',
        poster: brunoMarsVideo1Poster,
        alt: 'Bruno Mars concert clip',
        caption: 'Bruno Mars',
      },
      { type: 'image', src: brunoMars1, alt: 'Bruno Mars concert', caption: 'Bruno Mars' },
      {
        type: 'video',
        src: '/video/hobbies/bruno-mars-2.mp4',
        poster: brunoMarsVideo2Poster,
        alt: 'Bruno Mars concert clip',
        caption: 'Bruno Mars',
      },
      { type: 'image', src: brunoMars2, alt: 'Bruno Mars concert', caption: 'Bruno Mars' },
      { type: 'image', src: martinGarrix1, alt: 'Martin Garrix concert', caption: 'Martin Garrix' },
      { type: 'image', src: martinGarrix2, alt: 'Martin Garrix concert', caption: 'Martin Garrix' },
    ],
  },
] as const;
---

<div id="hobbies">
  <section class="section section--product" aria-labelledby="product-heading">
    <div class="section-inner">
      <div class="product-header" data-reveal>
        <div class="section-head">
          <p class="eyebrow">— Off the clock</p>
          <h2 id="product-heading" class="product-h2">Hobbies.</h2>
        </div>
        <p class="product-caption">A few things outside of work.</p>
      </div>

      <div class="hobbies" data-hobby-window>
        <div class="hobbies-tabs" role="tablist" aria-label="Hobbies" data-reveal>
          {hobbies.map((hobby, i) => (
            <button
              type="button"
              class:list={['hobbies-tab', { 'hobbies-tab--active': i === 0 }]}
              role="tab"
              data-hobby-btn
              data-hobby={hobby.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              id={hobby.id === 'eating' ? 'eat' : hobby.id}
            >
              {hobby.label}
            </button>
          ))}
        </div>

        <div class="hobbies-frame" data-hobby-media>
          {hobbies.map((hobby, i) => (
            <article
              class:list={['hobbies-pane', { 'hobbies-pane--active': i === 0 }]}
              data-hobby-pane={hobby.id}
              aria-hidden={i === 0 ? 'false' : 'true'}
            >
              {hobby.media.length > 0 ? (
                <div
                  class="hobbies-scroller"
                  data-media-scroller
                  tabindex="0"
                  aria-label={`${hobby.label} photos`}
                >
                  {hobby.media.map((item, mi) => (
                    <div
                      class:list={['hobbies-slide', { 'hobbies-slide--active': mi === 0 }]}
                      data-media-item
                      data-media-index={mi}
                    >
                      {item.type === 'image' ? (
                        <Image
                          src={item.src}
                          alt={item.alt}
                          class="hobbies-img"
                          loading={i === 0 && mi === 0 ? 'eager' : 'lazy'}
                          fetchpriority={i === 0 && mi === 0 ? 'high' : 'auto'}
                          decoding="async"
                          width={1400}
                          widths={[640, 1000, 1400]}
                          sizes="(max-width: 768px) 92vw, min(72vw, 920px)"
                          format="webp"
                          quality={78}
                          draggable="false"
                        />
                      ) : (
                        <video
                          class="hobbies-video"
                          data-hobby-video
                          src={item.src}
                          poster={item.poster.src}
                          muted
                          loop
                          playsinline
                          preload="metadata"
                          controls
                          draggable="false"
                          aria-label={item.alt}
                        />
                      )}
                      {'caption' in item && item.caption ? (
                        <div class="hobbies-veil" aria-hidden="true">
                          <p class="hobbies-veil-caption">{item.caption}</p>
                        </div>
                      ) : null}
                    </div>
                  ))}
                </div>
              ) : null}

              {hobby.media.length > 1 && (
                <div class="hobbies-controls">
                  <button type="button" class="hobbies-nav" data-media-prev aria-label="Previous photo">
                    ←
                  </button>
                  <div class="hobbies-dots" data-hobby-thumbs role="tablist" aria-label={`${hobby.label} photos`}>
                    {hobby.media.map((_, mi) => (
                      <button
                        type="button"
                        class:list={['hobbies-dot', { 'hobbies-dot--active': mi === 0 }]}
                        data-thumb-index={mi}
                        aria-label={`${hobby.label} photo ${mi + 1}`}
                      />
                    ))}
                  </div>
                  <button type="button" class="hobbies-nav" data-media-next aria-label="Next photo">
                    →
                  </button>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</div>

<script is:inline data-astro-rerun>
  (function () {
    const root = document.querySelector('[data-hobby-window]');
    if (!root) return;

    if (window.__lumenHobbiesAbort) window.__lumenHobbiesAbort.abort();
    const ac = new AbortController();
    window.__lumenHobbiesAbort = ac;
    const { signal } = ac;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const hobbyIds = ['eating', 'sports', 'gardening', 'music'];
    const btns = root.querySelectorAll('[data-hobby-btn]');
    const panes = root.querySelectorAll('[data-hobby-pane]');

    const pauseVideosIn = (pane) => {
      pane.querySelectorAll('[data-hobby-video]').forEach((v) => v.pause());
    };

    const clearCaptions = (scope) => {
      (scope || root).querySelectorAll('.hobbies-slide.is-captioned').forEach((el) => {
        el.classList.remove('is-captioned');
      });
    };

    // Hover shows the veil via CSS. On touch, tap toggles a pinned caption.
    if (!canHover) {
      root.querySelectorAll('[data-media-item]').forEach((slide) => {
        if (!slide.querySelector('.hobbies-veil')) return;
        slide.addEventListener('click', (e) => {
          if (e.target.closest('video, .hobbies-nav, .hobbies-dot, a, button')) return;
          const on = !slide.classList.contains('is-captioned');
          clearCaptions(slide.closest('[data-hobby-pane]') || root);
          slide.classList.toggle('is-captioned', on);
        }, { signal });
      });
    } else {
      // Belt-and-suspenders: never leave a pinned dimmer on desktop.
      clearCaptions(root);
    }

    // Soften framing for very wide shots; 4:3 landscape already matches the frame.
    const tagOrient = (img) => {
      if (!(img instanceof HTMLImageElement)) return;
      const apply = () => {
        if (!img.naturalWidth || !img.naturalHeight) return;
        const ratio = img.naturalWidth / img.naturalHeight;
        img.classList.toggle('hobbies-img--ultrawide', ratio >= 1.7);
        img.classList.remove('hobbies-img--wide');
      };
      if (img.complete) apply();
      else img.addEventListener('load', apply, { once: true, signal });
    };
    root.querySelectorAll('.hobbies-img').forEach(tagOrient);

    panes.forEach((pane) => {
      const items = Array.from(pane.querySelectorAll('[data-media-item]'));
      const dots = Array.from(pane.querySelectorAll('[data-thumb-index]'));
      const scroller = pane.querySelector('[data-media-scroller]');
      const prevBtn = pane.querySelector('[data-media-prev]');
      const nextBtn = pane.querySelector('[data-media-next]');
      if (items.length <= 1 || !scroller) return;

      let activeIndex = 0;
      const count = items.length;
      let syncingFromSelect = false;

      const applyActive = (next) => {
        activeIndex = next;
        clearCaptions(pane);
        dots.forEach((d) => {
          const on = Number(d.getAttribute('data-thumb-index')) === next;
          d.classList.toggle('hobbies-dot--active', on);
        });
        items.forEach((item) => {
          const on = Number(item.getAttribute('data-media-index')) === next;
          item.classList.toggle('hobbies-slide--active', on);
          const video = item.querySelector('[data-hobby-video]');
          if (video) {
            if (on) video.play().catch(() => {});
            else video.pause();
          }
        });
      };

      const selectMedia = (idx, { smooth = true } = {}) => {
        const next = ((idx % count) + count) % count;
        applyActive(next);
        syncingFromSelect = true;
        scroller.scrollTo({
          left: next * scroller.clientWidth,
          behavior: smooth && !reduceMotion ? 'smooth' : 'auto',
        });
        const clear = () => { syncingFromSelect = false; };
        if ('onscrollend' in scroller) {
          scroller.addEventListener('scrollend', clear, { once: true, signal });
        } else {
          window.setTimeout(clear, smooth && !reduceMotion ? 420 : 0);
        }
      };

      const indexFromScroll = () => {
        const w = scroller.clientWidth || 1;
        return Math.max(0, Math.min(count - 1, Math.round(scroller.scrollLeft / w)));
      };

      scroller.addEventListener('scroll', () => {
        if (syncingFromSelect) return;
        const next = indexFromScroll();
        if (next !== activeIndex) applyActive(next);
      }, { signal, passive: true });

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          selectMedia(Number(dot.getAttribute('data-thumb-index')));
        }, { signal });
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          selectMedia(activeIndex - 1);
        }, { signal });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          selectMedia(activeIndex + 1);
        }, { signal });
      }

      scroller.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          selectMedia(activeIndex - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          selectMedia(activeIndex + 1);
        }
      }, { signal });
    });

    const select = (id) => {
      if (!hobbyIds.includes(id)) return;

      btns.forEach((btn) => {
        const on = btn.getAttribute('data-hobby') === id;
        btn.classList.toggle('hobbies-tab--active', on);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });

      panes.forEach((pane) => {
        const on = pane.getAttribute('data-hobby-pane') === id;
        pane.classList.toggle('hobbies-pane--active', on);
        pane.setAttribute('aria-hidden', on ? 'false' : 'true');
        if (!on) {
          pauseVideosIn(pane);
          clearCaptions(pane);
        }
      });
    };

    let hoverTimer = null;
    const clearHoverTimer = () => {
      if (hoverTimer !== null) {
        window.clearTimeout(hoverTimer);
        hoverTimer = null;
      }
    };
    signal.addEventListener('abort', clearHoverTimer);

    const activate = (btn) => {
      const id = btn.getAttribute('data-hobby');
      select(id);
      if (history.replaceState) {
        history.replaceState(null, '', '#' + (id === 'eating' ? 'eat' : id));
      }
    };

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        clearHoverTimer();
        activate(btn);
      }, { signal });
      btn.addEventListener('focus', () => {
        clearHoverTimer();
        activate(btn);
      }, { signal });
      if (canHover) {
        btn.addEventListener('mouseenter', () => {
          clearHoverTimer();
          hoverTimer = window.setTimeout(() => {
            hoverTimer = null;
            activate(btn);
          }, 80);
        }, { signal });
        btn.addEventListener('mouseleave', clearHoverTimer, { signal });
      }
    });

    const activeBtn = root.querySelector('.hobbies-tab--active[data-hobby-btn]');
    if (activeBtn) select(activeBtn.getAttribute('data-hobby'));

    const fromHash = () => {
      const raw = (location.hash || '').replace(/^#/, '');
      if (!raw) return;
      select(raw === 'eat' ? 'eating' : raw);
    };
    fromHash();
    window.addEventListener('hashchange', fromHash, { signal });
  })();
</script>
