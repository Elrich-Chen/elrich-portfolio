<div class="statement-pin h-[200vh] relative">
  <section class="section--statement h-screen sticky top-0 flex items-center px-8 lg:px-16 overflow-hidden">
    <p class="absolute top-16 left-8 lg:left-16 m-0 text-[11px] font-medium tracking-[0.16em] uppercase text-lumen-fg-muted pointer-events-none">— 01 / 04</p>
    <p class="absolute top-16 right-8 lg:right-16 m-0 font-serif italic text-[15px] text-lumen-fg-muted pointer-events-none hidden lg:block">Manifesto 2026</p>
    
    <div class="section-inner max-w-[1100px] mx-auto w-full">
      <div class="statement-content">
        <h2 class="statement-line font-serif text-[clamp(48px,5.6vw,84px)] font-normal leading-[1.05] tracking-[-0.02em] text-lumen-fg m-0">
          <span class="statement-word">The</span>
          <span class="statement-word">interface</span>
          <span class="statement-word">disappears.</span>
          <span class="statement-word italic text-lumen-accent">The</span>
          <span class="statement-word italic text-lumen-accent">thinking</span>
          <span class="statement-word italic text-lumen-accent">stays.</span>
        </h2>
        <span class="statement-rule block w-16 h-[1px] bg-lumen-accent my-8 origin-left scale-x-0"></span>
        <p class="statement-caption text-[17px] leading-[1.55] text-lumen-fg-muted max-w-[56ch] m-0 opacity-0 translate-y-4">
          A new kind of computing. One that doesn't demand your attention, but earns it by being there when it matters most.
        </p>
      </div>
    </div>
  </section>
</div>
