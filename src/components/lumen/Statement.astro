---
import ScrollExpand from './ScrollExpand.astro';
// Placeholder — swap when you pick final media.
import ideaMedia from '../../assets/hobbies/music/bruno-mars-1.jpg';
---

<section class="section section--statement" aria-label="Take a look">
  <div class="statement-expand">
    <ScrollExpand
      class="scroll-expand--idea"
      src={ideaMedia.src}
      alt="Placeholder — replace with your idea media"
      title="take a look"
      scrollHint="Scroll"
      useWindowScroll
      startWidth={36}
      startHeight={52}
      startRadius={22}
      endRadius={0}
      mediaZoom={1.35}
      scrollDistance={1.25}
      holdDistance={0.4}
      overlayScrim={0.5}
    >
      <p class="statement-expand-kicker">— Take a look</p>
      <h2>Shown below are some of the things I've worked on.</h2>
      <p>
        <a class="statement-expand-link" href="#projects">Selected work ↓</a>
      </p>
    </ScrollExpand>
  </div>
</section>
