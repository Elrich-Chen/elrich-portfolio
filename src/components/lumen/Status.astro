---
import { getCollection } from 'astro:content';

const [status] = await getCollection('lumen-status');
const data = status?.data ?? {
  state: 'operational' as const,
  label: 'All systems operational',
  detail: 'Status will appear here once published.',
  updated: new Date().toISOString().slice(0, 10),
};

const stateDot =
  data.state === 'operational'
    ? 'bg-emerald-400'
    : data.state === 'degraded'
      ? 'bg-amber-400'
      : 'bg-sky-400';

function formatDate(iso: string) {
  const d = new Date(`${iso}T12:00:00`);
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<section id="status" class="section--status relative py-24 px-8 lg:px-16 border-t border-white/[0.05]">
  <div class="section-inner max-w-[720px] mx-auto w-full">
    <p class="eyebrow text-lumen-accent text-[12px] font-medium tracking-[0.18em] uppercase leading-none m-0 mb-4">— Status</p>
    <h2 class="font-serif text-[clamp(32px,4vw,48px)] font-normal leading-[1.1] tracking-tight text-lumen-fg m-0 mb-8">
      Right now
    </h2>

    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-3">
        <span class={`inline-block w-2.5 h-2.5 rounded-full ${stateDot}`} aria-hidden="true"></span>
        <p class="text-[18px] font-medium text-lumen-fg m-0">{data.label}</p>
      </div>
      <p class="text-[15px] leading-[1.55] text-lumen-fg-muted m-0 max-w-[48ch]">{data.detail}</p>
      <p class="text-[13px] text-lumen-fg-muted/60 m-0 mt-2">
        Updated <time datetime={data.updated}>{formatDate(data.updated)}</time>
      </p>
    </div>
  </div>
</section>
