---
---

<div class="principles-pin">
    <section class="section section--principles" aria-labelledby="principles-heading">
      <p class="section-index" aria-hidden="true">— 04 / 05</p>
      <h2 id="principles-heading" class="sr-only">What makes Lumen different</h2>
      <div class="section-inner">
        <div class="principles-grid">
          <article class="principle" data-reveal>
            <p class="principle-number">01</p>
            <h3 class="principle-title">Speaks first, asks second.</h3>
            <p class="principle-desc">Reads what you're working on. Suggests the next step before you can frame the
              question.</p>
            <div class="principle-detail principle-detail--shortcut">
              <kbd class="kbd">⌘</kbd><kbd class="kbd">.</kbd>
              <span class="principle-detail-label">from any app</span>
            </div>
          </article>
          <article class="principle" data-reveal>
            <p class="principle-number">02</p>
            <h3 class="principle-title">Lives in your context.</h3>
            <p class="principle-desc">Files, browser tabs, terminal output — Lumen sees what you see, so you don't
              translate.</p>
            <div class="principle-detail principle-detail--tags">
              <span class="tag">current file</span>
              <span class="tag">selection</span>
              <span class="tag">terminal</span>
              <span class="tag">clipboard</span>
            </div>
          </article>
          <article class="principle" data-reveal>
            <p class="principle-number">03</p>
            <h3 class="principle-title">Learns your shorthand.</h3>
            <p class="principle-desc">The more you use it, the less you have to say. Custom commands, your phrasing,
              your stack.</p>
            <div class="principle-detail principle-detail--examples">
              <div class="shorthand-row">
                <code class="shorthand-key">rfc</code>
                <span class="shorthand-arrow">→</span>
                <span class="shorthand-val">opens RFC template</span>
              </div>
              <div class="shorthand-row">
                <code class="shorthand-key">ship it</code>
                <span class="shorthand-arrow">→</span>
                <span class="shorthand-val">runs CI, opens PR</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>
