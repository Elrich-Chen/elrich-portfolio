---
---

<div class="hero-pin">
  <main class="hero" id="top">
    <div class="hero-top">
      <a class="logo" href="#top" aria-label="Home">
        <span class="logo-mark" aria-hidden="true">◆</span>
        <span>Elrich</span>
      </a>
    </div>

    <div class="hero-grid">
      <section class="copy">
        <p class="eyebrow">— Hi wanderer, settle in. I’m</p>
        <h1>
          <span class="h1-line">
            <em class="word accent" style="--i:1">Elrich</em>.
          </span>
        </h1>
        <p class="subtext">
          CS @ <a class="subtext-link" href="https://uwaterloo.ca" target="_blank" rel="noopener noreferrer">UWaterloo</a>.
          <a class="subtext-link" href="#experience">CxC</a> Co-Chair.
          Plays <a class="subtext-link" href="#sports">sports</a> so he can <a class="subtext-link" href="#eat">eat</a>.
        </p>
        <div class="ctas">
          <a class="btn btn-primary" href="#projects">View work</a>
          <a class="btn btn-ghost" href="#cta-heading">Get in touch</a>
        </div>
      </section>

      <div class="spline-col">
        <div class="spline-wrap">
          <div id="spline-poster" aria-hidden="true">
            <div class="poster-hint" aria-hidden="true"></div>
          </div>
          <canvas id="spline-canvas" aria-hidden="true"></canvas>
          <div class="pc-chat" data-pc-chat role="status" aria-live="polite">
            <p class="pc-chat-bubble">
              <em class="pc-chat-hi">I’m Pixel.</em>
              <span class="pc-chat-rest">Try any key <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd></span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
  import { Application } from '@splinetool/runtime';

  const SCENE_URL = 'https://prod.spline.design/jQxUG3hwx263Jw5Z/scene.splinecode';
  // MacBook stays at 0.52. Touch tablets share the side-by-side hero with a
  // mild pull-back so the desk isn't oversized; phones crop via CSS.
  const isPhone = window.matchMedia('(max-width: 720px)').matches;
  const isIPhone14ProMaxWidth = window.matchMedia('(min-width: 430px) and (max-width: 430px)').matches;
  const isTouchUI = window.matchMedia('(hover: none)').matches;
  const isMidWidth = window.matchMedia('(min-width: 768px) and (max-width: 1199px)').matches;
  const isTabletTuneRange = window.matchMedia('(min-width: 767px) and (max-width: 1192px)').matches;
  const isCompactDesktopWidth = window.matchMedia('(min-width: 1200px) and (max-width: 1295px)').matches;
  const isWideDesktop = window.matchMedia('(min-width: 1800px)').matches;
  const isIOS =
    /iPad|iPhone|iPod/.test(navigator.userAgent) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  // Mid widths need a stronger pull-back so the full desk fits the
  // smaller column (esp. iPad Pro 1024) without clipping the platform.
  // Scale gently across tablets; iPad Pro needs the scene to use the full
  // canvas instead of sitting as a small island in its lower-left corner.
  const midWidthZoom = Math.min(
    0.48,
    Math.max(0.4, 0.4 + ((window.innerWidth - 768) / (1024 - 768)) * 0.08),
  );
  // Preserve the original MacBook camera through 1799px. Only external-width
  // displays interpolate toward a closer framing.
  const wideDesktopZoom = Math.min(
    1.1,
    Math.max(0.65, 0.65 + ((window.innerWidth - 1800) / (2320 - 1800)) * 0.45),
  );
  const CAMERA_ZOOM = isIPhone14ProMaxWidth
    ? 0.85
    : isPhone
      ? 0.62
    : isTabletTuneRange
      ? 0.34
      : isMidWidth
        ? midWidthZoom
        : isCompactDesktopWidth
          ? 0.44
        : isWideDesktop
          ? wideDesktopZoom
          : 0.52;
  const MAX_ATTEMPTS = 4;

  // Laptop/desktop only gets keyboard click audio. Phones/iPads stay muted
  // (autoplay + Howler spam, and no real keyboard anyway).
  const allowSplineAudio =
    window.matchMedia('(min-width: 1200px)').matches &&
    window.matchMedia('(hover: hover)').matches &&
    !isIOS;

  type HeroWin = Window & {
    __lumenHeroAbort?: AbortController;
    __lumenHeroBound?: boolean;
    __lumenHeroApp?: { dispose?: () => void } | null;
    Howler?: {
      mute?: (muted: boolean) => void;
      volume?: (v: number) => void;
      stop?: () => void;
      ctx?: { state?: string; resume?: () => Promise<void> };
      _audioUnlocked?: boolean;
    };
  };

  function silenceSplineAudio() {
    if (allowSplineAudio) return;
    try {
      const Howler = (window as HeroWin).Howler;
      if (!Howler) return;
      Howler.mute?.(true);
      Howler.volume?.(0);
      Howler.stop?.();
    } catch {
      /* ignore */
    }
  }

  function enableSplineAudio() {
    if (!allowSplineAudio) return;
    try {
      const Howler = (window as HeroWin).Howler;
      if (!Howler) return;
      Howler.mute?.(false);
      Howler.volume?.(1);
      const ctx = Howler.ctx;
      if (ctx?.state === 'suspended') ctx.resume?.().catch(() => {});
    } catch {
      /* ignore */
    }
  }

  function unlockSplineAudioOnGesture(signal: AbortSignal) {
    if (!allowSplineAudio) return;
    const unlock = () => {
      enableSplineAudio();
      window.removeEventListener('keydown', unlock);
      window.removeEventListener('pointerdown', unlock);
    };
    window.addEventListener('keydown', unlock, { passive: true, signal });
    window.addEventListener('pointerdown', unlock, { passive: true, signal });
  }

  const wait = (ms: number, signal: AbortSignal) =>
    new Promise<void>((resolve, reject) => {
      if (signal.aborted) {
        reject(new DOMException('Aborted', 'AbortError'));
        return;
      }
      const t = window.setTimeout(() => resolve(), ms);
      signal.addEventListener(
        'abort',
        () => {
          window.clearTimeout(t);
          reject(new DOMException('Aborted', 'AbortError'));
        },
        { once: true },
      );
    });

  const frame = (signal: AbortSignal) =>
    new Promise<void>((resolve, reject) => {
      if (signal.aborted) {
        reject(new DOMException('Aborted', 'AbortError'));
        return;
      }
      requestAnimationFrame(() => resolve());
    });

  async function waitForCanvasSize(canvas: HTMLElement, signal: AbortSignal) {
    for (let i = 0; i < 90; i++) {
      if (signal.aborted) throw new DOMException('Aborted', 'AbortError');
      const rect = canvas.getBoundingClientRect();
      if (rect.width >= 8 && rect.height >= 8) return;
      await frame(signal);
    }
  }

  function disposeHeroApp() {
    const w = window as HeroWin;
    try {
      w.__lumenHeroApp?.dispose?.();
    } catch {
      /* ignore */
    }
    w.__lumenHeroApp = null;
  }

  function tuneCamera(app: InstanceType<typeof Application>) {
    try {
      const candidates = [app?._scene, app?.scene, app?._renderer?.scene].filter(Boolean);
      const findCamera = (root: { traverse?: (cb: (obj: any) => void) => void }) => {
        let found: any = null;
        root.traverse?.((obj) => {
          if (found) return;
          if (obj.isCamera || obj.type?.endsWith('Camera')) found = obj;
        });
        return found;
      };
      let cam = (app as any)?._camera || (app as any)?.camera || null;
      for (const root of candidates) {
        if (cam) break;
        cam = findCamera(root as any);
      }
      if (!cam) return;
      if (cam.isOrthographicCamera || cam.type === 'OrthographicCamera') {
        cam.zoom = (cam.zoom || 1) * CAMERA_ZOOM;
        cam.updateProjectionMatrix?.();
      } else if (cam.position) {
        const f = 1 / CAMERA_ZOOM;
        cam.position.x *= f;
        cam.position.y *= f;
        cam.position.z *= f;
        cam.updateProjectionMatrix?.();
      }
    } catch (e) {
      console.warn('Spline camera zoom adjustment skipped:', e);
    }
  }

  function clearBackground(app: InstanceType<typeof Application>, canvas: HTMLCanvasElement) {
    try {
      (app as any).setBackgroundColor?.(null);
      const scene = (app as any)?._scene || (app as any)?.scene;
      if (scene) scene.background = null;
      const renderer = (app as any)?._renderer || (app as any)?.renderer;
      // iPhone 14/Pro Safari is much happier at DPR 1 on this scene;
      // 1.5–3x backing stores often lose the WebGL context mid-load.
      const dprCap = isIOS ? 1 : isTouchUI ? 1.25 : 2;
      const dpr = Math.min(window.devicePixelRatio || 1, dprCap);
      renderer?.setPixelRatio?.(dpr);
      renderer?.setClearColor?.(0x000000, 0);
      canvas.style.background = 'transparent';
    } catch {
      /* ignore */
    }
  }

  async function mountSpline(
    canvas: HTMLCanvasElement,
    poster: HTMLElement | null,
    signal: AbortSignal,
  ) {
    await waitForCanvasSize(canvas, signal);

    let lastError: unknown;
    for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
      if (signal.aborted) throw new DOMException('Aborted', 'AbortError');
      disposeHeroApp();

      try {
        const app = new Application(canvas);
        (window as HeroWin).__lumenHeroApp = app;
        silenceSplineAudio();
        await app.load(SCENE_URL);
        silenceSplineAudio();
        enableSplineAudio();
        if (signal.aborted || !document.contains(canvas)) {
          disposeHeroApp();
          throw new DOMException('Aborted', 'AbortError');
        }

        tuneCamera(app);
        clearBackground(app, canvas);
        silenceSplineAudio();
        enableSplineAudio();
        // Force a resize after layout settles — iPhone 14 often mounts
        // before the absolute crop wrap has its final box.
        (app as any).resize?.();
        await frame(signal);
        (app as any).resize?.();

        if (poster && document.contains(poster)) {
          poster.style.opacity = '0';
          window.setTimeout(() => {
            if (!signal.aborted && poster.isConnected) poster.remove();
          }, 400);
        }

        return app;
      } catch (err) {
        lastError = err;
        if (signal.aborted) throw err;
        disposeHeroApp();
        if (attempt < MAX_ATTEMPTS) await wait(450 * attempt, signal);
      }
    }

    throw lastError instanceof Error ? lastError : new Error('Spline failed to load');
  }

  function wireVisibility(app: InstanceType<typeof Application>, canvas: HTMLCanvasElement, signal: AbortSignal) {
    const heroEl = document.querySelector('.hero');
    if (!(heroEl instanceof HTMLElement)) return;

    let liveApp: InstanceType<typeof Application> = app;
    let splineActive = true;
    let remounts = 0;
    let remounting = false;

    const forwardPointer = (e: PointerEvent) => {
      if (!splineActive || signal.aborted) return;
      canvas.dispatchEvent(
        new PointerEvent('pointermove', {
          clientX: e.clientX,
          clientY: e.clientY,
          pointerType: e.pointerType || 'mouse',
          bubbles: true,
          cancelable: true,
        }),
      );
    };
    // pointermove covers mouse + touch-drag on iOS/iPadOS.
    heroEl.addEventListener('pointermove', forwardPointer, { passive: true, signal });

    const tryPause = () => {
      try {
        const a = liveApp as any;
        if (typeof a.stop === 'function') {
          a.stop();
          return true;
        }
        if (typeof a.pause === 'function') {
          a.pause();
          return true;
        }
        if (a._renderer?.setAnimationLoop) {
          a._renderer.setAnimationLoop(null);
          return true;
        }
      } catch {
        /* ignore */
      }
      return false;
    };
    const tryResume = () => {
      try {
        const a = liveApp as any;
        if (typeof a.play === 'function') {
          a.play();
          return true;
        }
        if (typeof a.start === 'function') {
          a.start();
          return true;
        }
        if (typeof a.resume === 'function') {
          a.resume();
          return true;
        }
      } catch {
        /* ignore */
      }
      return false;
    };

    // Remount if Safari drops the context (seen on iPhone 14 under memory pressure).
    const onContextLost = (e: Event) => {
      e.preventDefault();
      if (signal.aborted || remounting || remounts >= 2) return;
      remounting = true;
      remounts += 1;
      console.warn('Spline WebGL context lost — remounting');
      disposeHeroApp();
      window.setTimeout(() => {
        if (signal.aborted || !document.contains(canvas)) {
          remounting = false;
          return;
        }
        mountSpline(canvas, null, signal)
          .then((next) => {
            liveApp = next;
            remounting = false;
            if (splineActive) tryResume();
            else tryPause();
          })
          .catch(() => {
            remounting = false;
          });
      }, 350);
    };
    canvas.addEventListener('webglcontextlost', onContextLost, { signal });

    if (!('IntersectionObserver' in window)) return;

    let active = true;
    const splineIO = new IntersectionObserver(
      (entries) => {
        if (signal.aborted) return;
        const inView = !!entries[0]?.isIntersecting;
        if (inView === active) return;
        active = inView;
        splineActive = inView;
        // Never opacity-hide the canvas on iOS — that can drop the context.
        // Pause the loop instead; leave the last frame visible.
        if (!isIOS) {
          canvas.style.opacity = inView ? '1' : '0';
        }
        canvas.style.pointerEvents = inView ? '' : 'none';
        if (inView) tryResume();
        else tryPause();
      },
      { rootMargin: '0px', threshold: 0.01 },
    );
    splineIO.observe(heroEl);
    signal.addEventListener('abort', () => splineIO.disconnect());
  }

  function initHeroChat() {
    const isTouch = window.matchMedia('(hover: none)').matches;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const chat = document.querySelector('[data-pc-chat]');
    if (!(chat instanceof HTMLElement)) return;
    const rest = chat.querySelector('.pc-chat-rest');
    if (rest instanceof HTMLElement && isTouch) {
      rest.textContent = 'Drag to look around';
    }
    if (isTouch) return;
    const revealChat = () => chat.classList.add('pc-chat--in');
    if (reduceMotion) revealChat();
    else window.setTimeout(revealChat, 520);
  }

  function initHero() {
    const canvas = document.getElementById('spline-canvas');
    const poster = document.getElementById('spline-poster');
    if (!(canvas instanceof HTMLCanvasElement)) {
      disposeHeroApp();
      return;
    }

    // Already live on this canvas after a duplicate page-load.
    if ((window as HeroWin).__lumenHeroApp && document.contains(canvas)) {
      return;
    }

    if ((window as HeroWin).__lumenHeroAbort) {
      (window as HeroWin).__lumenHeroAbort!.abort();
    }
    const ac = new AbortController();
    (window as HeroWin).__lumenHeroAbort = ac;
    const { signal } = ac;
    signal.addEventListener('abort', disposeHeroApp);

    initHeroChat();
    unlockSplineAudioOnGesture(signal);

    mountSpline(canvas, poster instanceof HTMLElement ? poster : null, signal)
      .then((app) => {
        if (signal.aborted || !document.contains(canvas)) {
          disposeHeroApp();
          return;
        }
        enableSplineAudio();
        wireVisibility(app, canvas, signal);
      })
      .catch((err) => {
        if (signal.aborted) return;
        console.error('Spline failed to load:', err);
        // Keep the poster visible so the hero never looks empty.
        if (poster instanceof HTMLElement) poster.style.opacity = '1';
      });
  }

  initHero();
  if (!(window as HeroWin).__lumenHeroBound) {
    (window as HeroWin).__lumenHeroBound = true;
    document.addEventListener('astro:page-load', initHero);
    document.addEventListener('astro:before-swap', () => {
      (window as HeroWin).__lumenHeroAbort?.abort();
      (window as HeroWin).__lumenHeroAbort = undefined;
      disposeHeroApp();
    });
  }
</script>
