---
import CaseLineNav from './CaseLineNav.astro';

interface Props {
  title: string;
  tagline?: string;
  eyebrow: string;
  backHref: string;
  backLabel: string;
  meta?: string[];
  live?: boolean;
  award?: string;
  image?: string;
  imageAlt?: string;
  imageFit?: 'cover' | 'contain';
  gallery?: string[];
  externalHref?: string;
  externalLabel?: string;
  highlights?: string[];
  tags?: string[];
  ctaHref?: string;
  ctaLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  footerBackHref: string;
  footerBackLabel: string;
}

const {
  title,
  tagline,
  eyebrow,
  backHref,
  backLabel,
  meta = [],
  live = false,
  award,
  image,
  imageAlt,
  imageFit = 'cover',
  gallery = [],
  externalHref,
  externalLabel = 'Open →',
  highlights = [],
  tags = [],
  ctaHref,
  ctaLabel = 'Visit',
  secondaryHref,
  secondaryLabel = 'Devpost →',
  footerBackHref,
  footerBackLabel,
} = Astro.props;

const hasHighlights = highlights.length > 0;
const hasCtas = Boolean(ctaHref) || Boolean(secondaryHref);
const hasMetaAside = tags.length > 0 || hasCtas;
const mediaCompact = imageFit === 'contain';
---

<main class="case-study" id="top">
  <header class="case-top">
    <a class="case-back" href={backHref}>{backLabel}</a>
    <a class="logo case-logo" href="/">
      <span class="logo-mark" aria-hidden="true">◆</span>
      <span>Elrich</span>
    </a>
  </header>

  <div class="case-hero">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="case-title">{title}</h1>
    {tagline && <p class="case-tagline">{tagline}</p>}

    {award && <p class="case-award">{award}</p>}

    {(meta.length > 0 || live) && (
      <div class="case-meta">
        {meta.map((item) => (
          <span>{item}</span>
        ))}
        {live && <span class="case-meta-live">Live</span>}
      </div>
    )}
  </div>

  {image && (
    <div class:list={['case-media', { 'case-media--compact': mediaCompact, 'case-media--solo': !externalHref }]}>
      <figure class:list={['case-figure', { 'case-figure--contain': mediaCompact }]}>
        <img src={image} alt={imageAlt ?? `${title} preview`} loading="eager" />
      </figure>
      {externalHref && (
        <a
          class="case-figure case-figure--link"
          href={externalHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="case-figure-label">{externalLabel}</span>
        </a>
      )}
    </div>
  )}

  {gallery.length > 0 && (
    <div class="case-gallery">
      {gallery.map((src) => (
        <img src={src} alt={`${title} photo`} loading="lazy" decoding="async" />
      ))}
    </div>
  )}

  {hasHighlights && (
    <section class="case-highlights" aria-labelledby="case-highlights-label">
      <p class="case-highlights-label" id="case-highlights-label">Highlights</p>
      <ul>
        {highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
  )}

  <div class:list={['case-body', { 'case-body--after-highlights': hasHighlights }]}>
    <CaseLineNav />
    <div class="case-side">
      <div class="case-prose">
        <slot />
      </div>

      {hasMetaAside && (
        <aside class="case-aside">
          {tags.length > 0 && (
            <div class="case-tags">
              {tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
          {hasCtas && (
            <div class="case-ctas">
              {ctaHref && (
                <a class="btn btn-primary" href={ctaHref} target="_blank" rel="noopener noreferrer">
                  {ctaLabel}
                </a>
              )}
              {secondaryHref && secondaryHref !== ctaHref && (
                <a class="btn btn-ghost" href={secondaryHref} target="_blank" rel="noopener noreferrer">
                  {secondaryLabel}
                </a>
              )}
            </div>
          )}
        </aside>
      )}
    </div>
  </div>

  <nav class="case-footer-nav" aria-label="Case study navigation">
    <a href={footerBackHref}>{footerBackLabel}</a>
    <a href="/#cta-heading">Get in touch →</a>
  </nav>
</main>
