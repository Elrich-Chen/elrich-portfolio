---
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => {
    const ao = a.data.order ?? 999;
    const bo = b.data.order ?? 999;
    if (ao !== bo) return ao - bo;
    return (b.data.year ?? '').localeCompare(a.data.year ?? '');
  })
  .slice(0, 8);

const hackParts = Array.from({ length: 6 }, (_, i) => i);
---

<section class="section section--projects" id="projects" aria-labelledby="projects-heading">
  <div class="section-inner projects-inner" data-reveal>
    <div class="section-head">
      <p class="eyebrow">— Projects</p>
      <h2 id="projects-heading" class="projects-h2">
        Selected <em class="accent">work</em>.
      </h2>
    </div>

    <p class="projects-caption">Click through for the full case study.</p>

    <ul class="project-list" role="list" data-project-list>
      {projects.map((project) => {
        const hackathonName = project.data.hackathon;
        const isHackathon = Boolean(hackathonName);
        const award = project.data.award;
        const image = project.data.image;
        return (
          <li>
            <a
              class:list={[
                'project-row',
                { 'project-row--hackathon': isHackathon },
                { 'project-row--award': Boolean(award) },
              ]}
              href={`/projects/${project.slug}`}
            >
              <span class="project-row-name-wrap">
                <span class="project-row-name">{project.data.name}</span>
                {award && (
                  <span class="project-award-chip">{award}</span>
                )}
              </span>
              <span class="project-row-tagline">
                {project.data.tagline ?? project.data.category ?? 'Case study'}
              </span>
              <span class="project-row-arrow" aria-hidden="true">→</span>

              {isHackathon && (
                <span class="project-hack-flow" aria-hidden="true">
                  <span class="project-hack-flow-track">
                    {hackParts.map(() => (
                      <span class="project-hack-flow-part">
                        <span>{hackathonName}</span>
                        {image && (
                          <span
                            class="project-hack-flow-img"
                            style={`background-image: url(${image})`}
                          />
                        )}
                      </span>
                    ))}
                  </span>
                </span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script is:inline data-astro-rerun>
  (function () {
    if (window.__lumenProjectsAbort) window.__lumenProjectsAbort.abort();
    const ac = new AbortController();
    window.__lumenProjectsAbort = ac;
    const { signal } = ac;

    const list = document.querySelector('[data-project-list]');
    if (!list) return;

    // iOS/Android have no hover — paint the desktop hover treatment on press.
    const coarse = window.matchMedia('(hover: none), (pointer: coarse)').matches;
    if (!coarse) return;

    let hot = null;
    const clearHot = () => {
      if (!hot) return;
      hot.classList.remove('is-hot');
      hot = null;
    };

    list.addEventListener(
      'pointerdown',
      (event) => {
        const row = event.target instanceof Element ? event.target.closest('.project-row') : null;
        if (!row || !list.contains(row)) return;
        clearHot();
        hot = row;
        row.classList.add('is-hot');
      },
      { signal },
    );

    list.addEventListener(
      'pointerup',
      () => {
        // Keep the flash through the tap so the marquee/invert is visible.
        window.setTimeout(clearHot, 180);
      },
      { signal },
    );

    list.addEventListener('pointercancel', clearHot, { signal });
    list.addEventListener(
      'pointerleave',
      (event) => {
        if (event.target === list) clearHot();
      },
      { signal },
    );
  })();
</script>
