---
import { getCollection } from 'astro:content';

const entries = (await getCollection('lumen-changelog')).sort(
  (a, b) => b.data.date.localeCompare(a.data.date)
);

function formatDate(iso: string) {
  const d = new Date(`${iso}T12:00:00`);
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<section id="changelog" class="section--changelog relative py-28 px-8 lg:px-16">
  <div class="section-inner max-w-[720px] mx-auto w-full">
    <p class="eyebrow text-lumen-accent text-[12px] font-medium tracking-[0.18em] uppercase leading-none m-0 mb-4">— Changelog</p>
    <h2 class="font-serif text-[clamp(32px,4vw,48px)] font-normal leading-[1.1] tracking-tight text-lumen-fg m-0 mb-3">
      What’s shipping
    </h2>
    <p class="text-[16px] text-lumen-fg-muted m-0 mb-12 max-w-[42ch]">
      Short notes on what landed. No fluff.
    </p>

    {entries.length === 0 ? (
      <p class="text-[15px] text-lumen-fg-muted m-0">Updates will appear here as we ship.</p>
    ) : (
      <ol class="list-none p-0 m-0 flex flex-col gap-0 border-t border-white/10">
        {entries.map((entry) => (
          <li class="grid grid-cols-1 sm:grid-cols-[7.5rem,1fr] gap-2 sm:gap-8 py-6 border-b border-white/10">
            <time datetime={entry.data.date} class="text-[13px] text-lumen-fg-muted tabular-nums pt-1">
              {formatDate(entry.data.date)}
            </time>
            <div>
              <h3 class="text-[17px] font-medium text-lumen-fg m-0 mb-1.5 tracking-tight">{entry.data.title}</h3>
              <p class="text-[15px] leading-[1.55] text-lumen-fg-muted m-0">{entry.data.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    )}
  </div>
</section>
