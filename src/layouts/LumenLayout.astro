---
import PostHog from '../components/posthog.astro';
import '../styles/lumen.css';

const { title = 'Lumen — AI that lives on your desktop' } = Astro.props;
---

<!doctype html>
<html lang="en" class="lumen-site">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="AI desktop companion that lives where you work." />
    <link rel="icon" type="image/svg+xml" href="/e.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body id="top" class="min-h-screen bg-lumen-bg text-lumen-fg antialiased">
    <div class="lumen-noise" aria-hidden="true"></div>
    <div id="cursor-accent" class="cursor-accent" aria-hidden="true"></div>

    <div
      id="page-thread"
      class="fixed top-0 right-6 z-[100] h-screen w-[1.5px] origin-top scale-y-0 bg-lumen-accent pointer-events-none"
      aria-hidden="true"
    ></div>

    <nav
      id="site-nav"
      class="pointer-events-none fixed top-0 right-0 left-0 z-50 flex h-14 -translate-y-full items-center justify-between gap-6 border-b border-lumen-border bg-lumen-bg/90 px-8 opacity-0 backdrop-blur-md transition-all duration-[380ms] ease-lumen lg:px-16"
    >
      <a href="#top" class="flex items-center gap-2 text-[15px] font-medium tracking-tight text-lumen-fg no-underline">
        <span class="flex h-[22px] w-[22px] items-center justify-center rounded-md bg-lumen-fg text-[13px] font-semibold text-lumen-bg">◆</span>
        <span>Lumen</span>
      </a>

      <div class="hidden items-center gap-7 sm:flex">
        <a href="#features" class="text-[13.5px] text-lumen-fg-muted no-underline transition-colors hover:text-lumen-fg">Features</a>
        <a href="#changelog" class="text-[13.5px] text-lumen-fg-muted no-underline transition-colors hover:text-lumen-fg">Changelog</a>
        <a href="#status" class="text-[13.5px] text-lumen-fg-muted no-underline transition-colors hover:text-lumen-fg">Status</a>
      </div>

      <div class="flex items-center">
        <a
          href="#cta"
          class="inline-flex h-[34px] items-center justify-center rounded-md bg-lumen-accent px-3.5 text-[13px] font-medium text-lumen-bg no-underline transition-all hover:brightness-110"
        >
          Get early access
        </a>
      </div>
    </nav>

    <main class="relative z-10">
      <slot />
    </main>

    <PostHog />

    <script>
      const accent = document.getElementById('cursor-accent');
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      if (accent && canHover) {
        let x = 0;
        let y = 0;
        let raf = 0;

        const render = () => {
          accent.style.transform = `translate3d(${x}px, ${y}px, 0) scale(1)`;
          raf = 0;
        };

        window.addEventListener(
          'pointermove',
          (event) => {
            x = event.clientX;
            y = event.clientY;
            accent.classList.add('is-active');
            if (!raf) raf = requestAnimationFrame(render);
          },
          { passive: true }
        );

        window.addEventListener('pointerleave', () => {
          accent.classList.remove('is-active');
        });
      }
    </script>
  </body>
</html>
