---
import { ClientRouter } from 'astro:transitions';
import PostHog from '../components/posthog.astro';
import '../styles/lumen.css';

const { title = 'Elrich — Portfolio' } = Astro.props;

/* Case pages: open from the bottom, close top→down (sheet drops away). */
const sheet = {
  forwards: {
    old: {
      name: 'lumenSheetIdle',
      duration: '0.6s',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
    new: {
      name: 'lumenSheetIn',
      duration: '0.6s',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
  },
  backwards: {
    old: {
      name: 'lumenSheetOut',
      duration: '0.5s',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
    new: {
      name: 'lumenSheetIdle',
      duration: '0.5s',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
  },
};
---

<!doctype html>
<html lang="en" transition:name="lumen-sheet" transition:animate={sheet}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content="Designer & builder. Interfaces, experiments, and the quiet spaces between." />
    <link rel="icon" type="image/svg+xml" href="/e.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://prod.spline.design" crossorigin />
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <div class="page-noise" aria-hidden="true"></div>
    <div class="page-thread" aria-hidden="true" data-page-thread></div>

    <header class="site-nav" data-nav aria-label="Site navigation">
      <a class="site-nav-brand" href="/#top">
        <span class="logo-mark" aria-hidden="true">◆</span>
        <span>Elrich</span>
      </a>
      <nav class="site-nav-links">
        <a href="/#experience">Work</a>
        <a href="/#projects">Projects</a>
        <a href="/#hobbies">Life</a>
      </nav>
      <div class="site-nav-actions">
        <a class="btn btn-primary btn-sm" href="/#cta-heading">Contact</a>
      </div>
    </header>

    <slot />

    <PostHog />

    <script is:inline>
      // Soft navigations (case study ↔ home) swap the DOM without a full
      // reload. [data-reveal] starts at opacity:0 — without re-revealing
      // here, the homepage looks like a black screen after "Back".
      document.addEventListener('astro:after-swap', function () {
        document.querySelectorAll('[data-reveal]').forEach(function (el) {
          el.style.transition = 'none';
          el.classList.add('in-view');
        });
      });

      // Link clicks are "forward" by default, so ← Back was sliding the
      // next page up from the bottom. Leaving a case page should always
      // dismiss top→down; entering one should always rise from the bottom.
      document.addEventListener('astro:before-preparation', function (event) {
        var isCasePath = function (pathname) {
          return pathname.indexOf('/projects/') === 0 || pathname.indexOf('/experience/') === 0;
        };
        var fromCase = !!document.querySelector('.case-study');
        var toCase = isCasePath(event.to.pathname);
        if (fromCase && !toCase) event.direction = 'back';
        if (!fromCase && toCase) event.direction = 'forward';
      });
    </script>
  </body>
</html>
