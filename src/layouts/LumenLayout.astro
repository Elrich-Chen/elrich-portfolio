---
import { ClientRouter } from 'astro:transitions';
import PostHog from '../components/posthog.astro';
import '../styles/lumen.css';

const { title = 'Elrich — Portfolio', robots } = Astro.props;

/* Case pages: open from the bottom, close top→down (sheet drops away). */
const sheet = {
  forwards: {
    old: {
      name: 'lumenSheetIdle',
      duration: '0.6s',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
    new: {
      name: 'lumenSheetIn',
      duration: '0.6s',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
  },
  backwards: {
    old: {
      name: 'lumenSheetOut',
      duration: '0.5s',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
    new: {
      name: 'lumenSheetIdle',
      duration: '0.5s',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
  },
};
---

<!doctype html>
<html lang="en" transition:name="lumen-sheet" transition:animate={sheet}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {robots ? <meta name="robots" content={robots} /> : null}
    <meta name="description" content="Designer & builder. Interfaces, experiments, and the quiet spaces between." />
    <link rel="icon" type="image/svg+xml" href="/e.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://prod.spline.design" crossorigin />
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <!-- Prefetch on by ClientRouter; animate fallback for non-VT browsers. -->
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <div class="page-noise" aria-hidden="true"></div>
    <div class="page-thread" aria-hidden="true" data-page-thread></div>

    <header class="site-nav" data-nav aria-label="Site navigation">
      <a class="site-nav-brand" href="/#top">
        <span class="logo-mark" aria-hidden="true">◆</span>
        <span>Elrich</span>
      </a>
      <nav class="site-nav-links">
        <a href="/#experience">Work</a>
        <a href="/#projects">Projects</a>
        <a href="/#hobbies">Life</a>
      </nav>
      <div class="site-nav-actions">
        <a class="btn btn-primary btn-sm" href="/#cta-heading">Contact</a>
      </div>
    </header>

    <slot />

    <PostHog />

    <script is:inline>
      /**
       * Lumen soft-nav spine.
       * Runs once, survives ClientRouter swaps, and keeps case ↔ home
       * transitions, hash landing, and reveal state consistent.
       */
      (function () {
        if (window.__lumenRouterBound) return;
        window.__lumenRouterBound = true;

        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion) document.documentElement.dataset.reducedMotion = '';

        var pendingSwap = false;
        var navTimer = 0;

        function isCasePath(pathname) {
          return (
            pathname.indexOf('/projects/') === 0 ||
            pathname.indexOf('/experience/') === 0
          );
        }

        function setNavigating(on) {
          if (on) document.documentElement.dataset.navigating = '';
          else delete document.documentElement.dataset.navigating;
        }

        function revealAfterSoftNav() {
          document.querySelectorAll('[data-reveal]').forEach(function (el) {
            el.style.transition = 'none';
            el.classList.add('in-view');
          });
        }

        function navOffset() {
          var nav = document.querySelector('[data-nav]');
          if (!nav) return 12;
          var h = nav.getBoundingClientRect().height || 0;
          return Math.round(h) + 12;
        }

        function scrollToHashOnce() {
          var hash = window.location.hash;
          if (!hash || hash.length < 2) return false;
          var id;
          try {
            id = decodeURIComponent(hash.slice(1));
          } catch (e) {
            id = hash.slice(1);
          }
          if (!id) return false;
          var target = document.getElementById(id);
          if (!target) return false;
          var top = target.getBoundingClientRect().top + window.scrollY - navOffset();
          window.scrollTo({ top: Math.max(0, top), left: 0, behavior: 'auto' });
          return true;
        }

        function scrollToHashReliable() {
          if (scrollToHashOnce()) return;
          var tries = 0;
          function tick() {
            tries += 1;
            if (scrollToHashOnce() || tries > 16) return;
            requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
        }

        function clearTransientUi() {
          // Hover previews / open menus can linger visually across swaps.
          document.querySelectorAll('.project-preview.is-active').forEach(function (el) {
            el.classList.remove('is-active');
          });
        }

        document.addEventListener('astro:before-preparation', function (event) {
          var fromCase = !!document.querySelector('.case-study');
          var toCase = isCasePath(event.to.pathname);
          // Sheet direction: cases rise in, dismiss top→down on leave.
          if (fromCase && !toCase) event.direction = 'back';
          if (!fromCase && toCase) event.direction = 'forward';

          setNavigating(true);
          if (navTimer) window.clearTimeout(navTimer);
          // Safety unlock if a navigation aborts mid-flight.
          navTimer = window.setTimeout(function () {
            setNavigating(false);
          }, reduceMotion ? 80 : 1200);
        });

        document.addEventListener('astro:before-swap', function () {
          pendingSwap = true;
          clearTransientUi();
          // Drop page-scoped listeners before the DOM is replaced so they
          // don't keep firing against detached nodes after soft-nav.
          [
            '__lumenHomeAbort',
            '__lumenExpAbort',
            '__lumenHobbiesAbort',
            '__lumenCtaAbort',
            '__lumenHeroAbort',
            '__caseLineNavAbort',
          ].forEach(function (key) {
            try {
              if (window[key]) window[key].abort();
              window[key] = undefined;
            } catch (e) { /* ignore */ }
          });
        });

        document.addEventListener('astro:after-swap', function () {
          // Soft-nav only — don't kill first-visit scroll reveals.
          if (pendingSwap) revealAfterSoftNav();
          // New case pages should open at the top (hash handled on page-load).
          if (document.querySelector('.case-study') && !window.location.hash) {
            window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
          }
        });

        document.addEventListener('astro:page-load', function () {
          if (pendingSwap) {
            revealAfterSoftNav();
            pendingSwap = false;
          }
          scrollToHashReliable();
          setNavigating(false);
          if (navTimer) {
            window.clearTimeout(navTimer);
            navTimer = 0;
          }
        });

        // Same-document hash clicks (already on home) — ClientRouter may no-op.
        document.addEventListener(
          'click',
          function (event) {
            var a = event.target && event.target.closest ? event.target.closest('a[href]') : null;
            if (!a) return;
            var href = a.getAttribute('href') || '';
            if (!href || href.charAt(0) !== '#') return;
            if (a.hasAttribute('download') || a.getAttribute('target') === '_blank') return;
            // Let the browser update the hash, then correct for fixed nav.
            window.setTimeout(scrollToHashOnce, 0);
          },
          true
        );
      })();
    </script>
  </body>
</html>
